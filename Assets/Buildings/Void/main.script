self.spawn = [=](var& self) -> void {
	self.setVar("nextSpawn", 5.0);

	self.setVar("None", [=](var& self, double dt) -> void {});

	self.setVar("Basic", [=](var& self, double dt) -> void {
		self.setVar("nextSpawn", self.getVar("nextSpawn") - dt);
		if (self.getVar("nextSpawn") <= 0) {
			self.setVar("nextSpawn", 5.0);
			self.spawnCreature("Life_T1");
		}
	});

	self.setVar("Eternal", [=](var& self, double dt) -> void {
		self.setVar("nextSpawn", self.getVar("nextSpawn") - dt);
		if (self.getVar("nextSpawn") <= 0) {
			self.setVar("nextSpawn", 5.0);
			self.spawnCreature("Life_T1");
		}
	});

	self.setVar("Overwhelming", [=](var& self, double dt) -> void {
		self.setVar("nextSpawn", self.getVar("nextSpawn") - dt);
		if (self.getVar("nextSpawn") <= 0) {
			self.setVar("nextSpawn", 5.0);
			self.spawnCreature("Life_T1");
		}
	});
};

self.update = [=](var& self, double dt) -> void {
	var fn = self.getVar(self.current().id);
	fn(self, dt);
};
