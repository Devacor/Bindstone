self.spawn = [=](var& self) -> void {
	self.setVar("nextSpawn", 5.0);
	self.setVar("spawnedCount", 0);
	// SpawnBudget (engine global, -1 in the game) caps spawns per building for bounded balance runs
	self.setVar("spawnUnit", [=](var& self, var unitId) -> void {
		if (SpawnBudget < 0 || self.getVar("spawnedCount") < SpawnBudget) {
			self.setVar("spawnedCount", self.getVar("spawnedCount") + 1);
			self.spawnCreature(unitId);
		}
	});
	self.setVar("T0", [=](var& self, double dt) -> void {});

	self.setVar("T1", [=](var& self, double dt) -> void {
		self.setVar("nextSpawn", self.getVar("nextSpawn") - dt);
		if (self.getVar("nextSpawn") <= 0) {
			self.setVar("nextSpawn", 5.0);
			var spawnUnit = self.getVar("spawnUnit");
			spawnUnit(self, "Void_T1");
		}
	});

	self.setVar("T2_0", [=](var& self, double dt) -> void {
		self.setVar("nextSpawn", self.getVar("nextSpawn") - dt);
		if (self.getVar("nextSpawn") <= 0) {
			self.setVar("nextSpawn", 5.0);
			var spawnUnit = self.getVar("spawnUnit");
			spawnUnit(self, "Void_T1");
		}
	});

	self.setVar("T2_1", [=](var& self, double dt) -> void {
		self.setVar("nextSpawn", self.getVar("nextSpawn") - dt);
		if (self.getVar("nextSpawn") <= 0) {
			self.setVar("nextSpawn", 5.0);
			var spawnUnit = self.getVar("spawnUnit");
			spawnUnit(self, "Void_T1");
		}
	});
};

self.update = [=](var& self, double dt) -> void {
	var fn = self.getVar(self.current().id);
	fn(self, dt);
};
