// Whisper (Air T1): low health support/cc; wind slices, gust throws enemies back, sail speeds allies
// Generated by Tools/Creatures/generate_creatures.py.
import "Creatures/Shared/creatureKind.script";

class Whisper : CreatureKind {
	double gustCooldown = 3.0;
	double sailCooldown = 0.0;
	int shots = 0;

	bool tick(double dt) override {
		gustCooldown = gustCooldown - dt * abilitySpeedMultiplier();
		if (gustCooldown <= 0.0) {
			gustCooldown = 6.0;
			var enemies = enemiesInRange(6);
			if (!enemies.empty()) {
				for (int i = 0; i < enemies.size(); ++i) {
					knockback(enemies[i].networkId(), 2, 0.2, 0.0);
					enemies[i].slow(0.3, 2.0);
					enemies[i].damage(2, networkId());
				}
			} else {
				gustCooldown = 0.5;
			}
		}
		sailCooldown = sailCooldown - dt * abilitySpeedMultiplier();
		if (sailCooldown <= 0.0) {
			sailCooldown = 1.0;
			var allies = alliesInRange(5);
			for (int i = 0; i < allies.size(); ++i) {
				allies[i].haste(0.15, 1.2);
				allies[i].attackHaste(0.10, 1.2);
			}
		}
			return false;
	}

	void attackTarget(var& targeting, int target) override {
		// every third slice carries an extra gust
		shots = shots + 1;
		int shotDamage = (shots % 3 == 0) ? 6 : 3;
		fireMissile(target, shotDamage);
	}

}

// The host hands each creature over as its C++ self; the script decides what it becomes.
self.spawn = [=](var& creature) -> void { extend(creature, Whisper).spawn(); };
self.update = [=](var& creature, double dt) -> void { creature.update(dt); };
self.death = [=](var& creature) -> void { creature.death(); };
