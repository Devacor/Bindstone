// Siphion (Decay T1): medium health offense; bites on a 0.75 s clock, every bite a fresh poison stack (1 hp per third of a second for 5 s) that stacks and outlives the Siphion, plus a slow
// Generated by Tools/Creatures/generate_creatures.py.
import "Creatures/Shared/creatureKind.script";

class Siphion : CreatureKind {
	double biteCooldown = 0.0;

	void spawn() override {
		biteCooldown = stats().attackInterval;
		// thorns: whoever lands a hit on a Siphion takes a couple of points and swings a quarter slower for a while
		this.onDamaged.connect("thorns", [=](var& victim, int amount, int source) -> void {
			if (source != 0 && source != victim.networkId()) {
				victim.poison(source, 0.45);
				var attacker = victim.game().creature(source);
				if (attacker != null) {
					attacker.attackSlow(0.25, 3.0);
				}
			}
		});
	}

	bool tick(double dt) override {
		biteCooldown = biteCooldown - dt * abilitySpeedMultiplier();
		if (biteCooldown <= 0.0) {
			biteCooldown = stats().attackInterval;
			int prey = nearestEnemyId(2.0);
			if (prey != 0) {
				game().creature(prey).slow(0.5, 3.0);
				game().creature(prey).attackSlow(0.5, 3.0);
				game().creature(prey).abilitySlow(0.5, 3.0);
				poison(prey, 5.0);
			}
		}
			return false;
	}

}

// The host hands each creature over as its C++ self; the script decides what it becomes.
self.spawn = [=](var& creature) -> void { extend(creature, Siphion).spawn(); };
self.update = [=](var& creature, double dt) -> void { creature.update(dt); };
self.death = [=](var& creature) -> void { creature.death(); };
