// Stonekind (Earth T1): high health tank; slow melee, shout taunts and rock-shields, splits into pebbles
// Generated by Tools/Creatures/generate_creatures.py.
import "Creatures/Shared/creatureKind.script";

class Stonekind : CreatureKind {
	double shoutCooldown = 3.0;

	bool tick(double dt) override {
		if (tankingFor > 0.0) {
			tankingFor = tankingFor - dt;
		}
		shoutCooldown = shoutCooldown - dt * abilitySpeedMultiplier();
		if (shoutCooldown <= 0.0) {
			shoutCooldown = 8.0;
			var enemies = enemiesInRange(8);
			if (!enemies.empty()) {
				for (int i = 0; i < enemies.size(); ++i) {
					enemies[i].taunt(networkId(), 4.0);
				}
				shield(20);
				tankingFor = 4.0;
			} else {
				shoutCooldown = 1.0;
			}
		}
			return false;
	}

	void attackTarget(var& targeting, int target) override {
		if (game().creature(target) == null || !game().creature(target).alive()) {
			return;
		}
		// the slam grows with the crowd the shout pulled in: five per enemy pressing it
		var crowd = enemiesInRange(2.5);
		int slam = 5 * max(1, crowd.size());
		strike(target, slam);
	}

	void death() override {
		spawnCreature("Earth_Pebble");
		spawnCreature("Earth_Pebble");
	}

}

// The host hands each creature over as its C++ self; the script decides what it becomes.
self.spawn = [=](var& creature) -> void { extend(creature, Stonekind).spawn(); };
self.update = [=](var& creature, double dt) -> void { creature.update(dt); };
self.death = [=](var& creature) -> void { creature.death(); };
