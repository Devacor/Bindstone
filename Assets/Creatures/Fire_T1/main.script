// Flicker (Fire T1): low health offense; ember shots, flame jet ignites, explodes on death
// Generated by Tools/Creatures/generate_creatures.py.
import "Creatures/Shared/creatureKind.script";

class Flicker : CreatureKind {
	double jetCooldown = 2.0;

	bool tick(double dt) override {
		jetCooldown = jetCooldown - dt * abilitySpeedMultiplier();
		if (jetCooldown <= 0.0) {
			jetCooldown = 6.0;
			var enemies = enemiesInRange(4);
			if (!enemies.empty()) {
				for (int i = 0; i < enemies.size(); ++i) {
					enemies[i].dot(5.0, 3.0, networkId());
				}
			} else {
				jetCooldown = 0.5;
			}
		}
			return false;
	}

	void attackTarget(var& targeting, int target) override {
		fireMissile(target, 4);
	}

	void death() override {
		var enemies = enemiesInRange(8);
		for (int i = 0; i < enemies.size(); ++i) {
			enemies[i].dot(5.0, 3.0, networkId());
		}
	}

}

// The host hands each creature over as its C++ self; the script decides what it becomes.
self.spawn = [=](var& creature) -> void { extend(creature, Flicker).spawn(); };
self.update = [=](var& creature, double dt) -> void { creature.update(dt); };
self.death = [=](var& creature) -> void { creature.death(); };
