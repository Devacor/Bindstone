// Sprout (Life T1): medium health defensive support; seed spit, vine shield, heals on death
// Generated by Tools/Creatures/generate_creatures.py.
import "Creatures/Shared/creatureKind.script";

class Sprout : CreatureKind {
	double shieldCooldown = 10.0;

	void spawn() override {
		shield(6);
	}

	bool tick(double dt) override {
		shieldCooldown = shieldCooldown - dt * abilitySpeedMultiplier();
		if (shieldCooldown <= 0.0) {
			shieldCooldown = 10.0;
			shield(10);
			int mate = pickWardHost(8.0);
			if (mate != 0) {
				game().creature(mate).shield(7);
			}
		}
			return false;
	}

	void attackTarget(var& targeting, int target) override {
		fireMissile(target, 3);
	}

	void death() override {
		var allies = alliesInRange(8);
		for (int i = 0; i < allies.size(); ++i) {
			allies[i].hot(4.0, 5.0);
		}
	}

}

// The host hands each creature over as its C++ self; the script decides what it becomes.
self.spawn = [=](var& creature) -> void { extend(creature, Sprout).spawn(); };
self.update = [=](var& creature, double dt) -> void { creature.update(dt); };
self.death = [=](var& creature) -> void { creature.death(); };
