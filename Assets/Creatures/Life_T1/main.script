// Sprout (Life T1): medium health defensive support; seed spit, vine shield, heals on death
self.spawn = [=](var& self) -> void {
	self.setVar("attacking", false);
	self.setVar("activeTarget", 0);
	self.setVar("shieldCooldown", 4.0);
	self.shield(6);

	self.setVar("attackTarget", [=](var& targeting, var target) -> void {
		var newMissile = BattleEffectNetworkState(targeting.self().game(), "Missile", targeting.self().networkId());
		newMissile.duration = 1.25;
		newMissile.targetType = TargetType_CREATURE;
		newMissile.targetCreatureId = target;
		var source = targeting.self().networkId();
		auto effect = spawnOnNetwork(newMissile);
		effect.onArrive.connect("Arrive", [=](var& battleEffect) -> void {
			if (battleEffect.targetCreature() != null && battleEffect.targetCreature().alive()) {
				battleEffect.targetCreature().damage(3, source);
			}
		});
	});

	self.setVar("tryToFindAndAttackTarget", [=](var& self, double dt) -> bool {
		var targets = self.enemiesInRange(20);
		var taunt = self.tauntedBy();
		if (targets.empty() && taunt == 0) {
			return false;
		}
		var target = (taunt != 0) ? taunt : targets[0].networkId();
		var activeTarget = self.getVar("activeTarget");
		if (activeTarget != target) {
			self.setVar("activeTarget", target);
			self.targeting().target(target, 8, [target](var& targeting) -> void {
				targeting.self().setVar("activeTarget", 0);
				targeting.self().setVar("attacking", true);
				auto spine = targeting.self().spine();
				spine.timeScale(targeting.self().attackSpeedMultiplier());
				spine.animate("attack", false);
				spine.onEvent.connect("launch", [target, targeting](var& spine, int index, var& eventData) -> void {
					if (eventData.name == "launch") {
						var attackTarget = targeting.self().getVar("attackTarget");
						attackTarget(targeting, target);
					}
				});
				spine.onEnd.connect("unlock", [targeting](var& spine, int index) -> void {
					if (spine.track(index).name() == "attack") {
						targeting.self().setVar("attacking", false);
						spine.timeScale(1.0);
					}
				});
			}, [=](var& targeting) -> void {
				targeting.self().setVar("activeTarget", 0);
			});
		}
		return true;
	});

	self.setVar("applyDefaultTarget", [=](var& self) -> void {
		self.targeting().target(self.team().enemyWell(), PathMode.flowField, [=](var& targeting) -> void {
			targeting.self().fall();
		});
	});
};

self.update = [=](var& self, double dt) -> void {
	self.setVar("shieldCooldown", self.getVar("shieldCooldown") - dt);
	if (self.getVar("shieldCooldown") <= 0.0) {
		self.setVar("shieldCooldown", 4.0);
		if (self.enemiesInRange(10).empty()) {
			self.shield(6);
			var allies = self.alliesInRange(6);
			for (int i = 0; i < allies.size(); ++i) {
				if (allies[i].networkId() != self.networkId() && allies[i].shieldAmount() == 0) {
					allies[i].shield(4);
					break;
				}
			}
		}
	}
	if (!self.getVar("attacking")) {
		var tryToFindAndAttackTarget = self.getVar("tryToFindAndAttackTarget");
		if (!tryToFindAndAttackTarget(self, dt)) {
			var applyDefaultTarget = self.getVar("applyDefaultTarget");
			applyDefaultTarget(self);
		}
	}
};

self.death = [=](var& self) -> void {
	var allies = self.alliesInRange(5);
	for (int i = 0; i < allies.size(); ++i) {
		allies[i].hot(2.0, 5.0);
	}
};
