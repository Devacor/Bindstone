// Sparker (Lightning T1): low health offensive cc; a 1.5 s channel from ten cells that stuns its target, discharges 14 (chaining 2/1 to two neighbours) and needs 0.5 s to recover; zaps everyone on death
// Generated by Tools/Creatures/generate_creatures.py.
import "Creatures/Shared/creatureKind.script";

class Sparker : CreatureKind {
	int channelTarget = 0;
	double channelRemaining = 0.0;
	double recovery = 0.0;

	bool tick(double dt) override {
		if (channelTarget != 0) {
			double left = channelRemaining - dt;
			var victim = game().creature(channelTarget);
			if (victim == null || !victim.alive()) {
				channelTarget = 0;
				recovery = 0.5;
			} else if (left <= 0.0) {
				var others = enemiesInRange(4);
				int jumps = 0;
				for (int i = 0; i < others.size() && jumps < 2; ++i) {
					if (others[i].networkId() != channelTarget) {
						jumps = jumps + 1;
						strike(others[i].networkId(), jumps == 1 ? 2 : 1);
					}
				}
				strike(channelTarget, 14);
				channelTarget = 0;
				recovery = 0.5;
			} else {
				channelRemaining = left;
			}
			return true;
		}
		if (recovery > 0.0) {
			recovery = recovery - dt;
			return true;
		}
		int prey = nearestEnemyId(10.0);
		if (prey != 0 && !targeting().stunned()) {
			game().creature(prey).stun(1.5);
			channelTarget = prey;
			channelRemaining = 1.5;
			activeTarget = 0;
			agent().stop();
			targeting().clear();
			var spine = spine();
			spine.timeScale(0.55);
			spine.animate("attack", false);
			return true;
		}
			return false;
	}

	void death() override {
		var enemies = enemiesInRange(4);
		for (int i = 0; i < enemies.size(); ++i) {
			enemies[i].stun(2.0);
			enemies[i].damage(3, networkId());
		}
	}

}

// The host hands each creature over as its C++ self; the script decides what it becomes.
self.spawn = [=](var& creature) -> void { extend(creature, Sparker).spawn(); };
self.update = [=](var& creature, double dt) -> void { creature.update(dt); };
self.death = [=](var& creature) -> void { creature.death(); };
