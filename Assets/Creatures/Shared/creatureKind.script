// The base every creature's script layer derives (Source/JaiScript/docs/script_extensible.md).
// A creature's spawn hook extends the ServerCreature it is handed with its element's class; the
// update/death hooks call the layer. Any creature that crosses back into script - targeting.self(),
// game().creature(id), alliesInRange() - IS its layer, so its fields are readable from any script.
// Generated by Tools/Creatures/generate_creatures.py.
// The running instance registers spawnOnNetwork (gameInstance.cpp); declared here so a
// strict check of this unit outside an instance (-verifyassets) knows the name.
extern function spawnOnNetwork;
nocopy class CreatureKind : ServerCreature {
	// engage
	bool attacking = false;
	int activeTarget = 0;
	bool marching = false;
	// flight (knockbacks and throws): off the grid, stunned, eased toward the landing cell
	double flightRemaining = 0.0;
	double flightDuration = 0.0;
	double flightLandingStun = 0.0;
	var flightFrom = null;
	var flightTo = null;
	var flightLanding = null;
	// poison: every application is its own stack of 1-hp ticks on a shared third-of-a-second clock
	var poisonStacks = [];
	double poisonTimer = 0.0;
	bool poisonEver = false;
	int poisonSource = 0;
	// a Tear riding this creature adds a water-typed half hit to its strikes
	int infusedBy = 0;
	// a taunt in progress makes this creature the ward host of choice
	double tankingFor = 0.0;
	// droplets: the Tearel they came from
	int parentTearel = 0;

	// ---- the per-creature surface
	void spawn() {}
	// per-creature logic ahead of the engage loop; true = handled this tick, skip engaging
	bool tick(double dt) { return false; }
	// the hit, at the attack animation's launch event
	void attackTarget(var& targeting, int target) {}
	void death() {}
	double aggroRange() { return 20.0; }
	int pickPrey() { return nearestEnemyId(aggroRange()); }
	bool seeksTargets() { return true; }

	void update(double dt) {
		statusTick(dt);
		if (tick(dt)) {
			return;
		}
		if (!attacking) {
			if (!tryToFindAndAttackTarget()) {
				if (!marching) {
					applyDefaultTarget();
				}
			}
		}
	}

	// ---- engage: nearest enemy (or whoever taunted us) -> walk into range -> attack animation -> "launch" -> attackTarget
	bool tryToFindAndAttackTarget() {
		if (!seeksTargets()) {
			return false;
		}
		int taunt = tauntedBy();
		int target = (taunt != 0) ? taunt : pickPrey();
		if (target == 0) {
			return false;
		}
		if (activeTarget != target) {
			activeTarget = target;
			marching = false;
			targeting().target(target, attackRange(), [target](var& targeting) -> void {
				targeting.self().activeTarget = 0;
				targeting.self().attacking = true;
				auto spine = targeting.self().spine();
				spine.timeScale(targeting.self().attackSpeedMultiplier());
				spine.animate("attack", false);
				spine.onEvent.connect("launch", [target, targeting](var& animSpine, int index, var& eventData) -> void {
					if (eventData.name == "launch") {
						targeting.self().attackTarget(targeting, target);
					}
				});
				spine.onEnd.connect("unlock", [targeting](var& animSpine, int index) -> void {
					if (animSpine.track(index).name() == "attack") {
						targeting.self().attacking = false;
						animSpine.timeScale(1.0);
					}
				});
			}, [=](var& targeting) -> void {
				// the chase ended (target died or fled): march again on the next update
				targeting.self().activeTarget = 0;
				targeting.self().marching = false;
			});
		}
		return true;
	}

	// the well sits inside its building's blocked cells: arriving means standing at its edge.
	// Applied when the creature has nothing to fight (and again the moment a chase ends), never per tick.
	void applyDefaultTarget() {
		marching = true;
		targeting().target(team().enemyWell(), 6.0, PathMode.flowField, [=](var& targeting) -> void {
			targeting.self().enemyTeam().damage(1);   // a leak: the well takes a point
			targeting.self().fall();
		});
	}

	// ---- attacks
	void meleeStrike(int target, int damage) {
		if (game().creature(target) != null && game().creature(target).alive()) {
			strike(target, damage);
		}
	}

	void fireMissile(int target, int damage) {
		var newMissile = BattleEffectNetworkState(game(), "Missile", networkId());
		newMissile.duration = 1.25;
		newMissile.targetType = TargetType_CREATURE;
		newMissile.targetCreatureId = target;
		int source = networkId();
		auto effect = spawnOnNetwork(newMissile);
		effect.onArrive.connect("Arrive", [=](var& battleEffect) -> void {
			if (battleEffect.targetCreature() != null && battleEffect.targetCreature().alive()) {
				var victim = battleEffect.targetCreature();
				var shooter = victim.game().creature(source);
				if (shooter != null) { shooter.strike(victim.networkId(), damage); } else { victim.damage(damage, source); }
			}
		});
	}

	// A basic attack. The attacker's own hit lands first; a Tear riding the attacker (infusedBy) adds a
	// second, water-typed hit of half the amount sourced from the Tear, so water's multipliers apply to it.
	void strike(int victimId, int amount) {
		var victim = game().creature(victimId);
		if (victim == null || !victim.alive() || amount <= 0) {
			return;
		}
		victim.damage(amount, networkId());
		if (infusedBy == 0) {
			return;
		}
		var tear = game().creature(infusedBy);
		if (tear == null || !tear.alive()) {
			infusedBy = 0;
			return;
		}
		if (game().creature(victimId) != null) {
			game().creature(victimId).damage((amount + 1) / 2, infusedBy);
		}
	}

	// ---- status
	void statusTick(double dt) {
		poisonTick(dt);
		if (!alive()) {
			return;
		}
		flightTick(dt);
	}

	// Flight: the victim leaves the grid (no footprint), is stunned for the flight, eases toward the
	// landing cell, then takes its footprint back (the agent's own placement nudges it if the cell filled).
	// landingStun: a further stun applied the moment the victim lands (0 for none).
	void knockback(int victimId, int cells, double seconds, double landingStun) {
		var victim = game().creature(victimId);
		if (victim == null || !victim.alive() || cells <= 0) {
			return;
		}
		var from = agent().gridPosition();
		var here = victim.agent().gridPosition();
		flingAlong(victim, here.x - from.x, here.y - from.y, cells, seconds, landingStun);
	}

	// Isolation: the victim flies away from its own allies (the centroid of those within 8), so it lands alone;
	// with no allies near, away from the thrower.
	void isolateThrow(int victimId, int cells, double seconds, double landingStun) {
		var victim = game().creature(victimId);
		if (victim == null || !victim.alive() || cells <= 0) {
			return;
		}
		var here = victim.agent().gridPosition();
		var allies = victim.alliesInRange(8.0);
		double cx = 0.0;
		double cy = 0.0;
		int count = 0;
		for (int i = 0; i < allies.size(); ++i) {
			if (allies[i].networkId() != victimId) {
				var p = allies[i].agent().gridPosition();
				cx = cx + p.x;
				cy = cy + p.y;
				count = count + 1;
			}
		}
		if (count == 0) {
			var from = agent().gridPosition();
			flingAlong(victim, here.x - from.x, here.y - from.y, cells, seconds, landingStun);
			return;
		}
		flingAlong(victim, here.x - cx / count, here.y - cy / count, cells, seconds, landingStun);
	}

	void flingAlong(var& victim, double dx, double dy, int cells, double seconds, double landingStun) {
		var grid = game().pathMap();
		var here = victim.agent().gridPosition();
		double length = sqrt(dx * dx + dy * dy);
		if (length < 0.0001) {
			dx = 1.0;
			dy = 0.0;
			length = 1.0;
		}
		dx = dx / length;
		dy = dy / length;
		for (int step = cells; step > 0; --step) {
			math::ivec3 landing = math::ivec3(round(here.x + dx * step), round(here.y + dy * step));
			if (grid.inBounds(landing) && !grid.blocked(landing)) {
				victim.stun(seconds);
				victim.agent().stop();
				victim.agent().disableFootprint();
				victim.flightFrom = victim.agent().localPosition();
				victim.flightTo = grid.localFromGrid(landing);
				victim.flightLanding = landing;
				victim.flightDuration = seconds;
				victim.flightRemaining = seconds;
				victim.flightLandingStun = landingStun;
				return;
			}
		}
	}

	bool inFlight() {
		return flightRemaining > 0.0;
	}

	// Ease-out: fast leave, soft landing.
	void flightTick(double dt) {
		if (!inFlight()) {
			return;
		}
		double remaining = flightRemaining - dt;
		if (remaining <= 0.0) {
			flightRemaining = 0.0;
			agent().gridPosition(flightLanding);
			agent().enableFootprint();
			if (flightLandingStun > 0.0) {
				stun(flightLandingStun);
			}
			return;
		}
		flightRemaining = remaining;
		double t = 1.0 - remaining / flightDuration;
		double eased = 1.0 - (1.0 - t) * (1.0 - t);
		agent().localPosition(math::vec3(flightFrom.x + (flightTo.x - flightFrom.x) * eased, flightFrom.y + (flightTo.y - flightFrom.y) * eased));
	}

	// Poison the victim: a fresh stack that outlives whoever applied it. Three stacks = 3 hp per tick.
	void poison(int victimId, double seconds) {
		var victim = game().creature(victimId);
		if (victim == null || !victim.alive()) {
			return;
		}
		victim.applyPoison(networkId(), seconds);
	}

	void applyPoison(int sourceId, double seconds) {
		if (!poisonEver) {
			poisonEver = true;
			poisonTimer = 0.0;
		}
		poisonStacks.push(seconds);
		poisonSource = sourceId;
		tickDamage(1, sourceId);
	}

	int poisonStackCount() {
		return poisonStacks.size();
	}

	void poisonTick(double dt) {
		if (poisonStacks.size() == 0) {
			return;
		}
		double interval = 1.0 / 3.0;
		double timer = poisonTimer + dt;
		int ticks = 0;
		while (timer >= interval) {
			timer = timer - interval;
			ticks = ticks + 1;
		}
		var live = [];
		for (int i = 0; i < poisonStacks.size(); ++i) {
			double left = poisonStacks[i] - dt;
			if (left > 0.0) {
				live.push(left);
			}
		}
		poisonStacks = live;
		poisonTimer = timer;
		if (ticks > 0 && live.size() > 0) {
			tickDamage(ticks * live.size(), poisonSource);
		}
	}

	// ---- picking
	// The enemy with the longest reach in sight (the backline); ties go to the nearer one. 0 when nothing is in range.
	int pickBackline(double range) {
		var enemies = enemiesInRange(range);
		var me = agent().gridPosition();
		int best = 0;
		double bestRange = -1.0;
		double bestDistance = 1.0e9;
		for (int i = 0; i < enemies.size(); ++i) {
			var p = enemies[i].agent().gridPosition();
			double distance = (p.x - me.x) * (p.x - me.x) + (p.y - me.y) * (p.y - me.y);
			double reach = enemies[i].attackRange();
			if (reach > bestRange || (reach == bestRange && distance < bestDistance)) {
				best = enemies[i].networkId();
				bestRange = reach;
				bestDistance = distance;
			}
		}
		return best;
	}

	// The ally worth warding or shielding: a tank holding a taunt beats everyone, then the nearest real
	// fighter; never a Drip or another support body.
	int pickWardHost(double range) {
		var allies = alliesInRange(range);
		var me = agent().gridPosition();
		int best = 0;
		double bestDistance = 1.0e9;
		bool bestTanking = false;
		for (int i = 0; i < allies.size(); ++i) {
			if (allies[i].networkId() == networkId() || allies[i].attackRange() <= 0.0 || allies[i].stats().id == "Water_Drip") {
				continue;
			}
			bool isTanking = allies[i].tankingFor > 0.0;
			if (bestTanking && !isTanking) {
				continue;
			}
			var p = allies[i].agent().gridPosition();
			double distance = (p.x - me.x) * (p.x - me.x) + (p.y - me.y) * (p.y - me.y);
			if ((isTanking && !bestTanking) || distance < bestDistance) {
				best = allies[i].networkId();
				bestDistance = distance;
				bestTanking = isTanking;
			}
		}
		return best;
	}

	// ---- teleports
	// The closest free cell to a target, nearest ring first.
	bool teleportNear(int targetId, int maxRadius) {
		var target = game().creature(targetId);
		if (target == null) {
			return false;
		}
		var center = target.agent().gridPosition();
		return teleportToCell(math::ivec3(round(center.x), round(center.y)), maxRadius);
	}

	// The closest free cell to a grid cell (the cell itself first), nearest ring after.
	bool teleportToCell(var cell, int maxRadius) {
		var grid = game().pathMap();
		int cx = cell.x;
		int cy = cell.y;
		if (grid.inBounds(cell) && !grid.blocked(cell)) {
			agent().gridPosition(cell);
			return true;
		}
		for (int radius = 1; radius <= maxRadius; ++radius) {
			for (int dx = -radius; dx <= radius; ++dx) {
				for (int dy = -radius; dy <= radius; ++dy) {
					if (max(abs(dx), abs(dy)) != radius) {
						continue;
					}
					math::ivec3 candidate = math::ivec3(cx + dx, cy + dy);
					if (grid.inBounds(candidate) && !grid.blocked(candidate)) {
						agent().gridPosition(candidate);
						return true;
					}
				}
			}
		}
		return false;
	}
}
