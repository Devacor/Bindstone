// Shared creature status module (server). Included by every creature script; every creature's update
// calls statusTick(self, dt) first. State lives in creature vars so any script can read it, and every
// ailment outlives whoever applied it.

// Flight: the victim leaves the grid (no footprint), is stunned for the flight, eases toward the
// landing cell, then takes its footprint back (the agent's own placement nudges it if the cell filled).
// landingStun: a further stun applied the moment the victim lands (0 for none).
void knockback(var& self, var victimId, int cells, double seconds, double landingStun) {
	var victim = self.game().creature(victimId);
	if (victim == null || !victim.alive() || cells <= 0) {
		return;
	}
	var from = self.agent().gridPosition();
	var here = victim.agent().gridPosition();
	flingAlong(self, victim, here.x - from.x, here.y - from.y, cells, seconds, landingStun);
}

// Isolation: the victim flies away from its own allies (the centroid of those within 8), so it lands alone;
// with no allies near, away from the thrower.
void isolateThrow(var& self, var victimId, int cells, double seconds, double landingStun) {
	var victim = self.game().creature(victimId);
	if (victim == null || !victim.alive() || cells <= 0) {
		return;
	}
	var here = victim.agent().gridPosition();
	var allies = victim.alliesInRange(8.0);
	double cx = 0.0;
	double cy = 0.0;
	int count = 0;
	for (int i = 0; i < allies.size(); ++i) {
		if (allies[i].networkId() != victimId) {
			var p = allies[i].agent().gridPosition();
			cx = cx + p.x;
			cy = cy + p.y;
			count = count + 1;
		}
	}
	if (count == 0) {
		var from = self.agent().gridPosition();
		flingAlong(self, victim, here.x - from.x, here.y - from.y, cells, seconds, landingStun);
		return;
	}
	flingAlong(self, victim, here.x - cx / count, here.y - cy / count, cells, seconds, landingStun);
}

void flingAlong(var& self, var& victim, double dx, double dy, int cells, double seconds, double landingStun) {
	var grid = self.game().pathMap();
	var here = victim.agent().gridPosition();
	double length = sqrt(dx * dx + dy * dy);
	if (length < 0.0001) {
		dx = 1.0;
		dy = 0.0;
		length = 1.0;
	}
	dx = dx / length;
	dy = dy / length;
	for (int step = cells; step > 0; --step) {
		Pointi landing = Pointi(round(here.x + dx * step), round(here.y + dy * step));
		if (grid.inBounds(landing) && !grid.blocked(landing)) {
			victim.stun(seconds);
			victim.agent().stop();
			victim.agent().disableFootprint();
			victim.setVar("flightFrom", victim.agent().localPosition());
			victim.setVar("flightTo", grid.localFromGrid(landing));
			victim.setVar("flightLanding", landing);
			victim.setVar("flightDuration", seconds);
			victim.setVar("flightRemaining", seconds);
			victim.setVar("flightLandingStun", landingStun);
			return;
		}
	}
}

bool inFlight(var& creature) {
	var remaining = creature.getVar("flightRemaining");
	return remaining != null && remaining > 0.0;
}

// Ease-out: fast leave, soft landing.
void flightTick(var& self, double dt) {
	if (!inFlight(self)) {
		return;
	}
	double remaining = self.getVar("flightRemaining") - dt;
	double duration = self.getVar("flightDuration");
	var from = self.getVar("flightFrom");
	var to = self.getVar("flightTo");
	if (remaining <= 0.0) {
		self.setVar("flightRemaining", 0.0);
		self.agent().gridPosition(self.getVar("flightLanding"));
		self.agent().enableFootprint();
		double landingStun = self.getVar("flightLandingStun");
		if (landingStun > 0.0) {
			self.stun(landingStun);
		}
		return;
	}
	self.setVar("flightRemaining", remaining);
	double t = 1.0 - remaining / duration;
	double eased = 1.0 - (1.0 - t) * (1.0 - t);
	self.agent().localPosition(Point(from.x + (to.x - from.x) * eased, from.y + (to.y - from.y) * eased));
}

// Poison: every application is its own stack of 1-hp ticks on a shared third-of-a-second clock, the
// first tick landing at once; a stack lives `seconds`. Three stacks = 3 hp per tick.
void poison(var& self, var victimId, double seconds) {
	var victim = self.game().creature(victimId);
	if (victim == null || !victim.alive()) {
		return;
	}
	var stacks = victim.getVar("poisonStacks");
	if (stacks == null) {
		stacks = [];
		victim.setVar("poisonTimer", 0.0);
	}
	stacks.push(seconds);
	victim.setVar("poisonStacks", stacks);
	victim.setVar("poisonSource", self.networkId());
	victim.tickDamage(1, self.networkId());
}

int poisonStacks(var& creature) {
	var stacks = creature.getVar("poisonStacks");
	return stacks == null ? 0 : stacks.size();
}

void poisonTick(var& self, double dt) {
	var stacks = self.getVar("poisonStacks");
	if (stacks == null || stacks.size() == 0) {
		return;
	}
	double interval = 1.0 / 3.0;
	double timer = self.getVar("poisonTimer") + dt;
	int ticks = 0;
	while (timer >= interval) {
		timer = timer - interval;
		ticks = ticks + 1;
	}
	var live = [];
	for (int i = 0; i < stacks.size(); ++i) {
		double left = stacks[i] - dt;
		if (left > 0.0) {
			live.push(left);
		}
	}
	self.setVar("poisonStacks", live);
	self.setVar("poisonTimer", timer);
	if (ticks > 0 && live.size() > 0) {
		self.tickDamage(ticks * live.size(), self.getVar("poisonSource"));
	}
}

void statusTick(var& self, double dt) {
	poisonTick(self, dt);
	if (!self.alive()) {
		return;
	}
	flightTick(self, dt);
}

// A basic attack. The attacker's own hit lands first; a Tear riding the attacker (infusedBy) adds a
// second, water-typed hit of half the amount sourced from the Tear, so water's multipliers apply to it.
void strike(var& attacker, var victimId, int amount) {
	var victim = attacker.game().creature(victimId);
	if (victim == null || !victim.alive() || amount <= 0) {
		return;
	}
	victim.damage(amount, attacker.networkId());
	var infusion = attacker.getVar("infusedBy");
	if (infusion == null || infusion == 0) {
		return;
	}
	var tear = attacker.game().creature(infusion);
	if (tear == null || !tear.alive()) {
		attacker.setVar("infusedBy", 0);
		return;
	}
	if (attacker.game().creature(victimId) != null) {
		attacker.game().creature(victimId).damage((amount + 1) / 2, infusion);
	}
}

// The enemy with the longest reach in sight (the backline); ties go to the nearer one. 0 when nothing is in range.
int pickBackline(var& self, double range) {
	var enemies = self.enemiesInRange(range);
	var me = self.agent().gridPosition();
	int best = 0;
	double bestRange = -1.0;
	double bestDistance = 1.0e9;
	for (int i = 0; i < enemies.size(); ++i) {
		var p = enemies[i].agent().gridPosition();
		double distance = (p.x - me.x) * (p.x - me.x) + (p.y - me.y) * (p.y - me.y);
		double reach = enemies[i].attackRange();
		if (reach > bestRange || (reach == bestRange && distance < bestDistance)) {
			best = enemies[i].networkId();
			bestRange = reach;
			bestDistance = distance;
		}
	}
	return best;
}

// The ally worth warding or shielding: a tank holding a taunt beats everyone, then the nearest real
// fighter; never a Drip or another support body.
int pickWardHost(var& self, double range) {
	var allies = self.alliesInRange(range);
	var me = self.agent().gridPosition();
	int best = 0;
	double bestDistance = 1.0e9;
	bool bestTanking = false;
	for (int i = 0; i < allies.size(); ++i) {
		if (allies[i].networkId() == self.networkId() || allies[i].attackRange() <= 0.0 || allies[i].stats().id == "Water_Drip") {
			continue;
		}
		var tanking = allies[i].getVar("tankingFor");
		bool isTanking = tanking != null && tanking > 0.0;
		if (bestTanking && !isTanking) {
			continue;
		}
		var p = allies[i].agent().gridPosition();
		double distance = (p.x - me.x) * (p.x - me.x) + (p.y - me.y) * (p.y - me.y);
		if ((isTanking && !bestTanking) || distance < bestDistance) {
			best = allies[i].networkId();
			bestDistance = distance;
			bestTanking = isTanking;
		}
	}
	return best;
}

// The closest free cell to a target, nearest ring first.
bool teleportNear(var& self, var targetId, int maxRadius) {
	var target = self.game().creature(targetId);
	if (target == null) {
		return false;
	}
	var center = target.agent().gridPosition();
	return teleportToCell(self, Pointi(round(center.x), round(center.y)), maxRadius);
}

// The closest free cell to a grid cell (the cell itself first), nearest ring after.
bool teleportToCell(var& self, var cell, int maxRadius) {
	var grid = self.game().pathMap();
	int cx = cell.x;
	int cy = cell.y;
	if (grid.inBounds(cell) && !grid.blocked(cell)) {
		self.agent().gridPosition(cell);
		return true;
	}
	for (int radius = 1; radius <= maxRadius; ++radius) {
		for (int dx = -radius; dx <= radius; ++dx) {
			for (int dy = -radius; dy <= radius; ++dy) {
				if (max(abs(dx), abs(dy)) != radius) {
					continue;
				}
				Pointi candidate = Pointi(cx + dx, cy + dy);
				if (grid.inBounds(candidate) && !grid.blocked(candidate)) {
					self.agent().gridPosition(candidate);
					return true;
				}
			}
		}
	}
	return false;
}
