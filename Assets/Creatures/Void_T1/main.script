// Voidling (Void T1): low health burst; the first chomp on a target (and every third after) hurls it ten cells back - stunned for the flight - while the Voidling phases out, then reappears beside it where it lands
include "Creatures/Shared/status.script";

self.spawn = [=](var& self) -> void {
	self.setVar("attacking", false);
	self.setVar("activeTarget", 0);
	self.setVar("chompTarget", 0);
	self.setVar("chompCount", 0);
	self.setVar("phasing", 0);
	self.setVar("blinkCooldown", 0.0);

	self.setVar("attackTarget", [=](var& targeting, var target) -> void {
		var me = targeting.self().networkId();
		if (targeting.self().game().creature(target) != null && targeting.self().game().creature(target).alive()) {
			if (targeting.self().getVar("chompTarget") != target) {
				targeting.self().setVar("chompTarget", target);
				targeting.self().setVar("chompCount", 0);
			}
			var chomp = targeting.self().getVar("chompCount");
			targeting.self().setVar("chompCount", chomp + 1);
			var bite = (chomp % 3 == 1) ? 20 : 8;
			// the bite is a frontal sweep: everything in the arc toward the target takes it too
			var mePos = targeting.self().agent().gridPosition();
			var victimPos = targeting.self().game().creature(target).agent().gridPosition();
			double fx = victimPos.x - mePos.x;
			double fy = victimPos.y - mePos.y;
			double fl = sqrt(fx * fx + fy * fy);
			if (fl < 0.001) {
				fx = 1.0;
				fy = 0.0;
				fl = 1.0;
			}
			fx = fx / fl;
			fy = fy / fl;
			var sweeper = targeting.self();
			var others = targeting.self().enemiesInRange(2.5);
			for (int i = 0; i < others.size(); ++i) {
				if (others[i].networkId() != target) {
					var p = others[i].agent().gridPosition();
					double dx = p.x - mePos.x;
					double dy = p.y - mePos.y;
					double dl = sqrt(dx * dx + dy * dy);
					if (dl > 0.001 && (dx * fx + dy * fy) / dl > 0.3) {
						others[i].stun(0.25);
						strike(sweeper, others[i].networkId(), bite);
					}
				}
			}
			if (chomp % 3 != 1) {
				targeting.self().game().creature(target).stun(0.25);
			}
			if (chomp % 3 == 1) {
				var attacker = targeting.self();
				isolateThrow(attacker, target, 10, 0.35, 1.75);
				targeting.self().visible(false);
				targeting.self().untargetable(true);
				targeting.self().agent().stop();
				targeting.clear();
				targeting.self().setVar("phasing", target);
			}
			var striker = targeting.self();
			strike(striker, target, bite);
		}
	});

	self.setVar("tryToFindAndAttackTarget", [=](var& self, double dt) -> bool {
		var taunt = self.tauntedBy();
		var target = (taunt != 0) ? taunt : pickBackline(self, 20);
		if (target == 0) {
			return false;
		}
		var activeTarget = self.getVar("activeTarget");
		if (activeTarget != target) {
			self.setVar("activeTarget", target);
			self.setVar("marching", false);
			self.targeting().target(target, self.stats().attackRange, [target](var& targeting) -> void {
				targeting.self().setVar("activeTarget", 0);
				targeting.self().setVar("attacking", true);
				auto spine = targeting.self().spine();
				spine.timeScale(targeting.self().attackSpeedMultiplier());
				spine.animate("attack", false);
				spine.onEvent.connect("launch", [target, targeting](var& spine, int index, var& eventData) -> void {
					if (eventData.name == "launch") {
						var attackTarget = targeting.self().getVar("attackTarget");
						attackTarget(targeting, target);
					}
				});
				spine.onEnd.connect("unlock", [targeting](var& spine, int index) -> void {
					if (spine.track(index).name() == "attack") {
						targeting.self().setVar("attacking", false);
						spine.timeScale(1.0);
					}
				});
			}, [=](var& targeting) -> void {
				// the chase ended (target died or fled): march again on the next update
				targeting.self().setVar("activeTarget", 0);
				targeting.self().setVar("marching", false);
			});
		}
		return true;
	});

	// the well sits inside its building's blocked cells: arriving means standing at its edge.
	// Applied when the creature has nothing to fight (and again the moment a chase ends), never per tick.
	self.setVar("applyDefaultTarget", [=](var& self) -> void {
		self.setVar("marching", true);
		self.targeting().target(self.team().enemyWell(), 6.0, PathMode.flowField, [=](var& targeting) -> void {
			targeting.self().enemyTeam().damage(1);   // a leak: the well takes a point
			targeting.self().fall();
		});
	});
	self.setVar("marching", false);
};

self.update = [=](var& self, double dt) -> void {
	statusTick(self, dt);
	if (self.getVar("phasing") != 0) {
		var phased = self.game().creature(self.getVar("phasing"));
		if (phased == null || !inFlight(phased)) {
			if (phased != null) {
				teleportNear(self, self.getVar("phasing"), 3);
				// every forward phase costs a quarter of its life, straight from health
				self.changeHealth(-round(self.stats().health * 0.25));
				// for three seconds after the blink every point the Voidling would take lands on its victim instead
				phased.absorbFor(self.networkId(), 1.0, 1.0);
				self.setVar("redirectTarget", self.getVar("phasing"));
				self.setVar("redirectRemaining", 3.0);
			}
			self.visible(true);
			self.untargetable(false);
			self.setVar("phasing", 0);
		}
		return;
	}
	var redirect = self.getVar("redirectRemaining");
	if (redirect != null && redirect > 0.0) {
		redirect = redirect - dt;
		self.setVar("redirectRemaining", redirect);
		if (redirect <= 0.0) {
			var shieldbearer = self.game().creature(self.getVar("redirectTarget"));
			if (shieldbearer != null) {
				shieldbearer.absorbFor(self.networkId(), 0.0, 1.0);
			}
		}
	}
	// gap-closer: the moment a fight starts, blink onto the backline instead of walking through the front
	var blink = self.getVar("blinkCooldown");
	if (blink > 0.0) {
		self.setVar("blinkCooldown", blink - dt);
	} else if (!self.getVar("attacking") && self.tauntedBy() == 0) {
		var prey = pickBackline(self, 12);
		if (prey != 0) {
			var me = self.agent().gridPosition();
			var p = self.game().creature(prey).agent().gridPosition();
			var well = self.team().enemyWell();
			double d2 = (p.x - me.x) * (p.x - me.x) + (p.y - me.y) * (p.y - me.y);
			double wellD2 = (p.x - well.x) * (p.x - well.x) + (p.y - well.y) * (p.y - well.y);
			// never land inside the well's arrival radius: a blink is a strike, not a leak
			if (d2 > 16.0 && wellD2 > 81.0 && teleportNear(self, prey, 2)) {
				// every forward phase costs a quarter of its life, straight from health
				self.changeHealth(-round(self.stats().health * 0.25));
				self.setVar("blinkCooldown", 8.0);
				self.setVar("activeTarget", 0);
				self.targeting().clear();
			}
		}
	}

	if (!self.getVar("attacking")) {
		var tryToFindAndAttackTarget = self.getVar("tryToFindAndAttackTarget");
		if (!tryToFindAndAttackTarget(self, dt)) {
			if (!self.getVar("marching")) {
				var applyDefaultTarget = self.getVar("applyDefaultTarget");
				applyDefaultTarget(self);
			}
		}
	}
};
