// Voidling (Void T1): low health burst; the first chomp on a target (and every third after) hurls it ten cells back - stunned for the flight - while the Voidling phases out, then reappears beside it where it lands
// Generated by Tools/Creatures/generate_creatures.py.
import "Creatures/Shared/creatureKind.script";

class Voidling : CreatureKind {
	int chompTarget = 0;
	int chompCount = 0;
	int phasing = 0;
	double blinkCooldown = 0.0;
	int redirectTarget = 0;
	double redirectRemaining = 0.0;

	bool tick(double dt) override {
		if (phasing != 0) {
			var phased = game().creature(phasing);
			if (phased == null || !phased.inFlight()) {
				if (phased != null) {
					teleportNear(phasing, 3);
					// every forward phase costs a quarter of its life, straight from health
					changeHealth(-math::round(stats().health * 0.25));
					// for three seconds after the blink every point the Voidling would take lands on its victim instead
					phased.absorbFor(networkId(), 1.0, 1.0);
					redirectTarget = phasing;
					redirectRemaining = 3.0;
				}
				visible(true);
				untargetable(false);
				phasing = 0;
			}
			return true;
		}
		if (redirectRemaining > 0.0) {
			redirectRemaining = redirectRemaining - dt;
			if (redirectRemaining <= 0.0) {
				var shieldbearer = game().creature(redirectTarget);
				if (shieldbearer != null) {
					shieldbearer.absorbFor(networkId(), 0.0, 1.0);
				}
			}
		}
		// gap-closer: the moment a fight starts, blink onto the backline instead of walking through the front
		if (blinkCooldown > 0.0) {
			blinkCooldown = blinkCooldown - dt;
		} else if (!attacking && tauntedBy() == 0) {
			int prey = pickBackline(12.0);
			if (prey != 0) {
				var me = agent().gridPosition();
				var p = game().creature(prey).agent().gridPosition();
				var well = team().enemyWell();
				double d2 = (p.x - me.x) * (p.x - me.x) + (p.y - me.y) * (p.y - me.y);
				double wellD2 = (p.x - well.x) * (p.x - well.x) + (p.y - well.y) * (p.y - well.y);
				// never land inside the well's arrival radius: a blink is a strike, not a leak
				if (d2 > 16.0 && wellD2 > 81.0 && teleportNear(prey, 2)) {
					// every forward phase costs a quarter of its life, straight from health
					changeHealth(-math::round(stats().health * 0.25));
					blinkCooldown = 8.0;
					activeTarget = 0;
					targeting().clear();
				}
			}
		}
			return false;
	}

	void attackTarget(var& targeting, int target) override {
		if (game().creature(target) == null || !game().creature(target).alive()) {
			return;
		}
		if (chompTarget != target) {
			chompTarget = target;
			chompCount = 0;
		}
		int chomp = chompCount;
		chompCount = chomp + 1;
		int bite = (chomp % 3 == 1) ? 20 : 8;
		// the bite is a frontal sweep: everything in the arc toward the target takes it too
		var mePos = agent().gridPosition();
		var victimPos = game().creature(target).agent().gridPosition();
		double fx = victimPos.x - mePos.x;
		double fy = victimPos.y - mePos.y;
		double fl = math::sqrt(fx * fx + fy * fy);
		if (fl < 0.001) {
			fx = 1.0;
			fy = 0.0;
			fl = 1.0;
		}
		fx = fx / fl;
		fy = fy / fl;
		var others = enemiesInRange(2.5);
		for (int i = 0; i < others.size(); ++i) {
			if (others[i].networkId() != target) {
				var p = others[i].agent().gridPosition();
				double dx = p.x - mePos.x;
				double dy = p.y - mePos.y;
				double dl = math::sqrt(dx * dx + dy * dy);
				if (dl > 0.001 && (dx * fx + dy * fy) / dl > 0.3) {
					others[i].stun(0.25);
					strike(others[i].networkId(), bite);
				}
			}
		}
		if (chomp % 3 != 1) {
			game().creature(target).stun(0.25);
		}
		if (chomp % 3 == 1) {
			isolateThrow(target, 10, 0.35, 1.75);
			visible(false);
			untargetable(true);
			agent().stop();
			targeting.clear();
			phasing = target;
		}
		strike(target, bite);
	}

	int pickPrey() override {
		return pickBackline(20.0);
	}

}

// The host hands each creature over as its C++ self; the script decides what it becomes.
self.spawn = [=](var& creature) -> void { extend(creature, Voidling).spawn(); };
self.update = [=](var& creature, double dt) -> void { creature.update(dt); };
self.death = [=](var& creature) -> void { creature.death(); };
