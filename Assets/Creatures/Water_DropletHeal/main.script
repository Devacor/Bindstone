// Tear (Water T1): untargetable; clings to an ally as a ward, taking half its damage and halving status durations
// Generated by Tools/Creatures/generate_creatures.py.
import "Creatures/Shared/creatureKind.script";

class Tear : CreatureKind {
	int host = 0;
	bool attached = false;
	double life = 24.0;
	double clingCooldown = 0.0;
	double refreshCooldown = 0.0;

	void spawn() override {
		untargetable(true);
	}

	bool tick(double dt) override {
		life = life - dt;
		clingCooldown = clingCooldown - dt;
		refreshCooldown = refreshCooldown - dt;
		// the host is gone: let go and be a mob again (footprint back on the map, free to seek)
		if (host != 0 && game().creature(host) == null) {
			if (attached) {
				agent().enableFootprint();
				attached = false;
			}
			host = 0;
			// the ride-along lost its rider: call the Tearel back together
			if (parentTearel != 0 && game().creature(parentTearel) != null) {
				game().creature(parentTearel).recombine = true;
			}
		}
		if (life <= 0.0) {
			fall();
			return true;
		}
		// attached: no occupancy, no pathing - ride the host and keep the ward fresh
		if (host != 0 && attached) {
			agent().localPosition(game().creature(host).agent().localPosition());
			if (refreshCooldown <= 0.0) {
				refreshCooldown = 2.0;
				absorbFor(host, 0.75, 0.33);
				game().creature(host).infusedBy = networkId();
			}
			return true;
		}
		if (host == 0) {
			host = pickWardHost(12.0);
		}
		if (host != 0 && clingCooldown <= 0.0) {
			clingCooldown = 1.0;
			int rider = host;
			targeting().target(rider, 0.5, [rider](var& targeting) -> void {
				if (targeting.self().game().creature(rider) != null && targeting.self().game().creature(rider).alive()) {
					targeting.self().agent().stop();
					targeting.self().agent().disableFootprint();
					targeting.self().attached = true;
					targeting.self().refreshCooldown = 2.0;
					targeting.self().absorbFor(rider, 0.75, 0.33);
					targeting.self().game().creature(rider).infusedBy = targeting.self().networkId();
				}
			}, [=](var& targeting) -> void {});
			return true;
		}
			return false;
	}

	bool seeksTargets() override {
		return false;
	}

}

// The host hands each creature over as its C++ self; the script decides what it becomes.
self.spawn = [=](var& creature) -> void { extend(creature, Tear).spawn(); };
self.update = [=](var& creature, double dt) -> void { creature.update(dt); };
self.death = [=](var& creature) -> void { creature.death(); };
