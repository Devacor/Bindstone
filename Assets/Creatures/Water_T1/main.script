// Tearel (Water T1): untargetable support; at first contact splits into a suffocating Tare, a sheltering Tear and a marching Drip
// Generated by Tools/Creatures/generate_creatures.py.
import "Creatures/Shared/creatureKind.script";

class Tearel : CreatureKind {
	int tareId = 0;
	int tearId = 0;
	int dripId = 0;
	double windowRemaining = 0.0;
	bool recombine = false;
	double recombineIn = 0.0;

	void spawn() override {
		untargetable(true);
	}

	bool tick(double dt) override {
		if (tareId == 0) {
			if (recombineIn > 0.0) {
				recombineIn = recombineIn - dt;
			} else if (nearestEnemyId(8) != 0) {
				int tare = spawnCreature("Water_DropletHurt");
				int tear = spawnCreature("Water_DropletHeal");
				int drip = spawnCreature("Water_Drip");
				game().creature(tare).parentTearel = networkId();
				game().creature(tear).parentTearel = networkId();
				game().creature(drip).parentTearel = networkId();
				tareId = tare;
				tearId = tear;
				dripId = drip;
				windowRemaining = 18.0;
				recombine = false;
				visible(false);
				agent().stop();
				agent().disableFootprint();
			}
		} else {
			windowRemaining = windowRemaining - dt;
			var tare = game().creature(tareId);
			var tear = game().creature(tearId);
			var drip = game().creature(dripId);
			if (tare == null && tear == null && drip == null) {
				// everything it was is gone
				fall();
			} else if (windowRemaining <= 0.0 || recombine) {
				// re-form from whatever survives: their vitality plus a little more
				double vitality = 0.0;
				if (tare != null) { vitality = vitality + 1.0 * tare.health() / tare.maxHealth(); tare.fall(); }
				if (tear != null) { vitality = vitality + 1.0 * tear.health() / tear.maxHealth(); tear.fall(); }
				if (drip != null) { vitality = vitality + 1.0 * drip.health() / drip.maxHealth(); drip.fall(); }
				int reformed = math::round(vitality / 3.0 * maxHealth()) + 10;
				if (reformed > stats().health) { reformed = stats().health; }
				changeHealth(reformed - health());
				tareId = 0;
				tearId = 0;
				dripId = 0;
				recombine = false;
				recombineIn = 6.0;
				visible(true);
				agent().enableFootprint();
			}
			return true;
		}
			return false;
	}

	bool seeksTargets() override {
		return false;
	}

}

// The host hands each creature over as its C++ self; the script decides what it becomes.
self.spawn = [=](var& creature) -> void { extend(creature, Tearel).spawn(); };
self.update = [=](var& creature, double dt) -> void { creature.update(dt); };
self.death = [=](var& creature) -> void { creature.death(); };
