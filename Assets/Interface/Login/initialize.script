self.initialize = [=](var& self) -> void {
	auto emailInput = self.root().get("EmailInput").componentText();
	auto passwordInput = self.root().get("PasswordInput").componentText();
	emailInput.text(DefaultLoginId);
	passwordInput.text(DefaultPassword);
	emailInput.onEnter.connect("Deselect", [=](var& textElement) -> void {
		game.gui().page("Login").removeFocus();
	});
	passwordInput.onEnter.connect("Deselect", [=](var& textElement) -> void {
		game.gui().page("Login").removeFocus();
	});
	if (!DefaultLoginId.empty() && !DefaultPassword.empty()) {
		if (game.client.connected()) {
			print("JAISCRIPT: Already Connected And Trying Login!");
			self.root().get("LoginButton").componentButton().press();
		} else {
			print("JAISCRIPT: Not Connected And Trying Login!");
			messages.lobbyConnected.connect("LoginScreen", [self]() -> void {
				messages.lobbyConnected.disconnect("LoginScreen");
				print("JAISCRIPT: Connection Callback And Trying Login!");
				self.root().get("LoginButton").componentButton().press();
			});
		}
	}
};
