<Project>
  <PropertyGroup>
    <!-- Release|x64 builds without /GL, /LTCG and /OPT:REF,ICF and links the client incrementally. /p:BindstoneFastIteration=false turns them on for the build that ships; JaiScript_Windows stays without /GL either way. -->
    <BindstoneFastIteration Condition="'$(BindstoneFastIteration)'==''">true</BindstoneFastIteration>
  </PropertyGroup>
</Project>
