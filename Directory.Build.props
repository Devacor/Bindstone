<Project>
  <PropertyGroup>
    <!-- Release|x64 is the edit loop: no /GL, /LTCG or /OPT:REF,ICF, incremental client link (~5-8% slower at run time). Shipping|x64 is the full-LTCG build that ships and that perf numbers are taken on. -->
    <BindstoneFastIteration Condition="'$(BindstoneFastIteration)'==''">true</BindstoneFastIteration>
  </PropertyGroup>
</Project>
