# The engine runs in a worker that shares memory with the page, which browsers allow only on a cross-origin isolated page
<IfModule mod_headers.c>
Header set Cross-Origin-Opener-Policy "same-origin"
Header set Cross-Origin-Embedder-Policy "require-corp"
</IfModule>
AddType application/wasm .wasm
# The sandbox is a tab of the Play page
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^sandbox\.html$ /play/index.html#sandbox [NE,R=301,L]
</IfModule>
