// Combat: line of sight, hitscan weapons, projectiles, explosions, damage.

// stepped-ray LOS on the tile grid (deterministic float march)
def los_clear(ax, ay, bx, by) {
	var dx = bx - ax;
	var dy = by - ay;
	var len = sqrt(dx * dx + dy * dy);
	if (len < 0.001) { return true; }
	var inv = 1.0 / len;
	dx = dx * inv;
	dy = dy * inv;
	var t = 0.15;
	while (t < len) {
		if (tile_solid(tile_at(ifloor(ax + dx * t), ifloor(ay + dy * t)))) { return false; }
		t += 0.15;
	}
	return true;
}

// wall distance along an arbitrary unit ray (perp == euclid for unit dirs)
def wall_dist(ax, ay, dx, dy) {
	cast_wall_ray(ax, ay, dx, dy);
	return RAY_D;
}

// nearest live enemy along a unit ray, cross-checked against the wall
def hitscan(ax, ay, dx, dy, lo, hi, from_player) {
	var wd = wall_dist(ax, ay, dx, dy);
	var best = -1;
	var best_t = 999.0;
	var i = 0;
	for (e : G.enemies) {
		if (e.alive) {
			var rx = e.x - ax;
			var ry = e.y - ay;
			var t = rx * dx + ry * dy;
			if (t >= 0.2 && t <= wd + e.radius && t < best_t) {
				var perp = rx * dy - ry * dx;
				if (perp < 0.0) { perp = 0.0 - perp; }
				if (perp < e.radius + 0.12) {
					best = i;
					best_t = t;
				}
			}
		}
		i += 1;
	}
	if (best >= 0) {
		G.enemies[best].hurt(RNG.roll(lo, hi));
		return true;
	}
	// wall impact garnish just short of the surface
	fx_wall_hit(ax + dx * (wd - 0.08), ay + dy * (wd - 0.08));
	return false;
}

// turret bolt: instant, accuracy falls off with range
def turret_shot(tx, ty) {
	var dx = G.px - tx;
	var dy = G.py - ty;
	var d = sqrt(dx * dx + dy * dy);
	if (d < 0.001) { return; }
	fx_muzzle(tx, ty, dx / d, dy / d);
	var hit_pct = imax(12, 66 - itrunc(d * 5.0));
	if (RNG.chance(hit_pct) && los_clear(tx, ty, G.px, G.py)) {
		damage_player(RNG.roll(2, 6), "turret fire");
	} else {
		// tracer smacks the wall behind you
		var wd = wall_dist(tx, ty, dx / d, dy / d) - 0.1;
		var t = d + 1.5;
		if (t > wd) { t = wd; }
		fx_wall_hit(tx + dx / d * t, ty + dy / d * t);
	}
}

// ------------------------------------------------------------ projectiles ---
// value records: [kind, x, y, vx, vy, ttl]
//   kind 1 spitter gob | 2 warden hollow fire | 3 player hex bolt
def spawn_shot(kind, ax, ay, tx, ty, speed) {
	var dx = tx - ax;
	var dy = ty - ay;
	var len = sqrt(dx * dx + dy * dy);
	if (len < 0.001) { return; }
	G.shots.push_back([kind, ax + dx / len * 0.4, ay + dy / len * 0.4, dx / len * speed, dy / len * speed, 150]);
}

def spawn_shot_dir(kind, ax, ay, dx, dy, speed) {
	G.shots.push_back([kind, ax + dx * 0.45, ay + dy * 0.45, dx * speed, dy * speed, 150]);
}

def update_shots() {
	var kept = [];
	var nshots = vlen(G.shots);
	for (var i = 0; i < nshots; ++i) {
		var s := G.shots[i];
		var kind = s[0];
		var x = s[1];
		var y = s[2];
		var vx = s[3];
		var vy = s[4];
		var ttl = s[5] - 1;
		var dead = ttl <= 0;
		// 3 substeps so fast bolts don't tunnel tile corners
		var sub = 0;
		while (sub < 3 && !dead) {
			x += vx * TICK * 0.333333333;
			y += vy * TICK * 0.333333333;
			if (tile_solid(tile_at(ifloor(x), ifloor(y)))) {
				if (kind == 3) { explode_hex(x - vx * 0.02, y - vy * 0.02); }
				else if (kind == 2) { explode_fire(x - vx * 0.02, y - vy * 0.02); }
				else { fx_wall_hit(x - vx * 0.02, y - vy * 0.02); }
				dead = true;
				break;
			}
			if (kind == 3) {
				// player bolt vs enemies
				for (e : G.enemies) {
					if (!e.alive) { continue; }
					if (dist2(x, y, e.x, e.y) < (e.radius + 0.2) * (e.radius + 0.2)) {
						explode_hex(x, y);
						dead = true;
						break;
					}
				}
			} else {
				// enemy shot vs player
				if (dist2(x, y, G.px, G.py) < 0.14) {
					if (kind == 2) { explode_fire(x, y); }
					else { damage_player(RNG.roll(4, 9), "a caustic gob"); fx_blood(x, y, 0.5, 3); }
					dead = true;
					break;
				}
			}
			sub += 1;
		}
		if (!dead) { kept.push_back([kind, x, y, vx, vy, ttl]); }
	}
	G.shots = kept;
	// glow trail
	var n2 = vlen(G.shots);
	for (var i2 = 0; i2 < n2; ++i2) {
		var s2 := G.shots[i2];
		var k2 = s2[0];
		if ((G.tick + i2) % 2 == 0) {
			G.fx.spawn(k2 == 1 ? 6 : (k2 == 2 ? 1 : 6), s2[1], s2[2], 0.5, 0.0, 0.0, 0.0, 4);
		}
	}
}

def explode_hex(x, y) {
	fx_explosion(x, y);
	G.noise = 20;
	for (e : G.enemies) {
		if (!e.alive) { continue; }
		var d2 = dist2(x, y, e.x, e.y);
		if (d2 < 3.24) {                              // radius 1.8
			var dmg = itrunc(42.0 - sqrt(d2) * 14.0);
			if (dmg > 0) { e.hurt(dmg); }
		}
	}
	// standing in your own spell is a choice
	var pd2 = dist2(x, y, G.px, G.py);
	if (pd2 < 2.25) {
		var self = itrunc(20.0 - sqrt(pd2) * 10.0);
		if (self > 0) { damage_player(self, "your own hex"); }
	}
}

def explode_fire(x, y) {
	fx_explosion(x, y);
	var pd2 = dist2(x, y, G.px, G.py);
	if (pd2 < 2.89) {                                 // radius 1.7
		var dmg = itrunc(26.0 - sqrt(pd2) * 9.0);
		if (dmg > 0) { damage_player(dmg, "hollow fire"); }
	}
}

// ------------------------------------------------------------ the player ----
def damage_player(dmg, src) {
	if (G.mode != 1 || dmg <= 0) { return; }
	if (HOST_GOD) { return; }
	var absorbed = imin(G.armor, dmg * 2 / 3);
	G.armor -= absorbed;
	var taken = dmg - absorbed;
	G.hp -= taken;
	G.face_pain = 12;
	G.hurt_flash = 4;
	show_msg("-${taken} hp (${src})", "91");
	if (G.hp <= 0) {
		G.hp = 0;
		G.mode = 3;
		G.mode_t = 0;
		G.death_cause = src;
		show_msg("you died", "91");
	}
}

def player_fire() {
	if (G.cooldown > 0) { return; }
	var w := WEAPONS[G.weapon];
	var ammo_type = w["ammo"];
	if (G.ammo[ammo_type] <= 0) {
		var an = AMMO_NAMES[ammo_type];
		show_msg("out of ${an}S", "93");
		G.cooldown = 8;
		return;
	}
	G.ammo[ammo_type] = G.ammo[ammo_type] - 1;
	G.cooldown = w["cd"];
	G.muzzle = 3;
	G.noise = 24;
	G.gun_kick = 4;
	var dirx = cos(G.pang);
	var diry = sin(G.pang);
	fx_muzzle(G.px, G.py, dirx, diry);
	if (w["kind"] == 1) {
		spawn_shot_dir(3, G.px, G.py, dirx, diry, 9.0);
		return;
	}
	var pellets = w["pellets"];
	var spread = w["spread"];
	for (var i = 0; i < pellets; ++i) {
		var a = G.pang + (RNG.nextf() - 0.5) * 2.0 * spread;
		hitscan(G.px, G.py, cos(a), sin(a), w["lo"], w["hi"], true);
	}
}
