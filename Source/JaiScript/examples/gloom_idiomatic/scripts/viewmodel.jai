map<string, shared_ptr<Art>> VIEWMODELS = {};
array<string> VIEWMODEL_NAMES = ["vm_pistol", "vm_scatter", "vm_hex"];

function parse_viewmodels() -> void {
	VIEWMODELS = {};
	for (auto kv : VIEWMODEL_SRC) { VIEWMODELS[kv.first] = parse_art(kv.second); }
}
