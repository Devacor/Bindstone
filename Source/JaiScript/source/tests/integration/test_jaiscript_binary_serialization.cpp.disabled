#include <jaiscript/testing/foundry.hpp>
#include <jaiscript/core/engine.hpp>
#include <jaiscript/core/class_builder.hpp>
#include <jaiscript/stdlib/stdlib.hpp>
#include <jaiscript/serialization/binary_archive.hpp>
#include <sstream>

using namespace jai;
using namespace jai::foundry;

// Test classes for serialization
class test_point {
public:
    test_point() : x(0.0), y(0.0) {}
    test_point(double x, double y) : x(x), y(y) {}
    
    double x;
    double y;
};

class test_node : public std::enable_shared_from_this<test_node> {
public:
    test_node(const std::string& name) : name_(name), value_(0) {}
    
    std::string get_name() const { return name_; }
    void set_name(const std::string& name) { name_ = name; }
    
    int get_value() const { return value_; }
    void set_value(int value) { value_ = value; }
    
    void set_next(std::shared_ptr<test_node> next) { next_ = next; }
    std::shared_ptr<test_node> get_next() const { return next_; }
    
    void set_parent(std::shared_ptr<test_node> parent) { parent_ = parent; }
    std::weak_ptr<test_node> get_parent() const { return parent_; }
    
private:
    std::string name_;
    int value_;
    std::shared_ptr<test_node> next_;
    std::weak_ptr<test_node> parent_;
};

class jaiscript_binary_serialization_tests : public suite {
public:
    jaiscript_binary_serialization_tests() : suite("JaiScript Binary Serialization") {}
    
    void forge_tests() override {
        test("basic_value_serialization", [this]() {
            engine engine;
            stdlib::register_all(engine);
            
            // Test basic types round-trip
            auto test_round_trip = [&](const std::string& script_expr) {
                std::string test_script = "from_binary(to_binary(" + script_expr + "))";
                script_value original = engine.execute(script_expr);
                script_value restored = engine.execute(test_script);
                
                check_eq(original.type(), restored.type());
                check_eq(original.to_string(), restored.to_string());
            };
            
            test_round_trip("null");
            test_round_trip("true");
            test_round_trip("false");
            test_round_trip("42");
            test_round_trip("-123");
            test_round_trip("3.14159");
            test_round_trip("\"hello world\"");
            test_round_trip("'x'");
        });
        
        test("array_serialization", [this]() {
            engine engine;
            stdlib::register_all(engine);
            
            // Test heterogeneous array
            std::string script = R"(
                var arr = [1, "hello", 3.14, true, null];
                var restored = from_binary(to_binary(arr));
                restored
            )";
            
            script_value result = engine.execute(script);
            check(result.is_array(), "Result should be an array");
            
            const auto& arr = result.as_array();
            check_eq(arr.size(), 5u);
            check_eq(arr[0].as<script_int>(), 1);
            check_eq(arr[1].as<script_string>(), "hello");
            check_near(arr[2].as<script_float>(), 3.14, 0.001);
            check_eq(arr[3].as<script_bool>(), true);
            check(arr[4].is_null(), "arr[4] should be null");
        });
        
        test("map_serialization", [this]() {
            engine engine;
            stdlib::register_all(engine);
            
            std::string script = R"(
                var map = {"name": "test", "value": 42, "flag": true};
                var restored = from_binary(to_binary(map));
                restored
            )";
            
            script_value result = engine.execute(script);
            check(result.is_map(), "Result should be a map");
            
            const auto& map = result.as_map();
            check_eq(map.size(), 3u);
            check_eq(map.at(script_value("name")).as<script_string>(), "test");
            check_eq(map.at(script_value("value")).as<script_int>(), 42);
            check_eq(map.at(script_value("flag")).as<script_bool>(), true);
        });
        
        test("cpp_object_serialization", [this]() {
            engine engine;
            stdlib::register_all(engine);
            
            // Register test_point class
            make_class_builder<test_point>(engine, "TestPoint")
                .constructor<>()
                .constructor<double, double>()
                .property("x", &test_point::x)
                .property("y", &test_point::y)
                .build();
            
            std::string script = R"(
                var point = TestPoint(3.5, 4.2);
                var restored = from_binary(to_binary(point));
                {
                    "x": restored.x,
                    "y": restored.y,
                    "type": restored._type_
                }
            )";
            
            script_value result = engine.execute(script);
            check(result.is_map(), "Result should be a map");
            
            const auto& map = result.as_map();
            check_near(map.at(script_value("x")).as<script_float>(), 3.5, 0.001);
            check_near(map.at(script_value("y")).as<script_float>(), 4.2, 0.001);
            check_eq(map.at(script_value("type")).as<script_string>(), "TestPoint");
        });
        
        test("shared_ptr_basic", [this]() {
            engine engine;
            stdlib::register_all(engine);
            
            // Test shared_ptr serialization
            std::string script = R"(
                var obj = {"value": 42};
                var ptr = make_shared(obj);
                var restored = from_binary(to_binary(ptr));
                restored.value
            )";
            
            script_value result = engine.execute(script);
            check_eq(result.as<script_int>(), 42);
        });
        
        test("shared_ptr_deduplication", [this]() {
            engine engine;
            stdlib::register_all(engine);
            
            // Test that multiple shared_ptrs to same object are deduplicated
            std::string script = R"(
                var obj = {"value": 100};
                var ptr1 = make_shared(obj);
                var ptr2 = ptr1;  // Same object
                
                var data = {"first": ptr1, "second": ptr2};
                var binary = to_binary(data);
                
                // Check that binary size indicates deduplication
                // (rough check - exact size depends on implementation)
                binary.size() < 100  // Should be much smaller if deduplicated
            )";
            
            script_value result = engine.execute(script);
            check(result.as<script_bool>(), "Test condition failed");
        });
        
        test("weak_ptr_serialization", [this]() {
            engine engine;
            stdlib::register_all(engine);
            
            // First fix make_weak_ptr to support conversion from shared_ptr
            engine.add_variadic_function("make_weak_from_shared", [](const std::vector<script_value>& args) -> script_value {
                if (args.size() != 1) {
                    throw runtime_error("make_weak_from_shared expects exactly 1 argument");
                }
                
                const auto& arg = args[0];
                if (arg.type() == value_type::jai_shared_ptr_type) {
                    // For now, just return a null weak_ptr since we can't access private members
                    // The actual implementation would need to be added to script_value class
                    return script_value::make_weak_ptr(script_value());
                }
                
                throw runtime_error("make_weak_from_shared requires a shared_ptr argument");
            });
            
            // Test weak_ptr serialization
            std::string script = R"(
                var obj = {"value": 200};
                var shared = make_shared(obj);
                var weak = make_weak_from_shared(shared);
                
                // Serialize both
                var data = {"shared": shared, "weak": weak};
                var restored = from_binary(to_binary(data));
                
                // Check that weak_ptr still points to same object
                restored.shared.value == 200 && restored.weak != null
            )";
            
            script_value result = engine.execute(script);
            check(result.as<script_bool>(), "Test condition failed");
        });
        
        test("circular_reference_handling", [this]() {
            engine engine;
            stdlib::register_all(engine);
            
            // Register test_node class with shared_ptr/weak_ptr support
            make_class_builder<test_node>(engine, "TestNode")
                .constructor<const std::string&>()
                .method("get_name", &test_node::get_name)
                .method("set_name", &test_node::set_name)
                .method("get_value", &test_node::get_value)
                .method("set_value", &test_node::set_value)
                .method("set_next", &test_node::set_next)
                .method("get_next", &test_node::get_next)
                .method("set_parent", &test_node::set_parent)
                .method("get_parent", &test_node::get_parent)
                .build();
            
            // Create circular structure with shared_ptr/weak_ptr
            auto parent = std::make_shared<test_node>("parent");
            auto child1 = std::make_shared<test_node>("child1");
            auto child2 = std::make_shared<test_node>("child2");
            
            parent->set_value(100);
            child1->set_value(200);
            child2->set_value(300);
            
            // Create circular reference: parent -> child1 -> child2
            // And weak back references: child1 -> parent, child2 -> parent
            parent->set_next(child1);
            child1->set_next(child2);
            child1->set_parent(parent);
            child2->set_parent(parent);
            
            // Add to engine
            // Create a script_value from the C++ object
            script_value parent_val = script_value::make_object("TestNode", parent);
            engine.add_global("test_parent", parent_val);
            
            // Test serialization with circular references
            std::string script = R"(
                var binary = to_binary(test_parent);
                var restored = from_binary(binary);
                
                // Verify structure is preserved
                restored.get_name() == "parent" &&
                restored.get_value() == 100 &&
                restored.get_next().get_name() == "child1" &&
                restored.get_next().get_value() == 200 &&
                restored.get_next().get_next().get_name() == "child2" &&
                restored.get_next().get_next().get_value() == 300
            )";
            
            script_value result = engine.execute(script);
            check(result.as<script_bool>(), "Test condition failed");
        });
        
        test("null_and_expired_pointers", [this]() {
            engine engine;
            stdlib::register_all(engine);
            
            // Test null shared_ptr
            std::string null_test = R"(
                var null_ptr = make_shared(null);
                var restored = from_binary(to_binary(null_ptr));
                restored == null
            )";
            
            script_value result = engine.execute(null_test);
            check(result.as<script_bool>(), "Test condition failed");
            
            // Test expired weak_ptr (would need custom function to test properly)
            // For now just test that weak_ptr without shared_ptr serializes as null
            engine.add_variadic_function("make_expired_weak", [](const std::vector<script_value>& args) -> script_value {
                // Return an empty weak_ptr
                return script_value::make_weak_ptr(script_value());
            });
            
            std::string expired_test = R"(
                var expired = make_expired_weak();
                var restored = from_binary(to_binary(expired));
                restored == null || restored == expired  // Implementation dependent
            )";
            
            result = engine.execute(expired_test);
            check(result.as<script_bool>(), "Test condition failed");
        });
        
        test("binary_format_portability", [this]() {
            // Test that binary format is portable (little-endian)
            serialization::binary_archive_writer writer;
            
            // Write some test values
            writer.write_int32(0x12345678);
            writer.write_float64(3.14159);
            writer.write_string("test");
            
            const auto& data = writer.data();
            
            // Check little-endian encoding of int32
            check_eq(data[0], 0x78);  // LSB first
            check_eq(data[1], 0x56);
            check_eq(data[2], 0x34);
            check_eq(data[3], 0x12);  // MSB last
            
            // Read back to verify
            serialization::binary_archive_reader reader(data);
            check_eq(reader.read_int32(), 0x12345678);
            check_near(reader.read_float64(), 3.14159, 0.00001);
            check_eq(reader.read_string(), "test");
        });
        
        test("performance_benchmark", [this]() {
            engine engine;
            stdlib::register_all(engine);
            
            // Create a reasonably complex data structure
            std::string setup = R"(
                var data = {
                    "users": [
                        {"id": 1, "name": "Alice", "scores": [100, 95, 98]},
                        {"id": 2, "name": "Bob", "scores": [85, 90, 92]},
                        {"id": 3, "name": "Charlie", "scores": [78, 88, 95]}
                    ],
                    "metadata": {
                        "version": "1.0",
                        "timestamp": 1234567890,
                        "flags": [true, false, true]
                    }
                };
                data
            )";
            
            script_value test_data = engine.execute(setup);
            
            // Benchmark serialization
            auto start = std::chrono::high_resolution_clock::now();
            
            const int iterations = 1000;
            for (int i = 0; i < iterations; ++i) {
                engine.execute("to_binary(data)");
            }
            
            auto end = std::chrono::high_resolution_clock::now();
            auto duration = std::chrono::duration_cast<std::chrono::microseconds>(end - start);
            
            double avg_time = duration.count() / static_cast<double>(iterations);
            
            // Log performance (adjust threshold as needed)
            check(avg_time < 1000.0, "Performance too slow");  // Should serialize in < 1ms on average
            
            // Also test deserialization performance
            script_value binary_data = engine.execute("to_binary(data)");
            engine.add_global("binary_data", binary_data);
            
            start = std::chrono::high_resolution_clock::now();
            
            for (int i = 0; i < iterations; ++i) {
                engine.execute("from_binary(binary_data)");
            }
            
            end = std::chrono::high_resolution_clock::now();
            duration = std::chrono::duration_cast<std::chrono::microseconds>(end - start);
            
            avg_time = duration.count() / static_cast<double>(iterations);
            check(avg_time < 1000.0, "Performance too slow");  // Should deserialize in < 1ms on average
        });
    }
};


// For isolated compilation
CONDITIONAL_ISOLATED_TEST(jaiscript_binary_serialization_tests)