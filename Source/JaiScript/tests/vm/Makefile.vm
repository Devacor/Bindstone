# VM Test Suite Makefile Fragment
# Include this in the main foundry Makefile

VM_TEST_DIR := vm
VM_TESTS := \
    $(VM_TEST_DIR)/vm_function_tests.cpp \
    $(VM_TEST_DIR)/vm_class_tests.cpp \
    $(VM_TEST_DIR)/vm_bytecode_verification_tests.cpp \
    $(VM_TEST_DIR)/vm_integration_tests.cpp

VM_TEST_OBJECTS := $(VM_TESTS:.cpp=.o)
VM_ISOLATED_TESTS := $(VM_TESTS:$(VM_TEST_DIR)/%.cpp=test_isolated_$(VM_TEST_DIR)/%)

# Add to main test lists
TEST_SOURCES += $(VM_TESTS)
TEST_OBJECTS += $(VM_TEST_OBJECTS)
ISOLATED_TESTS += $(VM_ISOLATED_TESTS)

# VM-specific compilation flags (if needed)
$(VM_TEST_OBJECTS): CXXFLAGS += -DJAI_VM_TESTING

# Pattern rules for VM tests
$(VM_TEST_DIR)/%.o: $(VM_TEST_DIR)/%.cpp
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

test_isolated_$(VM_TEST_DIR)/%: $(VM_TEST_DIR)/%.cpp $(JAISCRIPT_LIB)
	@mkdir -p test_isolated_$(VM_TEST_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -DFOUNDRY_STANDALONE $< -o $@ $(LDFLAGS)

# Convenience targets
.PHONY: test-vm isolated-vm clean-vm

test-vm: $(VM_TEST_OBJECTS)
	@echo "VM tests built successfully"

isolated-vm: $(VM_ISOLATED_TESTS)
	@echo "Isolated VM tests built successfully"

clean-vm:
	rm -f $(VM_TEST_OBJECTS)
	rm -rf test_isolated_$(VM_TEST_DIR)

# Individual isolated test shortcuts
isolated-vm-function: test_isolated_$(VM_TEST_DIR)/vm_function_tests
isolated-vm-class: test_isolated_$(VM_TEST_DIR)/vm_class_tests
isolated-vm-bytecode: test_isolated_$(VM_TEST_DIR)/vm_bytecode_verification_tests
isolated-vm-integration: test_isolated_$(VM_TEST_DIR)/vm_integration_tests