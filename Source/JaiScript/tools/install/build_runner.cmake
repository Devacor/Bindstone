# Configures a Release tree and builds the jaiscript runner with the platform's default CMake generator: Visual Studio on
# Windows, Makefiles elsewhere. No Ninja and no developer prompt needed.
#
#   cmake -P tools/install/build_runner.cmake        # the tree in build/, the runner in build/bin
#
# -D options, given before -P:
#   JAI_BUILD_DIR=<dir>    the build tree (default: build/ in the source tree)
#   JAI_BIN_DIR=<dir>      also copy the runner there
#   JAI_RUNNER_ONLY=ON     configure the runner alone: no tests, examples, jai_spider, language server or install rules
#   JAI_GENERATOR=<name>   a CMake generator (the CMAKE_GENERATOR environment variable works too)
#   JAI_CXX=<compiler>     a C++ compiler (the CXX environment variable works too)
#   JAI_JOBS=<n>           parallel jobs (default: the logical cores, at most one per 1.5 GiB of memory)
#   JAI_REPLACE_TREE=ON    delete and remake a build tree configured with another generator or compiler
cmake_minimum_required(VERSION 3.25)

get_filename_component(source_dir "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(NOT DEFINED JAI_BUILD_DIR OR JAI_BUILD_DIR STREQUAL "")
	set(JAI_BUILD_DIR "${source_dir}/build")
endif()
get_filename_component(build_dir "${JAI_BUILD_DIR}" ABSOLUTE)

set(generator "${JAI_GENERATOR}")
if(generator STREQUAL "" AND DEFINED ENV{CMAKE_GENERATOR})
	set(generator "$ENV{CMAKE_GENERATOR}")
endif()
set(cxx "${JAI_CXX}")
if(cxx STREQUAL "" AND DEFINED ENV{CXX})
	set(cxx "$ENV{CXX}")
endif()

if(EXISTS "${build_dir}/CMakeCache.txt")
	file(STRINGS "${build_dir}/CMakeCache.txt" cached_generator REGEX "^CMAKE_GENERATOR:INTERNAL=")
	string(REGEX REPLACE "^CMAKE_GENERATOR:INTERNAL=" "" cached_generator "${cached_generator}")
	file(STRINGS "${build_dir}/CMakeCache.txt" cached_cxx REGEX "^CMAKE_CXX_COMPILER:[A-Z]+=")
	string(REGEX REPLACE "^CMAKE_CXX_COMPILER:[A-Z]+=" "" cached_cxx "${cached_cxx}")
	set(mismatch "")
	if(NOT generator STREQUAL "" AND NOT generator STREQUAL cached_generator)
		set(mismatch "the generator ${cached_generator}, not ${generator}")
	elseif(NOT cxx STREQUAL "" AND NOT cached_cxx STREQUAL "")
		get_filename_component(cxx_name "${cxx}" NAME_WE)
		get_filename_component(cached_cxx_name "${cached_cxx}" NAME_WE)
		if(NOT cxx_name STREQUAL cached_cxx_name)
			set(mismatch "the compiler ${cached_cxx}, not ${cxx}")
		endif()
	endif()
	if(NOT mismatch STREQUAL "")
		if(JAI_REPLACE_TREE)
			message(STATUS "${build_dir} was configured with ${mismatch}: making it again")
			file(REMOVE_RECURSE "${build_dir}")
		else()
			message(FATAL_ERROR "${build_dir} was configured with ${mismatch}. Delete it, or pass -DJAI_BUILD_DIR=<another folder>.")
		endif()
	elseif(generator STREQUAL "")
		set(generator "${cached_generator}")
	endif()
endif()

set(configure -S "${source_dir}" -B "${build_dir}" -DCMAKE_BUILD_TYPE=Release)
if(NOT generator STREQUAL "")
	list(APPEND configure -G "${generator}")
endif()
if(NOT "${JAI_CXX}" STREQUAL "")
	list(APPEND configure "-DCMAKE_CXX_COMPILER=${JAI_CXX}")
endif()
if(JAI_RUNNER_ONLY)
	list(APPEND configure -DJAISCRIPT_BUILD_TESTS=OFF -DJAISCRIPT_BUILD_EXAMPLES=OFF -DJAISCRIPT_BUILD_SPIDER=OFF
		-DJAISCRIPT_BUILD_LSP=OFF -DJAISCRIPT_INSTALL=OFF)
endif()

if(NOT DEFINED JAI_JOBS OR JAI_JOBS STREQUAL "")
	cmake_host_system_information(RESULT cores QUERY NUMBER_OF_LOGICAL_CORES)
	cmake_host_system_information(RESULT memory_mib QUERY TOTAL_PHYSICAL_MEMORY)
	math(EXPR JAI_JOBS "${memory_mib} / 1536")
	if(JAI_JOBS GREATER cores)
		set(JAI_JOBS ${cores})
	endif()
	if(JAI_JOBS LESS 1)
		set(JAI_JOBS 1)
	endif()
endif()

execute_process(COMMAND "${CMAKE_COMMAND}" ${configure} RESULT_VARIABLE result)
if(NOT result EQUAL 0)
	message(FATAL_ERROR "Configuring ${build_dir} failed. It needs a C++20 compiler: Visual Studio 2022 or newer with the "
		"\"Desktop development with C++\" workload on Windows, the Xcode command line tools on macOS (xcode-select --install), "
		"g++ 11 or clang++ 14 or newer on Linux.")
endif()
message(STATUS "Building jaiscript_runner in ${build_dir}, ${JAI_JOBS} jobs at a time")
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build_dir}" --config Release --target jaiscript_runner --parallel ${JAI_JOBS}
	RESULT_VARIABLE result)
if(NOT result EQUAL 0)
	message(FATAL_ERROR "Building the runner in ${build_dir} failed")
endif()

set(runner "${build_dir}/bin/jaiscript")
if(CMAKE_HOST_WIN32)
	string(APPEND runner ".exe")
endif()
if(NOT EXISTS "${runner}")
	message(FATAL_ERROR "The build finished without ${runner}")
endif()
if(DEFINED JAI_BIN_DIR AND NOT JAI_BIN_DIR STREQUAL "")
	get_filename_component(bin_dir "${JAI_BIN_DIR}" ABSOLUTE)
	file(MAKE_DIRECTORY "${bin_dir}")
	get_filename_component(runner_name "${runner}" NAME)
	set(installed "${bin_dir}/${runner_name}")
	file(COPY_FILE "${runner}" "${installed}.new")
	# Windows renames a running program but never overwrites one
	execute_process(COMMAND "${CMAKE_COMMAND}" -E rm -f "${installed}.old")
	if(EXISTS "${installed}")
		file(RENAME "${installed}" "${installed}.old")
	endif()
	file(RENAME "${installed}.new" "${installed}")
	execute_process(COMMAND "${CMAKE_COMMAND}" -E rm -f "${installed}.old" ERROR_QUIET)
	set(runner "${installed}")
endif()
message(STATUS "The runner: ${runner}")
