{
  "name": "jaiscript",
  "displayName": "JaiScript",
  "description": "JaiScript language support: syntax highlighting and attach debugging for the JaiScript embedded scripting language (MutedVision / Bindstone).",
  "version": "0.1.1",
  "publisher": "snapjaw",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onDebug"
  ],
  "contributes": {
    "breakpoints": [
      {
        "language": "jaiscript"
      }
    ],
    "languages": [
      {
        "id": "jaiscript",
        "aliases": [
          "JaiScript"
        ],
        "extensions": [
          ".script",
          ".jai",
          ".jaibite"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jaiscript",
        "scopeName": "source.jaiscript",
        "path": "./syntaxes/jaiscript.tmLanguage.json"
      }
    ],
    "debuggers": [
      {
        "type": "jaiscript",
        "label": "JaiScript (attach)",
        "configurationAttributes": {
          "attach": {
            "required": [
              "host",
              "port"
            ],
            "properties": {
              "host": {
                "type": "string",
                "description": "Host the JaiScript debug_connector TCP server is listening on.",
                "default": "127.0.0.1"
              },
              "port": {
                "type": "number",
                "description": "Port passed to jai::debug_connector (engine->set_debug_connector(make_shared<jai::debug_connector>(port))).",
                "default": 1234
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "jaiscript",
            "request": "attach",
            "name": "Attach to JaiScript",
            "host": "127.0.0.1",
            "port": 1234
          }
        ],
        "configurationSnippets": [
          {
            "label": "JaiScript: Attach",
            "description": "Attach to a running host exposing a JaiScript debug_connector TCP port.",
            "body": {
              "type": "jaiscript",
              "request": "attach",
              "name": "Attach to JaiScript",
              "host": "127.0.0.1",
              "port": 1234
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/vscode": "^1.75.0",
    "@types/node": "^18.19.0"
  }
}
