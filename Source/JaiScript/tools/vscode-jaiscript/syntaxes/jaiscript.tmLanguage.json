{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "JaiScript",
  "scopeName": "source.jaiscript",
  "fileTypes": ["jai", "jaiscript"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#template-strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#storage" },
    { "include": "#class-declaration" },
    { "include": "#function-declaration" },
    { "include": "#support-functions" },
    { "include": "#function-call" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.jaiscript",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.jaiscript",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.jaiscript",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.jaiscript",
          "match": "\\\\([nrt\\\\\"'])"
        },
        {
          "name": "invalid.illegal.unknown-escape.jaiscript",
          "match": "\\\\."
        }
      ]
    },
    "template-strings": {
      "name": "string.interpolated.jaiscript",
      "begin": "`",
      "end": "`",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.template.begin.jaiscript" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.template.end.jaiscript" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.jaiscript",
          "match": "\\\\([nrt\\\\`$])"
        },
        { "include": "#template-substitution" }
      ]
    },
    "template-substitution": {
      "name": "meta.template.expression.jaiscript",
      "begin": "\\$\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.template-expression.begin.jaiscript" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.template-expression.end.jaiscript" }
      },
      "patterns": [
        { "include": "#expression-in-braces" }
      ]
    },
    "expression-in-braces": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#template-strings" },
        { "include": "#strings" },
        { "include": "#chars" },
        { "include": "#numbers" },
        { "include": "#constants" },
        { "include": "#keywords" },
        { "include": "#storage" },
        { "include": "#support-functions" },
        { "include": "#function-call" },
        { "include": "#operators" },
        { "include": "#identifiers" },
        {
          "comment": "balanced { } so a map literal / block inside ${ } doesn't end the interpolation early",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            { "include": "#expression-in-braces" }
          ]
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.jaiscript",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.jaiscript",
          "match": "\\\\([nrt\\\\\"'])"
        },
        {
          "name": "invalid.illegal.unknown-escape.jaiscript",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.jaiscript",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.jaiscript",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.float.jaiscript",
          "match": "\\b[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?\\b(?<=[.eE0-9])(?=[fFeE.]|[^0-9a-zA-Z_]|$)"
        },
        {
          "name": "constant.numeric.octal.jaiscript",
          "match": "\\b0[0-7]+\\b"
        },
        {
          "name": "constant.numeric.decimal.jaiscript",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.jaiscript",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.jaiscript",
          "match": "\\b(null|nullptr)\\b"
        },
        {
          "name": "variable.language.this.jaiscript",
          "match": "\\b(this|super)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.jaiscript",
          "match": "\\b(if|else|while|for|break|continue|return|try|catch|throw|switch|case|default|fallthrough|yield)\\b"
        }
      ]
    },
    "storage": {
      "patterns": [
        {
          "name": "storage.type.class.jaiscript",
          "match": "\\b(class|coroutine|enum|namespace|function)\\b"
        },
        {
          "name": "storage.modifier.jaiscript",
          "match": "\\b(const|static|override|public|private|protected|new|import|include)\\b"
        },
        {
          "name": "storage.type.jaiscript",
          "match": "\\b(int|float|bool|char|string|void|map|array|weak_ptr|shared_ptr|auto|var)\\b"
        }
      ]
    },
    "class-declaration": {
      "match": "\\b(class|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.class.jaiscript" },
        "2": { "name": "entity.name.type.class.jaiscript" }
      }
    },
    "function-declaration": {
      "match": "\\b(function|coroutine)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.class.jaiscript" },
        "2": { "name": "entity.name.function.jaiscript" }
      }
    },
    "support-functions": {
      "name": "support.function.builtin.jaiscript",
      "match": "\\b(print|to_string|type_of|to_json|from_json|to_binary|from_binary|to_base64|from_base64|base64_encode|base64_decode|is_registered_type|format|abs|acos|asin|atan|atan2|cbrt|ceil|clamp|concatenate|cos|cosh|degrees|exp|exp2|floor|fmod|hypot|is_inf|is_nan|lerp|log|log10|log2|max|merge|min|mix|mix_in|mix_in_out|mix_out|mix_out_in|pow|radians|random|random_int|random_range|remap|round|saturate|sign|sin|sinh|sqrt|tan|tanh|trunc|unmix|unmix_in|unmix_in_out|unmix_out|unmix_out_in|wrap|append|saturate)(?=\\s*\\()"
    },
    "function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.jaiscript" }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.spaceship.jaiscript",
          "match": "<=>"
        },
        {
          "name": "keyword.operator.assignment.compound.jaiscript",
          "match": "(\\+=|-=|\\*=|/=|%=)"
        },
        {
          "name": "keyword.operator.comparison.jaiscript",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.jaiscript",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.bitwise.jaiscript",
          "match": "(<<|>>|~|\\^|&|\\|)"
        },
        {
          "name": "keyword.operator.increment.jaiscript",
          "match": "(\\+\\+|--)"
        },
        {
          "name": "keyword.operator.arithmetic.jaiscript",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.ternary.jaiscript",
          "match": "(\\?\\.|\\?|:)"
        },
        {
          "name": "keyword.operator.accessor.jaiscript",
          "match": "(->|::|\\.)"
        },
        {
          "name": "keyword.operator.assignment.jaiscript",
          "match": "="
        }
      ]
    },
    "identifiers": {
      "name": "variable.other.jaiscript",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    }
  }
}
