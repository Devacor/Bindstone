	if (st == 7 or st == 8) and (x ~= tx or y ~= ty) then return false end
	-- shopkeepers never step aside: route around them (and around everyone once stuck)
	local o = OCC[W_OFF[w] + y * W_W[w] + x] - 1
	if o >= 0 and (MOB_ROLE[o] >= 0 or BFS_AVOID_MOBS) and (x ~= tx or y ~= ty) then return false end
	return true
end

-- a route from the mobile toward (tx, ty) as a list of directions (0-based array, count);
-- `near` = stop when adjacent. empty = already there; {-1} = no route
local function bfs_path(m, tx, ty, near, maxn)
	local w = MOB_WORLD[m]
	local ww = W_W[w]
	local hh = W_H[w]
	local n = ww * hh
	while BFS_SEEN_N < n do BFS_SEEN[BFS_SEEN_N] = 0; BFS_FIRST[BFS_SEEN_N] = 0; BFS_SEEN_N = BFS_SEEN_N + 1 end
	BFS_STAMP = BFS_STAMP + 1
	local stamp = BFS_STAMP
	local sx = MOB_X[m]
	local sy = MOB_Y[m]
	local out = {}
	if (near and cheb(sx, sy, tx, ty) <= 1) or (sx == tx and sy == ty) then return out, 0 end
	local q = BFS_Q
	local qn = 1
	q[0] = sy * ww + sx
	BFS_SEEN[sy * ww + sx] = stamp
	BFS_FIRST[sy * ww + sx] = -1
	local head = 0
	local found = -1
	while head < qn and head < maxn and found < 0 do
		local cur = q[head]
		head = head + 1
		local cx = cur % ww
		local cy = cur // ww
		for d = 0, 7 do
			local ddx, ddy = DX[d], DY[d]
			local nx = cx + ddx
			local ny = cy + ddy
			if nx >= 0 and ny >= 0 and nx < ww and ny < hh then
				local ni = ny * ww + nx
				if BFS_SEEN[ni] ~= stamp and bot_walkable(w, nx, ny, tx, ty)
					and not (ddx ~= 0 and ddy ~= 0 and walk_at(w, cx + ddx, cy) == 0 and walk_at(w, cx, cy + ddy) == 0) then
					BFS_SEEN[ni] = stamp
					BFS_FIRST[ni] = cur * 8 + d           -- parent tile and the step that reached us
					if (nx == tx and ny == ty) or (near and cheb(nx, ny, tx, ty) <= 1) then found = ni; break end
					q[qn] = ni
					qn = qn + 1
				end
			end
		end
	end
	if found < 0 then out[0] = -1; return out, 1 end
	local on = 0
	local at = found
	local start = sy * ww + sx
	while at ~= start do
		local link = BFS_FIRST[at]
		out[on] = link % 8
		on = on + 1
		at = link // 8
	end
	areverse(out, on)
	return out, on
end

-- ------------------------------------------------------------ bot helpers ---
local function bot_roll(b, n) return hash3(TICK, b.slot * 97 + b.step, 12345) % imax(1, n) end

local function find_role_npc(w, role)
	for i = 0, MOB_N - 1 do
		if MOB_KIND[i] >= 0 and MOB_ROLE[i] == role and MOB_WORLD[i] == w then return i end
	end
	return -1
end

-- nearest tile in the mobile's world with this resource class (or station); -1, -1 when none
local function find_tile_near(m, res, station, maxr)
	local w = MOB_WORLD[m]
	local mx, my = MOB_X[m], MOB_Y[m]
	for r = 1, maxr do
		for dy = -r, r do
			for dx = -r, r do
				if iabs(dx) == r or iabs(dy) == r then
					local x = mx + dx
					local y = my + dy
					if in_world(w, x, y) then
						local td = TILES_DEF[tile_now(w, x, y)]
						if (res > 0 and td.res == res) or (station > 0 and td.station == station) then return x, y end
					end
				end
			end
		end
	end
	return -1, -1
end

-- walk toward a spot along a cached route; true once there (or adjacent when near)
local function bot_go(b, m, x, y, near)
	if (near and cheb(MOB_X[m], MOB_Y[m], x, y) <= 1) or (MOB_X[m] == x and MOB_Y[m] == y) then
		intent_move(b.slot, -1)
		return true
	end
	if TICK + 1 < MOB_NEXT[m] then return false end
	-- keep following the route while we are where it expects us to be
	local replan = b.path_w ~= MOB_WORLD[m] or b.path_tx ~= x or b.path_ty ~= y or b.path_i >= b.path_n
	if not replan and (MOB_X[m] ~= b.last_x or MOB_Y[m] ~= b.last_y) then replan = true end
	if not replan and b.stuck > 3 then replan = true end
	if b.stuck > 8 then
		-- still stuck after routing around everyone: shuffle sideways and try again
		intent_move(b.slot, bot_roll(b, 8))
		b.stuck = 0
		b.path = {}
		b.path_n = 0
		return false
	end
	if replan then
		BFS_AVOID_MOBS = b.stuck > 3
		b.path, b.path_n = bfs_path(m, x, y, near, 6000)
		BFS_AVOID_MOBS = false
		b.path_i = 0
		b.path_w = MOB_WORLD[m]
		b.path_tx = x
		b.path_ty = y
		if b.path_n == 0 then intent_move(b.slot, -1); return true end
		if b.path[0] < 0 then
			intent_move(b.slot, bot_roll(b, 8))
			b.path = {}
			b.path_n = 0
			b.stuck = b.stuck + 1
			return false
		end
	end
	local d = b.path[b.path_i]
	local nx = MOB_X[m] + DX[d]
	local ny = MOB_Y[m] + DY[d]
	intent_move(b.slot, d)
	-- where we will be after this step; if the step fails we notice next time
	if mob_can_enter(m, nx, ny) then
		b.last_x = nx
		b.last_y = ny
		b.path_i = b.path_i + 1
		b.stuck = 0
	else
		b.last_x = MOB_X[m]
		b.last_y = MOB_Y[m]
		b.stuck = b.stuck + 1
	end
	return false
end

local function bot_roll_static(o) return MOB_SER[o] % 3 end

local function bot_nearest_hostile(m, r, bosses)
	local w = MOB_WORLD[m]
	local mx, my = MOB_X[m], MOB_Y[m]
	local best = -1
	local bestd = r + 1
	for dy = -r, r do
		for dx = -r, r do
			local o = mob_at(w, mx + dx, my + dy)
			if not (o < 0 or not hostile(m, o) or not mob_alive(o))
				and not (not bosses and (bit32.band(MOB_FLAGS[o], MF_BOSS)) ~= 0)
				and not (mob_fac(o) == FAC_ANIMAL and bot_roll_static(o) ~= 0) then
				local d = cheb(0, 0, dx, dy)
				if d < bestd then bestd = d; best = o end
			end
		end
	end
	return best
end

local function nearest_ground_item(m, slot, r)
	local w = MOB_WORLD[m]
	local best = -1
	local bestd = r + 1
	for i = 0, GI_N - 1 do
		if not (GI_ITEM[i].base < 0 or GI_W[i] ~= w) and not (GI_OWNER[i] >= 0 and GI_OWNER[i] ~= slot) then
			local d = cheb(GI_X[i], GI_Y[i], MOB_X[m], MOB_Y[m])
			if d < bestd and is_land(w, GI_X[i], GI_Y[i]) or d < bestd and walk_at(w, GI_X[i], GI_Y[i]) == 2 then bestd = d; best = i end
		end
	end
	return best
end

local AF_N = alen(AF_NAME)
local function item_score(it)
	if it.base < 0 then return -1 end
	local d = ITEMS[it.base]
	local s = d.armor * 10 + (d.lo + d.hi) * 5 + it.bonus * 12 + it.rarity * 15
	for c = 0, AF_N - 1 do s = s + item_stat(it, c) end
	return s
end

-- equip anything strictly better (bots are shameless about it)
local function bot_gear_up(b)
	local c = CHARS[b.slot]
	for i = 0, alen(c.pack) - 1 do
		local it = c.pack[i]
		if item_equippable(it) then
			local d = ITEMS[it.base]
			local s = d.slot
			if not (d.kind == KIND_WEAPON and d.range > 1 and not pack_has(b.slot, I_ARROW, 5) and d.skill == SK_ARCHERY) then
				if item_score(it) > item_score(c.worn[s]) then
					intent_act(b.slot, "U" .. i)
					return true
				end
			end
		end
	end
	return false
end

local function pack_index_of(slot, base)
	local pack = CHARS[slot].pack
	for i = 0, alen(pack) - 1 do
		if pack[i].base == base then return i end
	end
	return -1
end

-- reflexes that beat any plan: ghosts go to the healer, hurt gators drink
local function bot_survive(b, m)
	local c = CHARS[b.slot]
	if mob_ghost(m) then
		intent_act(b.slot, "!")
		local healer = find_role_npc(MOB_WORLD[m], R_HEALER)
		if healer < 0 then healer = find_role_npc(MOB_WORLD[m], R_ORACLE) end
		if healer < 0 then
			-- no healer here: walk to the nearest gate home
			local g = gate_in(MOB_WORLD[m], 0)
			if g >= 0 then bot_go(b, m, GATE_X[g], GATE_Y[g], false) end
			return true
		end
		if bot_go(b, m, MOB_X[healer], MOB_Y[healer], true) then
			intent_move(b.slot, dir_of(MOB_X[healer] - MOB_X[m], MOB_Y[healer] - MOB_Y[m]))
		end
		return true
	end
	if MOB_HP[m] * 100 < MOB_HPMAX[m] * 40 then
		local p = pack_index_of(b.slot, I_HEAL)
		if p < 0 then p = pack_index_of(b.slot, I_MINORHEAL) end
		if p >= 0 and TICK % 5 == 0 then intent_act(b.slot, "U" .. p); return false end
		if c.action == 0 and pack_has(b.slot, I_BANDAGE, 1) and TICK % 7 == 0 then intent_act(b.slot, "N") end
		if c.spells[0] == 1 and MOB_MP[m] >= 4 and pack_has(b.slot, I_GARLIC, 1) and pack_has(b.slot, I_GINSENG, 1) and TICK % 9 == 0 then
			intent_act(b.slot, "C0")
		end
	end
	return false
end

local function bot_next_phase(b)
	b.step = b.step + 1
	b.phase = BOT_PLAN[b.step % BOT_PLAN_N]
	b.phase_t = TICK
	b.done = 0
	b.goal_w = -1
	b.kills_at = CHARS[b.slot].kills
	b.log = b.log .. BP_NAME[b.phase] .. " "
end

-- fight what is in front of us, pick up what is lying around; true = busy
local function bot_fight_and_loot(b, m, r)
	local t = bot_nearest_hostile(m, r, false)
	if t >= 0 then
		intent_act(b.slot, "A" .. MOB_SER[t])
		local rng = attack_range(m)
		local d = cheb(MOB_X[m], MOB_Y[m], MOB_X[t], MOB_Y[t])
		if d > rng or (d > 1 and not los(MOB_WORLD[m], MOB_X[m], MOB_Y[m], MOB_X[t], MOB_Y[t])) then bot_go(b, m, MOB_X[t], MOB_Y[t], true)
		elseif d <= 1 then intent_move(b.slot, dir_of(MOB_X[t] - MOB_X[m], MOB_Y[t] - MOB_Y[m]))
		else intent_move(b.slot, -1) end
		-- a spell now and then
		if CHARS[b.slot].spells[1] == 1 and MOB_MP[m] >= 8 and pack_has(b.slot, I_ASH, 2) and bot_roll(b, 6) == 0 then intent_act(b.slot, "C1") end
		return true
	end
	local gi = nearest_ground_item(m, b.slot, 7)
	if gi >= 0 then
		if cheb(GI_X[gi], GI_Y[gi], MOB_X[m], MOB_Y[m]) <= 1 then
			intent_move(b.slot, -1)
			intent_act(b.slot, "G")
		else
			bot_go(b, m, GI_X[gi], GI_Y[gi], false)
		end
		return true
	end
	return false
end

local function bot_wander(b, m, cx, cy, radius)
	if b.goal_w ~= MOB_WORLD[m] or cheb(MOB_X[m], MOB_Y[m], b.goal_x, b.goal_y) <= 1 or b.stuck > 20 then
		b.goal_w = MOB_WORLD[m]
		local rx = cx + bot_roll(b, radius * 2 + 1) - radius
		local ry = cy + bot_roll(b, radius * 2 + 1) - radius
		b.goal_x, b.goal_y = find_spot(MOB_WORLD[m], rx, ry, 5, LAND_MASK)
		b.stuck = 0
	end
	bot_go(b, m, b.goal_x, b.goal_y, false)
end

-- gather at the nearest tile of a resource class: walk up, face it, E, wait
local function bot_gather(b, m, res, times, tool)
	local c = CHARS[b.slot]
	if tool >= 0 and not pack_has(b.slot, tool, 1) then bot_next_phase(b); return end
	if b.done >= times or TICK - b.phase_t > 1200 then bot_next_phase(b); return end
	if c.action ~= 0 then intent_move(b.slot, -1); return end
	local px, py = find_tile_near(m, res, 0, 30)
	if px < 0 then bot_wander(b, m, MOB_X[m], MOB_Y[m], 12); return end
	if bot_go(b, m, px, py, true) then
		MOB_DIR[m] = dir_of(px - MOB_X[m], py - MOB_Y[m])
		intent_act(b.slot, "E")
		b.done = b.done + 1
	end
end

local function recipe_has_inputs(slot, r)
	local d = RECIPES[r]
	for k = 0, d.in_n - 1 do
		if not pack_has(slot, d.in_item[k], d.in_qty[k]) then return false end
	end
	return true
end

-- head for another world through the right gate (or the sewer stairs)
local function bot_go_world(b, m, dest)
	local w = MOB_WORLD[m]
	local g = gate_in(w, dest)
	if g < 0 then g = gate_in(w, 0) end
	if g < 0 then return end
	bot_go(b, m, GATE_X[g], GATE_Y[g], false)
end

local function bot_craft_at(b, m, station, output, times)
	if b.done >= times or TICK - b.phase_t > 900 then bot_next_phase(b); return end
	local c = CHARS[b.slot]
	if c.action ~= 0 then intent_move(b.slot, -1); return end
	local recipe = -1
	for r = 0, RECIPE_N - 1 do
		if ITEMS[RECIPES[r].out].name == output then recipe = r end
	end
	if recipe < 0 or not recipe_has_inputs(b.slot, recipe) then bot_next_phase(b); return end
	if MOB_WORLD[m] ~= 0 then bot_go_world(b, m, 0); return end
	local px, py = find_tile_near(m, 0, station, 40)
	if px < 0 then bot_go(b, m, W_ARRIVE_X[0], W_ARRIVE_Y[0], false); return end
	if bot_go(b, m, px, py, true) then
		intent_act(b.slot, "K" .. recipe)
		b.done = b.done + 1
	end
end

local function bot_talk_role(b, m, role)
	local npc = find_role_npc(0, role)
	if npc < 0 then b.done = b.done + 1; return end
	if MOB_WORLD[m] ~= 0 then bot_go_world(b, m, 0); return end
	if bot_go(b, m, MOB_X[npc], MOB_Y[npc], true) then
		intent_act(b.slot, "Q" .. MOB_SER[npc])
		b.done = b.done + 1
	end
end

local QUEST_ROLES
local WANT
local function bot_tick(b)
	if b.slot < 0 or b.slot >= CHAR_N or not CHARS[b.slot].active then return end
	local c = CHARS[b.slot]
	local m = c.mob
	if not mob_live(m) then return end
	if b.phase_t == 0 and b.step == 0 then b.phase = BOT_PLAN[0]; b.phase_t = TICK; b.log = BP_NAME[b.phase] .. " " end
	intent_move(b.slot, -1)
	if bot_survive(b, m) then return end
	if TICK % 25 == 0 and bot_gear_up(b) then return end
	local phase = b.phase
	if phase == BP_SHOP then
		local npc = find_role_npc(0, R_PROVISIONER)
		if npc < 0 or MOB_WORLD[m] ~= 0 then bot_next_phase(b); return end
		if bot_go(b, m, MOB_X[npc], MOB_Y[npc], true) then
			local stock = SHOPS[ROLES[R_PROVISIONER].shop]
			WANT = WANT or { [0] = I_PICKAXE, I_HATCHET, I_HAMMER }
			for k = 0, 2 do
				local idx = aindex_of(stock, WANT[k])
				if idx >= 0 and not pack_has(b.slot, WANT[k], 1) then intent_act(b.slot, "B" .. MOB_SER[npc] .. "," .. idx) end
			end
			bot_next_phase(b)
		end
		return
	end
	if phase == BP_QUEST or phase == BP_TURNIN then
		QUEST_ROLES = QUEST_ROLES or { [0] = R_MAYOR, R_CAPTAIN, R_PROVISIONER, R_FISHMONGER, R_WEAPONS, R_ORACLE }
		if b.done >= 6 or TICK - b.phase_t > 1500 then bot_next_phase(b); return end
		bot_talk_role(b, m, QUEST_ROLES[b.done])
		return
	end
	if phase == BP_HUNT then
		if TICK - b.phase_t > 700 then bot_next_phase(b); return end
		if MOB_WORLD[m] ~= 0 then bot_go_world(b, m, 0); return end
		if bot_fight_and_loot(b, m, 9) then return end
		bot_wander(b, m, W_ARRIVE_X[0] + 24, W_ARRIVE_Y[0] + 4, 14)
		return
	end
	if phase == BP_FISH then bot_gather(b, m, 4, 6, I_FISHPOLE); return end
	if phase == BP_MINE then bot_gather(b, m, 2, 4, I_PICKAXE); return end
	if phase == BP_CHOP then bot_gather(b, m, 1, 4, I_HATCHET); return end
	if phase == BP_SMELT then bot_craft_at(b, m, 1, "Iron Ingot", 5); return end
	if phase == BP_FORGE then bot_craft_at(b, m, 2, "Short Sword", 1); return end
	if phase == BP_COOK then bot_craft_at(b, m, 3, "Cooked Fish", 4); return end
	if phase == BP_SEWER or phase == BP_BAYOU then
		local dest = phase == BP_SEWER and W_SEWERS or 1
		if b.done == 0 then
			if MOB_WORLD[m] == dest then b.done = 1; b.phase_t = TICK; return end
			if TICK - b.phase_t > 1500 then bot_next_phase(b); return end
			bot_go_world(b, m, dest)
			return
		end
		if b.done == 1 then
			if TICK - b.phase_t > 800 or MOB_WORLD[m] ~= dest then b.done = 2; return end
			if bot_fight_and_loot(b, m, 9) then return end
			bot_wander(b, m, W_ARRIVE_X[dest] + 10, W_ARRIVE_Y[dest] + 6, 12)
			return
		end
		if MOB_WORLD[m] == 0 or TICK - b.phase_t > 2000 then bot_next_phase(b); return end
		bot_go_world(b, m, 0)
		return
	end
	bot_next_phase(b)
end

function bot_add(slot)
	local b = Bot()
	b.slot = slot
	BOTS[BOT_N] = b
	BOT_N = BOT_N + 1
	return BOT_N - 1
end

function bots_tick()
	for i = 0, BOT_N - 1 do bot_tick(BOTS[i]) end
end
end)()
end
-- gatorquest
-- Gator Quest (Lua port) - the headless smoke session of scripts/gatorquest.jai.
--
--   lua gatorquest.lua smoke [ticks N] [seed S] [bots K] [verbose]
--
-- Prints the same world line, per-bot summaries and STATE_HASH as
--   jaiscript scripts/gatorquest.jai -- smoke ticks N seed S bots K noroundtrip
-- The mid-run save/load round trip is not ported: the port always runs as `noroundtrip`.
-- Requires Lua 5.4+ (64-bit integers, integer division and bitwise operators).


local ARGS = {}
for i = 1, #ARGV do ARGS[i - 1] = ARGV[i] end
local NARGS = #ARGV

local function arg_value(key, def)
	for i = 0, NARGS - 2 do
		if ARGS[i] == key then return ARGS[i + 1] end
	end
	return def
end

local function arg_flag(key)
	for i = 0, NARGS - 1 do
		if ARGS[i] == key then return true end
	end
	return false
end

local function print_char_summary(slot)
	local c = CHARS[slot]
	local m = c.mob
	local where = mob_live(m) and (WORLDS[MOB_WORLD[m]].name .. " (" .. MOB_X[m] .. "," .. MOB_Y[m] .. ")") or "nowhere"
	print("  " .. c.name .. " " .. player_title(slot) .. " | hp " .. MOB_HP[m] .. "/" .. MOB_HPMAX[m] .. " gold " .. c.gold
		.. " fame " .. c.fame .. " kills " .. c.kills .. " deaths " .. c.deaths .. " | " .. where)
	local skills = ""
	for k = 0, alen(c.skill) - 1 do
		if c.skill[k] > 0 then skills = skills .. SKILL_KEY[k] .. " " .. tenths(c.skill[k]) .. "  " end
	end
	print("  skills: " .. skills)
	local pack = ""
	for k = 0, alen(c.pack) - 1 do pack = pack .. item_name(c.pack[k]) .. ", " end
	print("  pack: " .. pack)
	local worn = ""
	for k = 0, alen(c.worn) - 1 do
		if c.worn[k].base >= 0 then worn = worn .. SLOT_NAME[k] .. "=" .. item_name(c.worn[k]) .. ", " end
	end
	print("  worn: " .. worn)
	local j, jn = journal_lines(slot)
	for k = 0, jn - 1 do print("  journal: " .. j[k]) end
end

local function run_smoke()
	local ticks = to_int(arg_value("ticks", "3000"), 3000)
	local seed = to_int(arg_value("seed", "1"), 1)
	local bots = to_int(arg_value("bots", "2"), 2)
	local verbose = arg_flag("verbose")
	local t0 = os.clock()
	sim_init(seed)
	local t1 = os.clock()
	local gen_ms = math.floor((t1 - t0) * 1000)
	print("world: seed " .. seed .. ", " .. TILE_N .. " tiles in " .. WORLD_COUNT .. " realms, " .. MOB_LIVE .. " mobiles, "
		.. SP_N .. " spawners, " .. GATE_N .. " gates (gen " .. gen_ms .. " ms)")
	aclear(BOTS)
	BOT_N = 0
	local names = { [0] = "Chomps", "Snappy", "Gumbo", "Bayou Bill" }
	for b = 0, bots - 1 do
		player_create(b, names[b % 4], b)
		bot_add(b)
	end
	local logs = 0
	for _ = 0, ticks - 1 do
		bots_tick()
		sim_tick()
		if verbose then
			for e = 0, EV_N - 1 do
				if EV_KIND[e] == Ev.log and logs < 4000 then
					logs = logs + 1
					print("[" .. TICK .. "] " .. (EV_TO[e] >= 0 and CHARS[EV_TO[e]].name or "near") .. ": " .. EV_TEXT[e])
				end
			end
		end
	end
	local run_us = math.floor((os.clock() - t1) * 1000000)
	print("ran " .. ticks .. " ticks in " .. run_us // 1000 .. " ms (" .. run_us // imax(1, ticks) .. " us/tick), "
		.. MOB_LIVE .. " mobiles alive, kills " .. STAT_KILLS .. ", spawns " .. STAT_SPAWNS)
	for b = 0, bots - 1 do
		print_char_summary(b)
		print("  plan: " .. BOTS[b].log)
	end
	print("STATE_HASH: " .. state_hash())
	return 0
end

if arg_flag("smoke") then
	return run_smoke()   -- close the state: finalizers run (LuaJIT -jp reports at close)
end
error("usage: luau gatorquest.luau -a smoke [ticks N] [seed S] [bots K] [verbose]", 0)
