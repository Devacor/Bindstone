	local v = dsl_get(parts, n, key, "")
	if v == "" then return lo, hi end
	local ab, abn = split(v, "-")
	if abn < 2 then
		local x = to_int(v, lo)
		return x, x
	end
	return to_int(ab[0], lo), to_int(ab[1], hi)
end

function index_of_name(names, n, def)
	for i = 0, alen(names) - 1 do
		if names[i] == n then return i end
	end
	return def
end
