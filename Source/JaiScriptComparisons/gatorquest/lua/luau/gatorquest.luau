	item_stat = exports.item_stat
	item_value = exports.item_value
	item_equippable = exports.item_equippable
	item_stacks = exports.item_stacks
	roll_rarity = exports.roll_rarity
	roll_affix = exports.roll_affix
	roll_mag = exports.roll_mag
	roll_equipment = exports.roll_equipment
	roll_consumable = exports.roll_consumable
	pack_count = exports.pack_count
	pack_has = exports.pack_has
	pack_add = exports.pack_add
	pack_take = exports.pack_take
	pack_take_at = exports.pack_take_at
	player_bonus = exports.player_bonus
	player_armor = exports.player_armor
