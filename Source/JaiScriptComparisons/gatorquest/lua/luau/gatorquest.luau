local CHARS, MONS, MON_AI = CHARS, MONS, MON_AI
local MOB_KIND, MOB_WORLD, MOB_X, MOB_Y, MOB_DIR, MOB_HP, MOB_HPMAX = MOB_KIND, MOB_WORLD, MOB_X, MOB_Y, MOB_DIR, MOB_HP, MOB_HPMAX
local MOB_TARGET, MOB_AI, MOB_NEXT, MOB_ATK, MOB_CAST, MOB_FLAGS, MOB_PLAYER = MOB_TARGET, MOB_AI, MOB_NEXT, MOB_ATK, MOB_CAST, MOB_FLAGS, MOB_PLAYER
local MOB_HOMEX, MOB_HOMEY, MOB_OWNER, MOB_AUX, MOB_ROLE = MOB_HOMEX, MOB_HOMEY, MOB_OWNER, MOB_AUX, MOB_ROLE
local DX, DY = DX, DY
local imin, imax, cheb, dir_of, rnd = imin, imax, cheb, dir_of, rnd
local walk_at, say_to, say_near, fx_at, sound_at, shake, cap_first = walk_at, say_to, say_near, fx_at, sound_at, shake, cap_first
local mob_live, mob_alive, mob_fac, mob_the, mob_at, mob_spawn, mob_free, mob_place = mob_live, mob_alive, mob_fac, mob_the, mob_at, mob_spawn, mob_free, mob_place
local mob_step, mob_step_toward, mob_step_away, los, nearest_player, find_free_spot, player_near =
	mob_step, mob_step_toward, mob_step_away, los, nearest_player, find_free_spot, player_near
local hostile, deal, attack = hostile, deal, attack
local MF_HIDDEN, MF_SUMMON, MF_ALERT, MF_FLEEING = MF_HIDDEN, MF_SUMMON, MF_ALERT, MF_FLEEING
local FAC_GUARD, FAC_MONSTER = Fac.guard, Fac.monster
local AI_MELEE, AI_PACK, AI_RANGED, AI_CASTER, AI_COWARD, AI_THIEF, AI_AMBUSH, AI_BOSS, AI_CRITTER, AI_WANDER, AI_GUARD, AI_SUMMON =
	Ai.melee, Ai.pack, Ai.ranged, Ai.caster, Ai.coward, Ai.thief, Ai.ambush, Ai.boss, Ai.critter, Ai.wander, Ai.guard, Ai.summon
local FX_SPLASH, FX_MAGIC, FX_FIRE, FX_DUST, FX_SMOKE = Fx.splash, Fx.magic, Fx.fire, Fx.dust, Fx.smoke
local DMG_PHYS = DMG_PHYS

AGGRO = 7
LEASH = 22
local AGGRO, LEASH = AGGRO, LEASH

-- best hostile target for m within r tiles it can see
local function find_target(m, r)
	local w = MOB_WORLD[m]
	local x = MOB_X[m]
	local y = MOB_Y[m]
	local best = -1
	local bestd = 999
	-- players (and their summons) are the usual prey
	for s = 0, CHAR_N - 1 do
		local c = CHARS[s]
		if c.active then
			local p = c.mob
			if mob_alive(p) and MOB_WORLD[p] == w then
				local reach = (bit32.band(MOB_FLAGS[p], MF_HIDDEN)) ~= 0 and 2 or r
				local d = cheb(x, y, MOB_X[p], MOB_Y[p])
				if not (d > reach or d >= bestd or not hostile(m, p)) and los(w, x, y, MOB_X[p], MOB_Y[p]) then
					best = p
					bestd = d
				end
			end
		end
	end
	-- guards and summons also hunt monsters, monsters also fight summons
	local fac = mob_fac(m)
	if fac == FAC_GUARD or (bit32.band(MOB_FLAGS[m], MF_SUMMON)) ~= 0 or fac == FAC_MONSTER then
		for dy = -r, r do
			for dx = -r, r do
				local o = mob_at(w, x + dx, y + dy)
				if not (o < 0 or o == m or MOB_PLAYER[o] >= 0) then
					local d = cheb(0, 0, dx, dy)
					if not (d >= bestd or not hostile(m, o)) then
						if not (fac == FAC_MONSTER and (bit32.band(MOB_FLAGS[o], MF_SUMMON)) == 0 and mob_fac(o) ~= FAC_GUARD) then
							best = o
							bestd = d
						end
					end
				end
			end
		end
	end
	return best
end

local function target_ok(m)
	local t = MOB_TARGET[m]
	if not mob_alive(t) or MOB_WORLD[t] ~= MOB_WORLD[m] then return false end
	if not hostile(m, t) then return false end
	return cheb(MOB_X[m], MOB_Y[m], MOB_X[t], MOB_Y[t]) <= LEASH
end

local function think_later(m, ticks) MOB_NEXT[m] = TICK + imax(1, ticks) end

-- the melee core: close in, swing when adjacent and ready
local function chase_and_swing(m, t)
	local d = cheb(MOB_X[m], MOB_Y[m], MOB_X[t], MOB_Y[t])
	if d <= 1 then
		if TICK >= MOB_ATK[m] then attack(m, t) end
		think_later(m, 2)
		return
	end
	if not mob_step_toward(m, MOB_X[t], MOB_Y[t]) then think_later(m, 3) end
end

local function wander(m, radius)
	if rnd(3) ~= 0 then think_later(m, 6 + rnd(10)); return end
	local hx = MOB_HOMEX[m]
	local hy = MOB_HOMEY[m]
	if cheb(MOB_X[m], MOB_Y[m], hx, hy) > radius then
		if not mob_step_toward(m, hx, hy) then think_later(m, 5) end
		return
	end
	if not mob_step(m, rnd(8)) then think_later(m, 4) end
end

local function go_home_or_wander(m)
	if cheb(MOB_X[m], MOB_Y[m], MOB_HOMEX[m], MOB_HOMEY[m]) > 8 then
		if not mob_step_toward(m, MOB_HOMEX[m], MOB_HOMEY[m]) then think_later(m, 4) end
		return
	end
	wander(m, 6)
end

local function alert_pack(m, t)
	local w = MOB_WORLD[m]
	local kind = MOB_KIND[m]
	for dy = -6, 6 do
		for dx = -6, 6 do
			local o = mob_at(w, MOB_X[m] + dx, MOB_Y[m] + dy)
			if o >= 0 and o ~= m and MOB_KIND[o] == kind and MOB_TARGET[o] < 0 then
				MOB_TARGET[o] = t
				MOB_FLAGS[o] = bit32.bor(MOB_FLAGS[o], MF_ALERT)
			end
		end
	end
end

-- acquire or keep a target; -1 = nothing to fight
local function engage(m, r)
	if target_ok(m) then return MOB_TARGET[m] end
	MOB_TARGET[m] = -1
	local t = find_target(m, r)
	if t >= 0 then
		MOB_TARGET[m] = t
		MOB_FLAGS[m] = bit32.bor(MOB_FLAGS[m], MF_ALERT)
		local md = MONS[MOB_KIND[m]]
		local quip = md.quip
		if quip ~= "" and rnd(3) == 0 then say_near(MOB_WORLD[m], MOB_X[m], MOB_Y[m], cap_first(mob_the(m)) .. ": \"" .. quip .. "\"", C_ORANGE) end
		local snd = md.snd
		if snd ~= "" then sound_at(MOB_WORLD[m], MOB_X[m], MOB_Y[m], snd) end
		if MON_AI[MOB_KIND[m]] == AI_PACK then alert_pack(m, t) end
	end
	return t
end

local function ai_melee(m)
	local t = engage(m, AGGRO)
	if t < 0 then go_home_or_wander(m); return end
	chase_and_swing(m, t)
end

-- archers keep their distance: 3..range
local function ai_ranged(m)
	local t = engage(m, AGGRO + 1)
	if t < 0 then go_home_or_wander(m); return end
	local d = cheb(MOB_X[m], MOB_Y[m], MOB_X[t], MOB_Y[t])
	local rng = MONS[MOB_KIND[m]].range
	local sight = los(MOB_WORLD[m], MOB_X[m], MOB_Y[m], MOB_X[t], MOB_Y[t])
	if d < 3 and rnd(3) ~= 0 then
		if mob_step_away(m, MOB_X[t], MOB_Y[t]) then return end
	end
	if d <= rng and sight then
		if TICK >= MOB_ATK[m] then attack(m, t) end
		think_later(m, 3)
		return
	end
	if not mob_step_toward(m, MOB_X[t], MOB_Y[t]) then think_later(m, 3) end
end

-- casters open with spells from range, then keep a respectful distance
local function ai_caster(m, coward)
	local t = engage(m, AGGRO + 1)
	if t < 0 then go_home_or_wander(m); return end
	local d = cheb(MOB_X[m], MOB_Y[m], MOB_X[t], MOB_Y[t])
	if coward and MOB_HP[m] * 10 < MOB_HPMAX[m] * 4 and rnd(4) ~= 0 then
		MOB_FLAGS[m] = bit32.bor(MOB_FLAGS[m], MF_FLEEING)
		if mob_step_away(m, MOB_X[t], MOB_Y[t]) then return end
	end
	local spell = MONS[MOB_KIND[m]].spell
	local sight = los(MOB_WORLD[m], MOB_X[m], MOB_Y[m], MOB_X[t], MOB_Y[t])
	if spell >= 0 and TICK >= MOB_CAST[m] and d <= 7 and sight then
		mob_cast(m, spell, t)
		MOB_CAST[m] = TICK + 30 + rnd(30)
		think_later(m, 6)
		return
	end
	if d < 3 then
		if d <= 1 and TICK >= MOB_ATK[m] and not coward then attack(m, t); think_later(m, 3); return end
		if mob_step_away(m, MOB_X[t], MOB_Y[t]) then return end
	end
	if d > 5 or not sight then
		if not mob_step_toward(m, MOB_X[t], MOB_Y[t]) then think_later(m, 3) end
		return
	end
	-- strafe a little so they are not sitting ducks
	if rnd(2) == 0 and mob_step(m, rnd(8)) then return end
	think_later(m, 3)
end

-- raccoons: grab gold, run off laughing
local function ai_thief(m)
	if (bit32.band(MOB_FLAGS[m], MF_FLEEING)) ~= 0 then
		local p = nearest_player(MOB_WORLD[m], MOB_X[m], MOB_Y[m], 12)
		if p < 0 or MOB_AUX[m] == 0 and rnd(20) == 0 then MOB_FLAGS[m] = bit32.band(MOB_FLAGS[m], bit32.bnot(MF_FLEEING)); think_later(m, 5); return end
		if mob_step_away(m, MOB_X[p], MOB_Y[p]) then MOB_NEXT[m] = MOB_NEXT[m] + 1
		else think_later(m, 2) end
		return
	end
	local t = engage(m, AGGRO)
	if t < 0 then go_home_or_wander(m); return end
	local d = cheb(MOB_X[m], MOB_Y[m], MOB_X[t], MOB_Y[t])
	if d <= 1 and TICK >= MOB_ATK[m] then
		local slot = MOB_PLAYER[t]
		if slot >= 0 and CHARS[slot].gold > 0 and rnd(4) == 0 then
			local c = CHARS[slot]
			local grab = imin(c.gold, 3 + rnd(8))
			c.gold = c.gold - grab
			c.version = c.version + 1
			MOB_AUX[m] = MOB_AUX[m] + grab
			say_to(slot, cap_first(mob_the(m)) .. " swipes " .. grab .. " gold and scampers off! \"Yoink!\"", C_ORANGE)
			sound_at(MOB_WORLD[m], MOB_X[m], MOB_Y[m], "coin")
			MOB_FLAGS[m] = bit32.bor(MOB_FLAGS[m], MF_FLEEING)
			MOB_ATK[m] = TICK + 12
			think_later(m, 1)
			return
		end
		attack(m, t)
		think_later(m, 2)
		return
	end
	if not mob_step_toward(m, MOB_X[t], MOB_Y[t]) then think_later(m, 3) end
end

local function ai_ambush(m)
	if MOB_TARGET[m] < 0 and (bit32.band(MOB_FLAGS[m], MF_ALERT)) == 0 then
		MOB_FLAGS[m] = bit32.bor(MOB_FLAGS[m], MF_HIDDEN)
		local p = nearest_player(MOB_WORLD[m], MOB_X[m], MOB_Y[m], 2)
		if p >= 0 and hostile(m, p) then
			MOB_FLAGS[m] = bit32.band((bit32.bor(MOB_FLAGS[m], MF_ALERT)), bit32.bnot(MF_HIDDEN))
			MOB_TARGET[m] = p
			say_near(MOB_WORLD[m], MOB_X[m], MOB_Y[m], cap_first(mob_the(m)) .. " erupts from the murk!", C_RED)
			fx_at(MOB_WORLD[m], MOB_X[m], MOB_Y[m], FX_SPLASH, 14)
			sound_at(MOB_WORLD[m], MOB_X[m], MOB_Y[m], "splash")
			shake(MOB_PLAYER[p], 4)
		end
		think_later(m, 4)
		return
	end
	ai_melee(m)
end

local function ai_critter(m)
	local p = nearest_player(MOB_WORLD[m], MOB_X[m], MOB_Y[m], 3)
	if p >= 0 or MOB_HP[m] < MOB_HPMAX[m] then
		if p >= 0 and mob_step_away(m, MOB_X[p], MOB_Y[p]) then return end
	end
	wander(m, 6)
end

local function ai_wander_npc(m)
	if MOB_AI[m] == 1 then
		-- shopkeepers face whoever comes near and otherwise mind the counter
		local p = nearest_player(MOB_WORLD[m], MOB_X[m], MOB_Y[m], 4)
		if p >= 0 then MOB_DIR[m] = dir_of(MOB_X[p] - MOB_X[m], MOB_Y[p] - MOB_Y[m]) end
		think_later(m, 10)
		return
	end
	wander(m, 5)
end

local function ai_guard(m)
	local t = engage(m, 10)
	if t < 0 then
		if cheb(MOB_X[m], MOB_Y[m], MOB_HOMEX[m], MOB_HOMEY[m]) > 2 then
			if not mob_step_toward(m, MOB_HOMEX[m], MOB_HOMEY[m]) then think_later(m, 5) end
			return
		end
		think_later(m, 8)
		return
	end
	chase_and_swing(m, t)
end

local function ai_summon(m)
	local owner = MOB_OWNER[m]
	if not mob_alive(owner) or TICK >= MOB_AUX[m] then
		fx_at(MOB_WORLD[m], MOB_X[m], MOB_Y[m], FX_MAGIC, 8)
		say_near(MOB_WORLD[m], MOB_X[m], MOB_Y[m], "The frog familiar croaks farewell and vanishes.", C_GREEN)
		mob_free(m)
		return
	end
	local t = MOB_TARGET[m]
	local ot = MOB_TARGET[owner]
	if mob_alive(ot) and hostile(m, ot) then t = ot; MOB_TARGET[m] = ot end
	if not target_ok(m) then t = find_target(m, 6); MOB_TARGET[m] = t end
	if t >= 0 then chase_and_swing(m, t); return end
	if cheb(MOB_X[m], MOB_Y[m], MOB_X[owner], MOB_Y[owner]) > 2 then
		if MOB_WORLD[m] ~= MOB_WORLD[owner] or cheb(MOB_X[m], MOB_Y[m], MOB_X[owner], MOB_Y[owner]) > 14 then
			local px, py = find_free_spot(MOB_WORLD[owner], MOB_X[owner], MOB_Y[owner] + 1, 3, LAND_MASK + 4)
			mob_place(m, MOB_WORLD[owner], px, py)
			return
		end
		if not mob_step_toward(m, MOB_X[owner], MOB_Y[owner]) then think_later(m, 3) end
		return
	end
	think_later(m, 4)
end

-- bosses: a caster-brawler with an enrage, summoned adds and a telegraphed stomp
local function ai_boss(m)
	local t = engage(m, AGGRO + 3)
	local kind = MOB_KIND[m]
	local md = MONS[kind]
	local w = MOB_WORLD[m]
	if t < 0 then
		if MOB_HP[m] < MOB_HPMAX[m] and TICK % 5 == 0 then MOB_HP[m] = imin(MOB_HPMAX[m], MOB_HP[m] + MOB_HPMAX[m] // 50) end
		go_home_or_wander(m)
		return
	end
	if MOB_AUX[m] == 0 and MOB_HP[m] * 2 < MOB_HPMAX[m] then
		MOB_AUX[m] = 1
		say_near(w, MOB_X[m], MOB_Y[m], md.name .. " flies into a RAGE!", C_RED)
		sound_at(w, MOB_X[m], MOB_Y[m], "roar")
		fx_at(w, MOB_X[m], MOB_Y[m], FX_FIRE, 20)
		for s = 0, CHAR_N - 1 do
			local p = CHARS[s].mob
			if CHARS[s].active and mob_live(p) and MOB_WORLD[p] == w and cheb(MOB_X[p], MOB_Y[p], MOB_X[m], MOB_Y[m]) < 12 then shake(s, 6) end
		end
	end
	local enraged = MOB_AUX[m] ~= 0
	-- the stomp: telegraphed one think ahead with a log line
	if MOB_ROLE[m] == -2 then
		MOB_ROLE[m] = -1
		fx_at(w, MOB_X[m], MOB_Y[m], FX_DUST, 26)
		sound_at(w, MOB_X[m], MOB_Y[m], "boom")
		for s = 0, CHAR_N - 1 do
			local p = CHARS[s].mob
			if CHARS[s].active and mob_alive(p) and MOB_WORLD[p] == w and cheb(MOB_X[p], MOB_Y[p], MOB_X[m], MOB_Y[m]) <= 2 then
				deal(p, md.lo + rnd(md.hi - md.lo + 1), m, DMG_PHYS, false)
				shake(s, 8)
			end
		end
		think_later(m, 4)
		return
	end
	if TICK % 90 < 3 and cheb(MOB_X[m], MOB_Y[m], MOB_X[t], MOB_Y[t]) <= 2 then
		MOB_ROLE[m] = -2
		say_near(w, MOB_X[m], MOB_Y[m], md.name .. " rears up for a crushing stomp!", C_YELLOW)
		think_later(m, 6)
		return
	end
	-- adds
	if md.summon >= 0 and TICK >= MOB_CAST[m] - 10 and TICK % 150 < 4 then
		local adds = 0
		for i = 0, MOB_N - 1 do
			if MOB_KIND[i] == md.summon and MOB_OWNER[i] == m then adds = adds + 1 end
		end
		if adds < 5 then
			for _ = 0, 1 do
				local dir = rnd(8)
				local nx = MOB_X[m] + DX[dir] * 2
				local ny = MOB_Y[m] + DY[dir] * 2
				local kk = walk_at(w, nx, ny)
				if mob_at(w, nx, ny) < 0 and kk ~= 0 and kk ~= 3 then
					local a = mob_spawn(md.summon, w, nx, ny)
					MOB_OWNER[a] = m
					MOB_TARGET[a] = t
					fx_at(w, nx, ny, FX_SMOKE, 8)
				end
			end
			say_near(w, MOB_X[m], MOB_Y[m], md.name .. " calls for help!", C_ORANGE)
		end
	end
	local d = cheb(MOB_X[m], MOB_Y[m], MOB_X[t], MOB_Y[t])
	if md.spell >= 0 and TICK >= MOB_CAST[m] and d >= 2 and d <= 8 and los(w, MOB_X[m], MOB_Y[m], MOB_X[t], MOB_Y[t]) then
		mob_cast(m, md.spell, t)
		MOB_CAST[m] = TICK + (enraged and 25 or 45)
		think_later(m, 5)
		return
	end
	if d <= 1 then
		if TICK >= MOB_ATK[m] then
			attack(m, t)
			if enraged then MOB_ATK[m] = MOB_ATK[m] - 2 end
		end
		think_later(m, 2)
		return
	end
	if not mob_step_toward(m, MOB_X[t], MOB_Y[t]) then think_later(m, 2)
	elseif enraged then MOB_NEXT[m] = MOB_NEXT[m] - 1 end
end

function ai_tick()
	local n = MOB_N
	local tick = TICK
	for m = 0, n - 1 do
		local kind = MOB_KIND[m]
		if not (kind < 0 or MOB_PLAYER[m] >= 0 or MOB_HP[m] <= 0 or tick < MOB_NEXT[m]) then
			local ai = MON_AI[kind]
			if ai ~= AI_SUMMON and not player_near(MOB_WORLD[m], MOB_X[m], MOB_Y[m], 24) then
				MOB_NEXT[m] = tick + 15
			else
				MOB_NEXT[m] = tick + 1
				if ai == AI_MELEE or ai == AI_PACK then ai_melee(m)
				elseif ai == AI_RANGED then ai_ranged(m)
				elseif ai == AI_CASTER then ai_caster(m, false)
				elseif ai == AI_COWARD then ai_caster(m, true)
				elseif ai == AI_THIEF then ai_thief(m)
				elseif ai == AI_AMBUSH then ai_ambush(m)
				elseif ai == AI_BOSS then ai_boss(m)
				elseif ai == AI_CRITTER then ai_critter(m)
				elseif ai == AI_WANDER then ai_wander_npc(m)
				elseif ai == AI_GUARD then ai_guard(m)
				elseif ai == AI_SUMMON then ai_summon(m)
				else think_later(m, 10) end
			end
		end
	end
end

return { find_target = find_target, target_ok = target_ok, think_later = think_later, chase_and_swing = chase_and_swing,
	wander = wander, go_home_or_wander = go_home_or_wander, alert_pack = alert_pack, engage = engage }
end)()
	find_target = exports.find_target
	target_ok = exports.target_ok
	think_later = exports.think_later
	chase_and_swing = exports.chase_and_swing
	wander = exports.wander
	go_home_or_wander = exports.go_home_or_wander
	alert_pack = exports.alert_pack
	engage = exports.engage
end
