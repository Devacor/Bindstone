local idiv, iabs, imin, imax, rnd, rnd_range = idiv, iabs, imin, imax, rnd, rnd_range
local in_world, walk_at, find_spot, ev, say_to, mob_live = in_world, walk_at, find_spot, ev, say_to, mob_live
local alen, apush, aremove = alen, apush, aremove
local Item, copy_item = Item, copy_item
local KIND_WEAPON, KIND_GOLD, KIND_TRINKET, KIND_SCROLL = Kind.weapon, Kind.gold, Kind.trinket, Kind.scroll
local SLOT_WEAPON = Slot.weapon
local FAC_MONSTER = Fac.monster
local EV_FX, EV_SPAWN, FX_LOOT = Ev.fx, Ev.spawn, Fx.loot
local MF_ELITE = MF_ELITE

PACK_MAX = 40
local PACK_MAX = PACK_MAX

local function make_item(base, qty)
	local it = Item(base, qty)
	it.rarity = ITEMS[base].rarity
	it.ser = NEXT_SER
	NEXT_SER = NEXT_SER + 1
	return it
end

local function item_base_name(it)
	local n = ITEMS[it.base].name
	if it.prefix >= 0 then n = AFFIXES[it.prefix].name .. " " .. n end
	if it.suffix >= 0 then n = n .. " " .. AFFIXES[it.suffix].name end
	return n
end

local function item_name(it)
	if it.base < 0 then return "nothing" end
	local n = item_base_name(it)
	local d = ITEMS[it.base]
	if it.bonus > 0 and (d.kind == KIND_WEAPON or d.slot >= 0) then n = n .. " +" .. it.bonus end
	if it.qty > 1 or d.kind == KIND_GOLD then n = it.qty .. " " .. n end
	return n
end

-- sum of one affix code on an item (fixed legendary affixes, prefix, suffix)
local function item_stat(it, code)
	if it.base < 0 then return 0 end
	local v = 0
	local d = ITEMS[it.base]
	local ac, av = d.aff_code, d.aff_val
	for k = 0, d.aff_n - 1 do
		if ac[k] == code then v = v + av[k] end
	end
	if it.prefix >= 0 and AFFIXES[it.prefix].code == code then v = v + it.pmag end
	if it.suffix >= 0 and AFFIXES[it.suffix].code == code then v = v + it.smag end
	return v
end

local function item_value(it)
	if it.base < 0 then return 0 end
	local v = ITEMS[it.base].value
	if it.prefix >= 0 then v = v + 20 + iabs(it.pmag) * 6 end
	if it.suffix >= 0 then v = v + 20 + iabs(it.smag) * 6 end
	v = idiv(v * (100 + it.rarity * 60), 100) + it.bonus * 15
	if it.prefix >= 0 and AFFIXES[it.prefix].name == "Soggy" then v = idiv(v, 4) end
	return imax(1, v)
end

local function item_equippable(it) return it.base >= 0 and ITEMS[it.base].slot >= 0 end
local function item_stacks(base) return ITEMS[base].stack end

-- ---- random magic items
local function roll_rarity(luck, floor_rarity)
	local r = rnd(1000) - luck * 2
	local rar = 0
	if r < 4 then rar = 3
	elseif r < 30 then rar = 2
	elseif r < 180 then rar = 1 end
	return imax(rar, floor_rarity)
end

local function roll_affix(prefix, weapon, tier)
	local fits, n = {}, 0
	for i = 0, AFFIX_N - 1 do
		local a = AFFIXES[i]
		if not (a.prefix ~= prefix or a.tier > tier + 1) and not (a.applies == 1 and not weapon) and not (a.applies == 2 and weapon) then
			fits[n] = i
			n = n + 1
		end
	end
	if n == 0 then return -1 end
	return fits[rnd(n)]
end

local function roll_mag(affix, rarity)
	local a = AFFIXES[affix]
	local v = rnd_range(a.lo, a.hi)
	if rarity >= 3 then v = a.hi + idiv(a.hi - a.lo, 2) end
	return v
end

-- a random weapon/armor/jewelry piece of about this tier
local function roll_equipment(tier, luck, floor_rarity)
	local pool, n = {}, 0
	for i = 0, ITEM_N - 1 do
		local d = ITEMS[i]
		if not (d.slot < 0 or d.rarity ~= 0 or d.kind == KIND_TRINKET) and not (d.tier > tier or d.tier < tier - 2) then
			pool[n] = i
			n = n + 1
		end
	end
	if n == 0 then return make_item(I_DAGGER, 1) end
	local it = make_item(pool[rnd(n)], 1)
	local rar = roll_rarity(luck, floor_rarity)
	it.rarity = rar
	local weapon = ITEMS[it.base].kind == KIND_WEAPON
	if rar == 1 then
		if rnd(2) == 0 then it.prefix = roll_affix(true, weapon, tier)
		else it.suffix = roll_affix(false, weapon, tier) end
	elseif rar >= 2 then
		it.prefix = roll_affix(true, weapon, tier)
		it.suffix = roll_affix(false, weapon, tier)
	end
	if it.prefix >= 0 then it.pmag = roll_mag(it.prefix, rar) end
	if it.suffix >= 0 then it.smag = roll_mag(it.suffix, rar) end
	if rar >= 3 then it.bonus = 1 + rnd(3) end
	return it
end

-- consumables and bits for loot tables
local function roll_consumable(tier)
	local r = rnd(100)
	if r < 35 then
		local base = REAGENTS[rnd(alen(REAGENTS))]
		return make_item(base, 1 + rnd(3))
	end
	if r < 60 then return make_item(tier >= 3 and I_HEAL or I_MINORHEAL, 1) end
	if r < 70 then return make_item(I_MANA, 1) end
	if r < 78 then return make_item(I_BANDAGE, 2 + rnd(4)) end
	if r < 86 then return make_item(I_ARROW, 5 + rnd(10)) end
	-- a spell scroll of a circle the tier can carry
	local scrolls, n = {}, 0
	for i = 0, ITEM_N - 1 do
		local d = ITEMS[i]
		if d.kind == KIND_SCROLL and d.eff == 10 and SPELLS[d.pow].circle <= tier + 1 then
			scrolls[n] = i
			n = n + 1
		end
	end
	if n == 0 then return make_item(I_MINORHEAL, 1) end
	return make_item(scrolls[rnd(n)], 1)
end

-- ---- backpack
local function pack_count(slot, base)
	local n = 0
	local pack = CHARS[slot].pack
	for i = 0, alen(pack) - 1 do
		local it = pack[i]
		if it.base == base then n = n + it.qty end
	end
	return n
end

local function pack_has(slot, base, qty) return pack_count(slot, base) >= qty end

-- add to the backpack; stacks merge. false = no room
local function pack_add(slot, it)
	local c = CHARS[slot]
	if ITEMS[it.base].kind == KIND_GOLD then
		c.gold = c.gold + it.qty
		c.version = c.version + 1
		return true
	end
	local pack = c.pack
	local n = alen(pack)
	if ITEMS[it.base].stack then
		for i = 0, n - 1 do
			local p = pack[i]
			if p.base == it.base and p.prefix < 0 and p.suffix < 0 then
				p.qty = p.qty + it.qty
				c.version = c.version + 1
				return true
			end
		end
	end
	if n >= PACK_MAX then return false end
	pack[n] = copy_item(it)
	c.version = c.version + 1
	return true
end

local function pack_take(slot, base, qty)
	if not pack_has(slot, base, qty) then return false end
	local c = CHARS[slot]
	local pack = c.pack
	local left = qty
	local i = alen(pack) - 1
	while i >= 0 and left > 0 do
		local p = pack[i]
		if p.base == base then
			local take = imin(left, p.qty)
			p.qty = p.qty - take
			left = left - take
			if p.qty <= 0 then aremove(pack, i) end
		end
		i = i - 1
	end
	c.version = c.version + 1
	return true
end

-- remove qty from one pack slot; returns what was taken
local function pack_take_at(slot, index, qty)
	local c = CHARS[slot]
	local p = c.pack[index]
	local out = copy_item(p)
	local take = imin(qty, p.qty)
	out.qty = take
	p.qty = p.qty - take
	if p.qty <= 0 then aremove(c.pack, index) end
	c.version = c.version + 1
	return out
end

-- ---- paperdoll
local function player_bonus(slot, code)
	local v = 0
	local worn = CHARS[slot].worn
	for i = 0, alen(worn) - 1 do
		local it = worn[i]
		if it.base >= 0 then v = v + item_stat(it, code) end
	end
	return v
end

local function player_armor(slot)
	local a = 0
	local worn = CHARS[slot].worn
	for i = 0, alen(worn) - 1 do
		local it = worn[i]
		if it.base >= 0 then
			local d = ITEMS[it.base]
			a = a + d.armor
			if d.kind ~= KIND_WEAPON then a = a + it.bonus end
		end
	end
	return a + player_bonus(slot, 9)
end

local function player_str(slot) return CHARS[slot].str + player_bonus(slot, 5) end
local function player_dex(slot) return CHARS[slot].dex + player_bonus(slot, 6) end
local function player_int(slot) return CHARS[slot].intel + player_bonus(slot, 7) end
local function player_luck(slot) return player_bonus(slot, 12) end

-- recompute hp/mana caps after gear or stat changes
local function player_refresh(slot)
	local c = CHARS[slot]
	local m = c.mob
	if not mob_live(m) then return end
	local hpmax = 40 + player_str(slot) + player_bonus(slot, 10)
	local mpmax = player_int(slot) + player_bonus(slot, 11)
	MOB_HPMAX[m] = imax(10, hpmax)
	MOB_MPMAX[m] = imax(0, mpmax)
	if MOB_HP[m] > MOB_HPMAX[m] then MOB_HP[m] = MOB_HPMAX[m] end
	if MOB_MP[m] > MOB_MPMAX[m] then MOB_MP[m] = MOB_MPMAX[m] end
	c.version = c.version + 1
end

local function worn_weapon(slot) return CHARS[slot].worn[SLOT_WEAPON] end

local function equip_from_pack(slot, index)
	local c = CHARS[slot]
	if index < 0 or index >= alen(c.pack) then return false end
	local it = c.pack[index]
	if not item_equippable(it) then return false end
	local s = ITEMS[it.base].slot
	local old = c.worn[s]
	c.worn[s] = it
	aremove(c.pack, index)
	if old.base >= 0 then apush(c.pack, old) end
	player_refresh(slot)
	say_to(slot, "You equip " .. item_name(it) .. ".", C_WHITE)
	return true
end

local function unequip(slot, s)
	local c = CHARS[slot]
	if s < 0 or s >= alen(c.worn) or c.worn[s].base < 0 then return false end
	if alen(c.pack) >= PACK_MAX then say_to(slot, "Your backpack is full.", C_RED); return false end
	local it = c.worn[s]
	apush(c.pack, it)
	c.worn[s] = Item()
	player_refresh(slot)
	say_to(slot, "You take off " .. item_name(it) .. ".", C_WHITE)
	return true
end

-- ---- ground items
local function gi_add(it, w, x, y, owner, ttl)
	local i = -1
	for k = 0, GI_N - 1 do
		if GI_ITEM[k].base < 0 then i = k; break end
	end
	if i < 0 then
		i = GI_N
		GI_N = i + 1
	end
	GI_ITEM[i] = copy_item(it)
	GI_W[i] = w
	GI_X[i] = x
	GI_Y[i] = y
	GI_SER[i] = NEXT_SER
	NEXT_SER = NEXT_SER + 1
	GI_EXPIRE[i] = TICK + ttl
	GI_OWNER[i] = owner
	return i
end

local function gi_remove(i) GI_ITEM[i] = Item() end

local function gi_count_at(w, x, y)
	local n = 0
	for i = 0, GI_N - 1 do
		if GI_ITEM[i].base >= 0 and GI_W[i] == w and GI_X[i] == x and GI_Y[i] == y then n = n + 1 end
	end
	return n
end

function ground_tick()
	if TICK % 50 ~= 0 then return end
	for i = 0, GI_N - 1 do
		if GI_ITEM[i].base >= 0 and TICK >= GI_EXPIRE[i] then gi_remove(i) end
	end
end

-- drop near (x, y): the tile itself, else a free neighbour (loot pops outward)
local function drop_near(it, w, x, y, owner, ttl)
	-- loot never lands where nobody can stand: open sky, walls, lava
	local k0 = walk_at(w, x, y)
	if k0 == 0 or k0 == 3 or k0 == 5 then
		x, y = find_spot(w, x, y, 8, LAND_MASK + 4)
	end
	local best_x = x
	local best_y = y
	local least = gi_count_at(w, x, y)
	local d = 0
	while d < 8 and least > 0 do
		local nx = x + DX[(d + rnd(8)) % 8]
		local ny = y + DY[(d + rnd(8)) % 8]
		if in_world(w, nx, ny) then
			local k = walk_at(w, nx, ny)
			if not (k == 0 or k == 3 or k == 5) then
				local n = gi_count_at(w, nx, ny)
				if n < least then least = n; best_x = nx; best_y = ny end
			end
		end
		d = d + 1
	end
	local gi = gi_add(it, w, best_x, best_y, owner, ttl)
	if it.rarity >= 2 then ev(EV_FX, w, best_x, best_y, FX_LOOT, it.rarity, 0, -1, "") end
	ev(EV_SPAWN, w, best_x, best_y, GI_SER[gi], x, y, -1, "")
end

-- the monster's loot: gold, its drop table, sometimes a magic item
local function loot_drop(m, killer_slot)
	local kind = MOB_KIND[m]
	local d = MONS[kind]
	local w = MOB_WORLD[m]
	local x = MOB_X[m]
	local y = MOB_Y[m]
	local elite = (bit32.band(MOB_FLAGS[m], MF_ELITE)) ~= 0
	local luck = killer_slot >= 0 and player_luck(killer_slot) or 0
	local goldfind = killer_slot >= 0 and player_bonus(killer_slot, 18) or 0
	local gold = rnd_range(d.gold_lo, d.gold_hi)
	if elite then gold = gold * 2 + 5 end
	gold = idiv(gold * (100 + goldfind), 100)
	if gold > 0 then drop_near(make_item(I_GOLD, gold), w, x, y, -1, 3000) end
	if MON_AI[kind] == Ai.thief and MOB_AUX[m] > 0 then
		drop_near(make_item(I_GOLD, MOB_AUX[m]), w, x, y, -1, 3000)
		say_near(w, x, y, cap_first(mob_the(m)) .. " drops the " .. MOB_AUX[m] .. " gold it stole!", C_YELLOW)
		MOB_AUX[m] = 0
	end
	for k = 0, d.drop_n - 1 do
		if d.boss or rnd(1000) < d.drop_chance[k] + luck then
			local qty = item_stacks(d.drop_item[k]) and 1 + rnd(2) or 1
			drop_near(make_item(d.drop_item[k], qty), w, x, y, -1, 3000)
		end
	end
	if d.fac ~= FAC_MONSTER then return end
	local magic = 80 + d.tier * 30 + luck * 2 + (elite and 300 or 0)
	if rnd(1000) < magic then drop_near(roll_equipment(d.tier, luck, elite and 1 or 0), w, x, y, -1, 3000) end
	if rnd(1000) < 180 + d.tier * 20 then drop_near(roll_consumable(d.tier), w, x, y, -1, 3000) end
	if d.boss then
		for _ = 0, 2 do drop_near(roll_equipment(imin(5, d.tier + 1), luck, 2), w, x, y, -1, 6000) end
		for _ = 0, 3 do drop_near(roll_consumable(d.tier), w, x, y, -1, 6000) end
	end
end

return { make_item = make_item, item_base_name = item_base_name, item_name = item_name, item_stat = item_stat,
	item_value = item_value, item_equippable = item_equippable, item_stacks = item_stacks, roll_rarity = roll_rarity,
	roll_affix = roll_affix, roll_mag = roll_mag, roll_equipment = roll_equipment, roll_consumable = roll_consumable,
	pack_count = pack_count, pack_has = pack_has, pack_add = pack_add, pack_take = pack_take, pack_take_at = pack_take_at,
	player_bonus = player_bonus, player_armor = player_armor, player_str = player_str, player_dex = player_dex,
	player_int = player_int, player_luck = player_luck, player_refresh = player_refresh, worn_weapon = worn_weapon,
	equip_from_pack = equip_from_pack, unequip = unequip, gi_add = gi_add, gi_remove = gi_remove, gi_count_at = gi_count_at,
