do
	local exports = (function()
-- Gator Quest (Lua port) - combat and the skill system: skills that rise by use, hit/parry/crit,
-- damage types, death (loot, fame, slime splits, boss relics), ghosts, poison/burn/slow, regen.

local CHARS, ITEMS, MONS = CHARS, ITEMS, MONS
local MOB_KIND, MOB_SER, MOB_WORLD, MOB_X, MOB_Y, MOB_DIR, MOB_HP, MOB_HPMAX = MOB_KIND, MOB_SER, MOB_WORLD, MOB_X, MOB_Y, MOB_DIR, MOB_HP, MOB_HPMAX
local MOB_MP, MOB_MPMAX, MOB_TARGET, MOB_ATK, MOB_FLAGS, MOB_PLAYER, MOB_OWNER = MOB_MP, MOB_MPMAX, MOB_TARGET, MOB_ATK, MOB_FLAGS, MOB_PLAYER, MOB_OWNER
local MOB_POISON, MOB_BURN, MOB_SLOW, MOB_HIT_T = MOB_POISON, MOB_BURN, MOB_SLOW, MOB_HIT_T
local W_BOSS_T = W_BOSS_T
local SKILL_NAME, SKILL_TITLE, RANK_NAME = SKILL_NAME, SKILL_TITLE, RANK_NAME
local DX, DY = DX, DY
local idiv, imin, imax, iclamp, cheb, dir_of, rnd, rnd_range = idiv, imin, imax, iclamp, cheb, dir_of, rnd, rnd_range
local walk_at, is_land, ev, say_to, say_near, fx_at, sound_at, shake = walk_at, is_land, ev, say_to, say_near, fx_at, sound_at, shake
local mob_live, mob_ghost, mob_alive, mob_fac, mob_the, mob_at, mob_spawn, mob_free = mob_live, mob_ghost, mob_alive, mob_fac, mob_the, mob_at, mob_spawn, mob_free
