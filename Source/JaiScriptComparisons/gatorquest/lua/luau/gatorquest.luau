local FX_LEVELUP, FX_SPARKS, FX_BONES, FX_BLOOD, FX_FIRE, FX_SMOKE, FX_HOLY, FX_POISON = Fx.levelup, Fx.sparks, Fx.bones, Fx.blood, Fx.fire, Fx.smoke, Fx.holy, Fx.poison

DMG_PHYS = 0
DMG_FIRE = 1
DMG_COLD = 2
DMG_POISON = 3
DMG_ENERGY = 4
local DMG_PHYS, DMG_FIRE, DMG_COLD, DMG_POISON = DMG_PHYS, DMG_FIRE, DMG_COLD, DMG_POISON
local SK, FX, EV, SLOT = Sk, Fx, Ev, Slot   -- one upvalue each where a function uses many (LuaJIT allows 60)

SKILL_CAP = 7000
SKILL_STAT = { [0] = 0, 0, 1, 0, 0, 1, 2, 2, 2, 1, 1, 0, 0, 0, 2, 2, 1, 1 }   -- 0 str, 1 dex, 2 int
local SKILL_CAP, SKILL_STAT = SKILL_CAP, SKILL_STAT

local function skill_total(slot)
	local t = 0
	local sk = CHARS[slot].skill
	for i = 0, alen(sk) - 1 do t = t + sk[i] end
	return t
end

-- -1 below Neophyte; 0 Neophyte (30.0) ... 7 Grandmaster (100.0)
local function skill_rank(tenths_v)
	if tenths_v < 300 then return -1 end
	return imin(7, tenths_v // 100 - 3)
end

-- a use of a skill: maybe it rises, and sometimes the stat behind it
local function skill_gain(slot, sk, success)
	local c = CHARS[slot]
	local s = c.skill[sk]
	if s >= 1000 or skill_total(slot) >= SKILL_CAP then return end
	local chance = (1050 - s) // 3 + (success and 0 or 40)
	if rnd(1000) >= chance then return end
	local amount = s < 300 and 3 or (s < 600 and 2 or 1)
	local before_rank = skill_rank(s)
	c.skill[sk] = imin(1000, s + amount)
	c.version = c.version + 1
	say_to(slot, "Your " .. SKILL_NAME[sk] .. " skill has increased by 0." .. amount .. ". It is now " .. tenths(c.skill[sk]) .. ".", C_CYAN)
	local m = c.mob
	ev(EV_GAIN, MOB_WORLD[m], MOB_X[m], MOB_Y[m], sk, c.skill[sk], 0, slot, "")
	if skill_rank(c.skill[sk]) > before_rank and skill_rank(c.skill[sk]) >= 0 then
		say_to(slot, "You are now " .. article(RANK_NAME[skill_rank(c.skill[sk])]) .. " " .. SKILL_TITLE[sk] .. "!", C_YELLOW)
		fx_at(MOB_WORLD[m], MOB_X[m], MOB_Y[m], FX_LEVELUP, 16)
		sound_at(MOB_WORLD[m], MOB_X[m], MOB_Y[m], "levelup")
	end
	if rnd(8) == 0 then
		local st = SKILL_STAT[sk]
		local total = c.str + c.dex + c.intel
		if total < 250 then
			if st == 0 and c.str < 100 then c.str = c.str + 1; say_to(slot, "Your strength has increased.", C_CYAN)
			elseif st == 1 and c.dex < 100 then c.dex = c.dex + 1; say_to(slot, "Your dexterity has increased.", C_CYAN)
			elseif st == 2 and c.intel < 100 then c.intel = c.intel + 1; say_to(slot, "Your intelligence has increased.", C_CYAN) end
			player_refresh(slot)
		end
	end
end

-- succeed against a difficulty (skill tenths where the odds are even); gains either way
local function skill_check(slot, sk, difficulty)
	local s = CHARS[slot].skill[sk]
	local chance = iclamp(500 + (s - difficulty), 30, 990)
	local ok = rnd(1000) < chance
	skill_gain(slot, sk, ok)
	return ok
end

function player_title(slot)
	local c = CHARS[slot]
	if alen(c.quest_stage) > Q_SIX_SCALES and c.quest_stage[Q_SIX_SCALES] == 99 then return "the Gator Avatar" end
	local best = 0
	for i = 1, alen(c.skill) - 1 do
		if c.skill[i] > c.skill[best] then best = i end
	end
	local r = skill_rank(c.skill[best])
	if r < 0 then return c.fame > 200 and "the Hatchling Hero" or "the Hatchling" end
	local fame = c.fame >= 2000 and "Glorious " or (c.fame >= 600 and "Famed " or "")
	return "the " .. fame .. RANK_NAME[r] .. " " .. SKILL_TITLE[best]
end

-- ---------------------------------------------------------------- damage ---
local function mob_slot_owner(m)
	if not mob_live(m) then return -1 end
	if MOB_PLAYER[m] >= 0 then return MOB_PLAYER[m] end
	local o = MOB_OWNER[m]
	if o >= 0 and mob_live(o) and MOB_PLAYER[o] >= 0 then return MOB_PLAYER[o] end
	return -1
end

-- may `a` hurt `d`? players only fight players when both carry the PvP flag
local function hostile(a, d)
	if not mob_live(a) or not mob_live(d) or a == d then return false end
	if (bit32.band(MOB_FLAGS[d], MF_INVULN)) ~= 0 or (bit32.band(MOB_FLAGS[d], MF_GHOST)) ~= 0 then return false end
	local fa = mob_fac(a)
	local fd = mob_fac(d)
	local ap = fa == FAC_PLAYER
	local dp = fd == FAC_PLAYER
	if ap and dp then
		local sa = mob_slot_owner(a)
		local sd = mob_slot_owner(d)
		if sa == sd then return false end
		if sa >= 0 and sd >= 0 and CHARS[sa].party >= 0 and CHARS[sa].party == CHARS[sd].party then return false end
		return sa >= 0 and sd >= 0 and CHARS[sa].pvp and CHARS[sd].pvp
	end
	if fa == FAC_GUARD then return fd == FAC_MONSTER or (bit32.band(MOB_FLAGS[d], MF_CRIMINAL)) ~= 0 end
	if fd == FAC_GUARD then return fa == FAC_MONSTER end
	if fa == FAC_NPC or fd == FAC_NPC then return false end
	return fa ~= fd
end

local kill

local function deal(d, amount, a, dtype, crit)
	if not mob_alive(d) or (bit32.band(MOB_FLAGS[d], MF_INVULN)) ~= 0 then return end
	local w = MOB_WORLD[d]
	if MOB_PLAYER[d] < 0 then
		local md = MONS[MOB_KIND[d]]
		if dtype == DMG_FIRE and md.fireproof then amount = idiv(amount, 4) end
		if dtype == DMG_COLD and md.frostproof then amount = idiv(amount, 4) end
		if dtype == DMG_POISON and md.undead then amount = idiv(amount, 2) end
	else
		local slot = MOB_PLAYER[d]
		if dtype == DMG_FIRE and CHARS[slot].buff_fire > TICK then amount = idiv(amount, 3) end
		if dtype ~= DMG_PHYS then
			local resist = CHARS[slot].skill[SK_RESIST] // 20 + player_bonus(slot, 13)
			amount = idiv(amount * 100, 100 + resist)
			skill_gain(slot, SK_RESIST, true)
		end
	end
	if amount < 1 then amount = 1 end
	MOB_HP[d] = MOB_HP[d] - amount
	MOB_HIT_T[d] = TICK
	ev(EV_DMG, w, MOB_X[d], MOB_Y[d], MOB_SER[d], amount, dtype + (crit and 16 or 0), -1, "")
	if MOB_PLAYER[d] >= 0 then
		shake(MOB_PLAYER[d], imin(6, 1 + idiv(amount * 12, imax(1, MOB_HPMAX[d]))))
		CHARS[MOB_PLAYER[d]].action = 0    -- a hit interrupts fishing, mining, crafting
	end
	-- wake up and hit back
	if mob_live(a) and MOB_PLAYER[d] < 0 and a ~= d then
		if MOB_TARGET[d] < 0 or rnd(3) == 0 then MOB_TARGET[d] = a end
		MOB_FLAGS[d] = bit32.bor(MOB_FLAGS[d], MF_ALERT)
		MOB_FLAGS[d] = bit32.band(MOB_FLAGS[d], bit32.bnot(MF_HIDDEN))
	end
	if MOB_HP[d] <= 0 then kill(d, a) end
end

local function heal_mob(m, amount, src)
	if not mob_alive(m) then return end
	local before = MOB_HP[m]
	MOB_HP[m] = imin(MOB_HPMAX[m], MOB_HP[m] + amount)
	local got = MOB_HP[m] - before
	if got > 0 then ev(EV_HEAL, MOB_WORLD[m], MOB_X[m], MOB_Y[m], MOB_SER[m], got, 0, -1, "") end
end

-- ---------------------------------------------------------------- attack ---
local function weapon_skill(slot)
	local wpn = CHARS[slot].worn[SLOT_WEAPON]
	if wpn.base < 0 then return SK_WRESTLING end
	return ITEMS[wpn.base].skill
end

local function attack_range(m)
	if MOB_PLAYER[m] >= 0 then
		local wpn = CHARS[MOB_PLAYER[m]].worn[SLOT_WEAPON]
		if wpn.base < 0 then return 1 end
		return ITEMS[wpn.base].range
	end
	return MONS[MOB_KIND[m]].range
end

local function swing_ticks(m)
	if MOB_PLAYER[m] >= 0 then
		local slot = MOB_PLAYER[m]
		local wpn = CHARS[slot].worn[SLOT_WEAPON]
		local base = wpn.base < 0 and 6 or ITEMS[wpn.base].speed
		base = base - player_bonus(slot, 8) - idiv(player_dex(slot), 40)
		return imax(3, base)
	end
	return MONS[MOB_KIND[m]].aspeed
end

local function defense_skill(d)
	if MOB_PLAYER[d] >= 0 then
		local slot = MOB_PLAYER[d]
		return imax(CHARS[slot].skill[weapon_skill(slot)], CHARS[slot].skill[SK_WRESTLING])
	end
	return MONS[MOB_KIND[d]].skill
end

local function proj_kind(a)
	if MOB_PLAYER[a] >= 0 then
		local wpn = CHARS[MOB_PLAYER[a]].worn[SLOT_WEAPON]
		if wpn.base >= 0 and ITEMS[wpn.base].skill == SK_MAGERY then return 1 end
		return 0
	end
	if MONS[MOB_KIND[a]].spr == "harpy" then return 6 end
	return 0
end

-- one swing (or shot) from a at d; the caller has checked range, cooldown and hostility
local function attack(a, d)
	local w = MOB_WORLD[a]
	MOB_ATK[a] = TICK + swing_ticks(a)
	MOB_DIR[a] = dir_of(MOB_X[d] - MOB_X[a], MOB_Y[d] - MOB_Y[a])
	MOB_FLAGS[a] = bit32.band(MOB_FLAGS[a], bit32.bnot(MF_HIDDEN))
	local slot = MOB_PLAYER[a]
	local rng = attack_range(a)
	local ranged = rng > 1 and cheb(MOB_X[a], MOB_Y[a], MOB_X[d], MOB_Y[d]) > 1
	local lo = 1
	local hi = 3
	local askill = 300
	local sk = SK.wrestling
	local dmg_pct = 100
	local crit = 50
	local extra_fire = 0
	local extra_cold = 0
	local extra_poison = 0
	local leech = 0
	if slot >= 0 then
		local c = CHARS[slot]
		local wpn = c.worn[SLOT.weapon]
		sk = weapon_skill(slot)
		askill = c.skill[sk]
		if wpn.base >= 0 then
			lo = ITEMS[wpn.base].lo + wpn.bonus
			hi = ITEMS[wpn.base].hi + wpn.bonus
		else
			lo = 2
			hi = 6 + idiv(player_str(slot), 15)      -- the bite
		end
		if ranged and sk == SK.archery then
			if not pack_take(slot, I_ARROW, 1) then
				say_to(slot, "You have no arrows!", C_RED)
				return
			end
		end
		if ranged and sk == SK.magery then
			if MOB_MP[a] < 2 then say_to(slot, "Your wand needs mana.", C_RED); return end
			MOB_MP[a] = MOB_MP[a] - 2
		end
		dmg_pct = 100 + c.skill[SK.tactics] // 10 + idiv(player_str(slot), 4) + player_bonus(slot, 0)
		crit = 50 + player_bonus(slot, 17) * 10 + player_luck(slot) * 2
		extra_fire = player_bonus(slot, 1)
		extra_cold = player_bonus(slot, 2)
		extra_poison = player_bonus(slot, 3)
		leech = player_bonus(slot, 4)
	else
		local md = MONS[MOB_KIND[a]]
		lo = md.lo
		hi = md.hi
		askill = md.skill
		leech = md.leech
		if (bit32.band(MOB_FLAGS[a], MF_ELITE)) ~= 0 then dmg_pct = 140 end
		if md.poisonous and rnd(3) == 0 then extra_poison = 3 end
	end
	if ranged then
		ev(EV.proj, w, MOB_X[a], MOB_Y[a], MOB_X[d], MOB_Y[d], proj_kind(a), -1, "")
	end
	local dskill = defense_skill(d)
	local hit = iclamp(500 + idiv(askill - dskill, 2) + (slot >= 0 and player_dex(slot) or 0), 100, 950)
	if rnd(1000) >= hit then
		ev(EV.miss, w, MOB_X[d], MOB_Y[d], MOB_SER[d], 0, 0, -1, "")
		sound_at(w, MOB_X[a], MOB_Y[a], ranged and "bow" or "swing")
		if slot >= 0 then skill_gain(slot, sk, false) end
		if MOB_PLAYER[d] >= 0 then skill_gain(MOB_PLAYER[d], weapon_skill(MOB_PLAYER[d]), true) end
		if MOB_PLAYER[d] < 0 and MOB_TARGET[d] < 0 then MOB_TARGET[d] = a end
		return
	end
	-- a shield can turn the blow aside
	local ds = MOB_PLAYER[d]
	if ds >= 0 and CHARS[ds].worn[SLOT.offhand].base >= 0 and not ranged then
		local parry = CHARS[ds].skill[SK.parrying] // 4
		if rnd(1000) < parry then
			say_to(ds, "You parry the blow!", C_GREEN)
			ev(EV.miss, w, MOB_X[d], MOB_Y[d], MOB_SER[d], 1, 0, -1, "")
			sound_at(w, MOB_X[d], MOB_Y[d], "clang")
			fx_at(w, MOB_X[d], MOB_Y[d], FX.sparks, 6)
			skill_gain(ds, SK.parrying, true)
			return
		end
		skill_gain(ds, SK.parrying, false)
	end
	local dmg = idiv(rnd_range(lo, hi) * dmg_pct, 100)
	local is_crit = rnd(1000) < crit
	if is_crit then dmg = dmg * 2 end
	local armor = ds >= 0 and player_armor(ds) or MONS[MOB_KIND[d]].armor
	dmg = idiv(dmg * 100, 100 + armor * 5)
	if dmg < 1 then dmg = 1 end
	sound_at(w, MOB_X[d], MOB_Y[d], is_crit and "crit" or (ranged and "arrowhit" or "hit"))
	fx_at(w, MOB_X[d], MOB_Y[d], (MOB_PLAYER[d] < 0 and MONS[MOB_KIND[d]].undead) and FX.bones or FX.blood, is_crit and 10 or 4)
	if slot >= 0 then
		skill_gain(slot, sk, true)
		skill_gain(slot, SK.tactics, true)
	end
	if ds >= 0 then skill_gain(ds, weapon_skill(ds), false) end
	-- thorns bite back before the blow lands (the attacker may be the one who dies)
	local thorns = ds >= 0 and player_bonus(ds, 15) or 0
	local att_hp_before = MOB_HP[a]
	deal(d, dmg, a, DMG_PHYS, is_crit)
	if leech > 0 and mob_alive(a) then heal_mob(a, imax(1, idiv(dmg * leech, 100)), a) end
	if extra_fire > 0 and mob_alive(d) then deal(d, extra_fire, a, DMG_FIRE, false); fx_at(w, MOB_X[d], MOB_Y[d], FX.fire, 4) end
	if extra_cold > 0 and mob_alive(d) then deal(d, extra_cold, a, DMG_COLD, false); MOB_SLOW[d] = imax(MOB_SLOW[d], 20) end
	if extra_poison > 0 and mob_alive(d) then MOB_POISON[d] = imax(MOB_POISON[d], 40 + extra_poison * 10) end
	if thorns > 0 and mob_alive(a) and att_hp_before > 0 then deal(a, thorns, d, DMG_PHYS, false) end
end

-- ----------------------------------------------------------------- death ---
local player_die

kill = function(d, a)
	local killer = mob_slot_owner(a)
	local w = MOB_WORLD[d]
	local x = MOB_X[d]
	local y = MOB_Y[d]
	if MOB_PLAYER[d] >= 0 then
		player_die(MOB_PLAYER[d], a)
		return
	end
	local kind = MOB_KIND[d]
	local md = MONS[kind]
	STAT_KILLS = STAT_KILLS + 1
	ev(EV_DEATH, w, x, y, MOB_SER[d], kind, 0, -1, "")
	sound_at(w, x, y, md.boss and "bossdie" or "die")
	fx_at(w, x, y, md.undead and FX_BONES or FX_BLOOD, md.boss and 30 or 8)
	loot_drop(d, killer)
	if killer >= 0 then
		local c = CHARS[killer]
		local fame = md.fame * ((bit32.band(MOB_FLAGS[d], MF_ELITE)) ~= 0 and 2 or 1)
		c.fame = c.fame + fame
		c.karma = c.karma + (md.fac == FAC_MONSTER and fame // 2 + 1 or 0)
		c.kills = c.kills + 1
		c.version = c.version + 1
		quest_on_kill(killer, kind)
		-- party members nearby share the kill credit
		for s = 0, CHAR_N - 1 do
			if s ~= killer and CHARS[s].active and c.party >= 0 and CHARS[s].party == c.party then
				local pm = CHARS[s].mob
				if mob_live(pm) and MOB_WORLD[pm] == w and cheb(MOB_X[pm], MOB_Y[pm], x, y) <= 12 then quest_on_kill(s, kind) end
			end
		end
	end
	if md.boss then
		W_BOSS_T[w] = TICK + 3000
		local who = killer >= 0 and CHARS[killer].name or "the swamp itself"
		for s = 0, CHAR_N - 1 do
			if CHARS[s].active then say_to(s, md.name .. " has been slain by " .. who .. "!", C_YELLOW) end
		end
		if killer >= 0 then
			CHARS[killer].boss_mask = bit32.bor(CHARS[killer].boss_mask, (bit32.lshift(1, w)))
			shake(killer, 8)
		end
	end
	if md.split >= 0 then
		for k = 0, 1 do
			for dir = 0, 7 do
				local nx = x + DX[(dir + k * 3) % 8]
				local ny = y + DY[(dir + k * 3) % 8]
				if mob_at(w, nx, ny) < 0 and is_land(w, nx, ny) then
					local s2 = mob_spawn(md.split, w, nx, ny)
					MOB_TARGET[s2] = a
					break
				end
			end
		end
		say_near(w, x, y, "The slime splits in two!", C_GREEN)
	end
	mob_free(d)
end

player_die = function(slot, a)
	local c = CHARS[slot]
	local m = c.mob
	local w = MOB_WORLD[m]
	MOB_HP[m] = 0
	MOB_FLAGS[m] = bit32.band((bit32.bor(MOB_FLAGS[m], MF_GHOST)), bit32.bnot(MF_SWIM))
	MOB_TARGET[m] = -1
	MOB_POISON[m] = 0
	MOB_BURN[m] = 0
	c.action = 0
	c.deaths = c.deaths + 1
	c.version = c.version + 1
	if c.gold > 0 then
		local pouch = make_item(I_GOLD, c.gold)
		gi_add(pouch, w, MOB_X[m], MOB_Y[m], slot, 6000)
		c.gold = 0
	end
	local by = mob_live(a) and mob_the(a) or "misadventure"
	say_to(slot, "You have been slain by " .. by .. "! Your ghost drifts free. Find a healer or a shrine.", C_RED)
	ev(EV_BANNER, -1, 0, 0, -1, 0, 0, slot, "YOU HAVE DIED")
	sound_at(w, MOB_X[m], MOB_Y[m], "death")
	fx_at(w, MOB_X[m], MOB_Y[m], FX_SMOKE, 12)
	shake(slot, 8)
	for i = 0, MOB_N - 1 do
		if MOB_TARGET[i] == m then MOB_TARGET[i] = -1 end
	end
	-- player killers: murdering an unflagged gator makes you a criminal
	local ks = mob_slot_owner(a)
	if ks >= 0 and ks ~= slot and not c.pvp then
		CHARS[ks].murders = CHARS[ks].murders + 1
		CHARS[ks].karma = CHARS[ks].karma - 500
		local km = CHARS[ks].mob
		MOB_FLAGS[km] = bit32.bor(MOB_FLAGS[km], MF_CRIMINAL)
		say_to(ks, "You are now a murderer! The guards will not forget.", C_RED)
	end
end

local function player_resurrect(slot, pct)
	local c = CHARS[slot]
	local m = c.mob
	if not mob_ghost(m) then return end
	MOB_FLAGS[m] = bit32.band(MOB_FLAGS[m], bit32.bnot(MF_GHOST))
	player_refresh(slot)
	MOB_HP[m] = imax(1, MOB_HPMAX[m] * pct // 100)
	MOB_MP[m] = MOB_MPMAX[m] // 2
	c.version = c.version + 1
	say_to(slot, "You feel the warm mud of life again!", C_GREEN)
	ev(EV_BANNER, -1, 0, 0, -2, 0, 0, slot, "RESURRECTED")
	fx_at(MOB_WORLD[m], MOB_X[m], MOB_Y[m], FX_HOLY, 20)
	sound_at(MOB_WORLD[m], MOB_X[m], MOB_Y[m], "res")
end

-- ------------------------------------------------------ status and regen ---
function status_tick()
	local m = 0
	while m < MOB_N do   -- the pool can grow mid-loop (a slime split), and the new slots are visited, as in the script
		if MOB_KIND[m] >= 0 and MOB_HP[m] > 0 then
			local slot = MOB_PLAYER[m]
			local dead = false
			if MOB_SLOW[m] > 0 then MOB_SLOW[m] = MOB_SLOW[m] - 1 end
			if MOB_POISON[m] > 0 then
				MOB_POISON[m] = MOB_POISON[m] - 1
				if MOB_POISON[m] % 10 == 0 then
					deal(m, 1 + MOB_POISON[m] // 30, -1, DMG_POISON, false)
					if not mob_live(m) or MOB_HP[m] <= 0 then dead = true
					elseif MOB_POISON[m] % 30 == 0 then fx_at(MOB_WORLD[m], MOB_X[m], MOB_Y[m], FX_POISON, 3) end
				end
			end
			if not dead then
				local w = MOB_WORLD[m]
				-- lava burns whoever stands in it without protection
				if walk_at(w, MOB_X[m], MOB_Y[m]) == 5 and not mob_ghost(m) then
					local proof
					if slot >= 0 then proof = CHARS[slot].buff_fire > TICK else proof = MONS[MOB_KIND[m]].fireproof end
					if not proof then MOB_BURN[m] = imax(MOB_BURN[m], 12) end
				end
				if MOB_BURN[m] > 0 then
					MOB_BURN[m] = MOB_BURN[m] - 1
					if MOB_BURN[m] % 4 == 0 then
						fx_at(w, MOB_X[m], MOB_Y[m], FX_FIRE, 3)
						deal(m, 2, -1, DMG_FIRE, false)
						if not mob_live(m) or MOB_HP[m] <= 0 then dead = true end
					end
				end
			end
			if not dead then
				if slot >= 0 then
					if not mob_ghost(m) then
						local c = CHARS[slot]
						local regen = player_bonus(slot, 14) + (c.buff_regen > TICK and 3 or 0)
						local hp_every = imax(4, 28 - regen * 5 - idiv(player_str(slot), 12))
						if (TICK + slot) % hp_every == 0 and MOB_HP[m] < MOB_HPMAX[m] then MOB_HP[m] = MOB_HP[m] + 1 end
						local mp_every = imax(3, 22 - c.skill[SK_MEDITATION] // 70 - player_bonus(slot, 19) * 3)
						if (TICK + slot) % mp_every == 0 and MOB_MP[m] < MOB_MPMAX[m] then
							MOB_MP[m] = MOB_MP[m] + 1
							if MOB_MP[m] < MOB_MPMAX[m] and rnd(20) == 0 then skill_gain(slot, SK_MEDITATION, true) end
						end
					end
				else
					local rg = MONS[MOB_KIND[m]].regen
					if rg > 0 and TICK % 10 == 0 and MOB_HP[m] < MOB_HPMAX[m] then MOB_HP[m] = imin(MOB_HPMAX[m], MOB_HP[m] + rg) end
					-- out-of-combat monsters recover slowly
					if MOB_TARGET[m] < 0 and TICK % 20 == 0 and MOB_HP[m] < MOB_HPMAX[m] then MOB_HP[m] = MOB_HP[m] + 1 end
				end
			end
		end
		m = m + 1
	end
end

return { skill_total = skill_total, skill_gain = skill_gain, skill_rank = skill_rank, skill_check = skill_check,
	mob_slot_owner = mob_slot_owner, hostile = hostile, deal = deal, heal_mob = heal_mob, weapon_skill = weapon_skill,
	attack_range = attack_range, swing_ticks = swing_ticks, defense_skill = defense_skill, proj_kind = proj_kind,
	attack = attack, kill = kill, player_die = player_die, player_resurrect = player_resurrect }
end)()
	skill_total = exports.skill_total
	skill_gain = exports.skill_gain
	skill_rank = exports.skill_rank
	skill_check = exports.skill_check
	mob_slot_owner = exports.mob_slot_owner
	hostile = exports.hostile
	deal = exports.deal
	heal_mob = exports.heal_mob
	weapon_skill = exports.weapon_skill
	attack_range = exports.attack_range
	swing_ticks = exports.swing_ticks
	defense_skill = exports.defense_skill
	proj_kind = exports.proj_kind
	attack = exports.attack
	kill = exports.kill
	player_die = exports.player_die
	player_resurrect = exports.player_resurrect
end
