local SK_MAGERY = Sk.magery
local EV_PROJ, EV_WARP = Ev.proj, Ev.warp
local FX_FIRE, FX_FROST, FX_ZAP, FX_POISON, FX_WARP, FX_MAGIC, FX_SMOKE = Fx.fire, Fx.frost, Fx.zap, Fx.poison, Fx.warp, Fx.magic, Fx.smoke
local DMG_FIRE, DMG_COLD, DMG_POISON, DMG_ENERGY = DMG_FIRE, DMG_COLD, DMG_POISON, DMG_ENERGY

SPELL_RANGE = 8
local SPELL_RANGE = SPELL_RANGE

local function proj_for_fx(fx)
	if fx == FX_FIRE then return 2 end
	if fx == FX_FROST then return 3 end
	if fx == FX_ZAP then return 4 end
	if fx == FX_POISON then return 5 end
	return 1
end

-- the player's intended victim: current target if valid, else the nearest visible hostile
local function spell_target(m, range)
	local t = MOB_TARGET[m]
	local w = MOB_WORLD[m]
	if mob_alive(t) and MOB_WORLD[t] == w and hostile(m, t) and cheb(MOB_X[m], MOB_Y[m], MOB_X[t], MOB_Y[t]) <= range
		and los(w, MOB_X[m], MOB_Y[m], MOB_X[t], MOB_Y[t]) then return t end
	local best = -1
	local bestd = range + 1
	for dy = -range, range do
		for dx = -range, range do
			local o = mob_at(w, MOB_X[m] + dx, MOB_Y[m] + dy)
			if not (o < 0 or not hostile(m, o) or not mob_alive(o)) then
				local d = cheb(0, 0, dx, dy)
				if d < bestd and los(w, MOB_X[m], MOB_Y[m], MOB_X[o], MOB_Y[o]) then best = o; bestd = d end
			end
		end
	end
	return best
end

local function spell_power(caster, lo, hi)
	local v = rnd_range(lo, hi)
	local slot = MOB_PLAYER[caster]
	if slot >= 0 then
		v = idiv(v * (100 + CHARS[slot].skill[SK_MAGERY] // 10 + idiv(player_int(slot), 4) + player_bonus(slot, 20) * 3), 100)
	else
		v = idiv(v * (100 + MONS[MOB_KIND[caster]].tier * 15), 100)
	end
	return imax(1, v)
end

local function spell_hit(caster, t, s)
	local dmg = spell_power(caster, s.lo, s.hi)
	local w = MOB_WORLD[t]
	fx_at(w, MOB_X[t], MOB_Y[t], s.fx, 10)
	if s.eff == 5 then
		deal(t, dmg, caster, DMG_FIRE, false)
		if mob_alive(t) then MOB_BURN[t] = imax(MOB_BURN[t], 16) end
	elseif s.eff == 4 then
		deal(t, dmg, caster, DMG_COLD, false)
		if mob_alive(t) then MOB_SLOW[t] = imax(MOB_SLOW[t], 40) end
	elseif s.eff == 7 then
		if mob_alive(t) then MOB_POISON[t] = imax(MOB_POISON[t], dmg) end
		deal(t, 2, caster, DMG_POISON, false)
	else
		deal(t, dmg, caster, DMG_ENERGY, false)
	end
end

local travel

-- apply a spell; returns false when there was nothing to aim at (no mana spent)
local function spell_effect(caster, spell, t)
	local s = SPELLS[spell]
	local w = MOB_WORLD[caster]
	local cx = MOB_X[caster]
	local cy = MOB_Y[caster]
	local slot = MOB_PLAYER[caster]
	if s.target == 1 then
		if not mob_alive(t) then return false end
		ev(EV_PROJ, w, cx, cy, MOB_X[t], MOB_Y[t], proj_for_fx(s.fx), -1, "")
		spell_hit(caster, t, s)
		return true
	end
	if s.target == 2 then
		if not mob_alive(t) then return false end
		local tx = MOB_X[t]
		local ty = MOB_Y[t]
		ev(EV_PROJ, w, cx, cy, tx, ty, proj_for_fx(s.fx), -1, "")
		fx_at(w, tx, ty, s.fx, 24)
		for dy = -s.radius, s.radius do
			for dx = -s.radius, s.radius do
				local o = mob_at(w, tx + dx, ty + dy)
				if o >= 0 and mob_alive(o) and hostile(caster, o) then
					if o ~= t then ev(EV_PROJ, w, tx, ty, MOB_X[o], MOB_Y[o], proj_for_fx(s.fx), -1, "") end
					spell_hit(caster, o, s)
				end
			end
		end
		if slot >= 0 then shake(slot, 3) end
		return true
	end
	if s.target == 0 then
		local who = caster
		if mob_alive(t) and not hostile(caster, t) and cheb(cx, cy, MOB_X[t], MOB_Y[t]) <= SPELL_RANGE then who = t end
		if s.eff == 3 then
			MOB_POISON[who] = 0
			say_mob(who, "The poison leaves you.", C_GREEN)
		else
			heal_mob(who, spell_power(caster, s.lo, s.hi), caster)
		end
		fx_at(w, MOB_X[who], MOB_Y[who], s.fx, 12)
		return true
	end
	if s.target == 8 and slot >= 0 then
		CHARS[slot].buff_night = TICK + s.lo
		say_to(slot, "Your eyes adjust to the dark.", C_YELLOW)
		fx_at(w, cx, cy, s.fx, 8)
		return true
	end
	if s.target == 5 then
		local dir = MOB_DIR[caster]
		local bx = cx
		local by = cy
		for k = 1, s.lo do
			local nx = cx + DX[dir] * k
			local ny = cy + DY[dir] * k
			local wk = walk_at(w, nx, ny)
			if wk == 0 then break end
			if wk ~= 3 and mob_at(w, nx, ny) < 0 then bx = nx; by = ny end
		end
		if bx == cx and by == cy then return false end
		fx_at(w, cx, cy, FX_WARP, 12)
		mob_place(caster, w, bx, by)
		fx_at(w, bx, by, FX_WARP, 12)
		return true
	end
	if s.target == 6 and slot >= 0 then
		local c = CHARS[slot]
		fx_at(w, cx, cy, FX_WARP, 16)
		local px, py = find_spot(c.home_world, c.home_x, c.home_y, 5, LAND_MASK)
		travel(caster, c.home_world, px, py)
		return true
	end
	if s.target == 4 then
		for d = 0, 7 do
			local nx = cx + DX[d]
			local ny = cy + DY[d]
			local wk = walk_at(w, nx, ny)
			if (wk == 1 or wk == 6 or wk == 2 or wk == 4) and mob_at(w, nx, ny) < 0 then
				local f = mob_spawn(M_FAMILIAR, w, nx, ny)
				MOB_OWNER[f] = caster
				MOB_FLAGS[f] = bit32.bor(MOB_FLAGS[f], MF_SUMMON)
				MOB_AUX[f] = TICK + 1800
				fx_at(w, nx, ny, FX_MAGIC, 14)
				say_near(w, nx, ny, "A frog familiar pops into existence! \"Ribbit!\"", C_GREEN)
				return true
			end
		end
		return false
	end
	if s.target == 7 then
		for s2 = 0, CHAR_N - 1 do
			local p = CHARS[s2].mob
			if CHARS[s2].active and mob_live(p) and mob_ghost(p) and MOB_WORLD[p] == w and cheb(cx, cy, MOB_X[p], MOB_Y[p]) <= 3 then
				player_resurrect(s2, 50)
				return true
			end
		end
		return false
	end
	return false
end

function player_cast(slot, spell)
	local c = CHARS[slot]
	local m = c.mob
	if spell < 0 or spell >= SPELL_N then return false end
	if mob_ghost(m) then say_to(slot, "Ghosts cannot cast. Find a healer.", C_GRAY); return false end
	if alen(c.spells) <= spell or c.spells[spell] == 0 then say_to(slot, "You do not know that spell.", C_GRAY); return false end
	if not pack_has(slot, I_SPELLBOOK, 1) then say_to(slot, "You need a spellbook.", C_GRAY); return false end
	local s = SPELLS[spell]
	if MOB_MP[m] < s.mana then say_to(slot, "Insufficient mana.", C_BLUE); return false end
	for r = 0, s.reg_n - 1 do
		if not pack_has(slot, s.reg[r], 1) then
			say_to(slot, "You lack " .. ITEMS[s.reg[r]].name .. " for " .. s.name .. ".", C_GRAY)
			return false
		end
	end
	local t = -1
	if s.target == 1 or s.target == 2 then
		t = spell_target(m, SPELL_RANGE)
		if t < 0 then say_to(slot, "No target in sight.", C_GRAY); return false end
		MOB_TARGET[m] = t
	elseif s.target == 0 then
		t = MOB_TARGET[m]
	end
	c.last_spell = spell
	for r = 0, s.reg_n - 1 do pack_take(slot, s.reg[r], 1) end
	local difficulty = s.circle * 125 - 150
	if not skill_check(slot, SK_MAGERY, difficulty) then
		MOB_MP[m] = MOB_MP[m] - s.mana // 2
		say_to(slot, "The spell fizzles.", C_GRAY)
		fx_at(MOB_WORLD[m], MOB_X[m], MOB_Y[m], FX_SMOKE, 5)
		sound_at(MOB_WORLD[m], MOB_X[m], MOB_Y[m], "fizzle")
		return true
	end
	if not spell_effect(m, spell, t) then
		say_to(slot, "The spell finds nothing to hold on to.", C_GRAY)
		return true
	end
	MOB_MP[m] = MOB_MP[m] - s.mana
	sound_at(MOB_WORLD[m], MOB_X[m], MOB_Y[m], s.snd)
	c.version = c.version + 1
	return true
end

function mob_cast(m, spell, t)
	local s = SPELLS[spell]
	say_near(MOB_WORLD[m], MOB_X[m], MOB_Y[m], cap_first(mob_the(m)) .. " casts " .. s.name .. "!", C_PURPLE)
	sound_at(MOB_WORLD[m], MOB_X[m], MOB_Y[m], s.snd)
	spell_effect(m, spell, t)
end

-- moving between places (gates, recall, falling): arrival fx on both ends
travel = function(m, w, x, y)
	local from = MOB_WORLD[m]
	fx_at(from, MOB_X[m], MOB_Y[m], FX_WARP, 12)
	local px, py = find_free_spot(w, x, y, 6, LAND_MASK + (MOB_PLAYER[m] >= 0 and 4 or 0))
	mob_place(m, w, px, py)
	fx_at(w, px, py, FX_WARP, 16)
	sound_at(w, px, py, "warp")
	local slot = MOB_PLAYER[m]
	if slot >= 0 then
		local c = CHARS[slot]
		step_queue_flush(slot)
		if from ~= w then
			ev(EV_WARP, w, px, py, w, from, 0, slot, WORLDS[w].name)
			say_to(slot, WORLDS[w].name .. ": " .. WORLDS[w].banner, C_YELLOW)
			while alen(c.visited) < WORLD_COUNT do apush(c.visited, 0) end
			if c.visited[w] == 0 then
				c.visited[w] = 1
				quest_on_visit(slot)
			end
		end
		c.action = 0
		c.version = c.version + 1
		-- summons follow their caster through gates
		for i = 0, MOB_N - 1 do
			if MOB_KIND[i] >= 0 and MOB_OWNER[i] == m and (bit32.band(MOB_FLAGS[i], MF_SUMMON)) ~= 0 then
				local qx, qy = find_free_spot(w, px + 1, py, 3, LAND_MASK + 4)
				mob_place(i, w, qx, qy)
			end
		end
	end
end

return { proj_for_fx = proj_for_fx, spell_target = spell_target, spell_power = spell_power, spell_hit = spell_hit,
	spell_effect = spell_effect, travel = travel }
end)()
	proj_for_fx = exports.proj_for_fx
	spell_target = exports.spell_target
	spell_power = exports.spell_power
	spell_hit = exports.spell_hit
	spell_effect = exports.spell_effect
	travel = exports.travel
end
-- gq_quests
do
	local exports = (function()
-- Gator Quest (Lua port) - quests and the journal. A quest is 0 (not taken), 1 (active) or 99 (done).

local CHARS, QUESTS, ROLES, RELICS = CHARS, QUESTS, ROLES, RELICS
local MOB_WORLD, MOB_X, MOB_Y = MOB_WORLD, MOB_X, MOB_Y
local rnd, ev, say_to, sound_at, fx_at = rnd, ev, say_to, sound_at, fx_at
local pack_has, pack_count, pack_take, pack_add, make_item, item_name, drop_near =
	pack_has, pack_count, pack_take, pack_add, make_item, item_name, drop_near
local alen, apush, split = alen, apush, split
local EV_BANNER, FX_GOLD = Ev.banner, Fx.gold
local Q_SIX_SCALES = Q_SIX_SCALES

local function quest_ensure(slot)
	local c = CHARS[slot]
	while alen(c.quest_stage) < QUEST_N do apush(c.quest_stage, 0) end
	while alen(c.quest_count) < QUEST_N do apush(c.quest_count, 0) end
end

local function quest_active(slot, q) return CHARS[slot].quest_stage[q] == 1 end

local function relics_held(slot)
	local n = 0
	for i = 0, alen(RELICS) - 1 do
		if pack_has(slot, RELICS[i], 1) then n = n + 1 end
	end
	return n
end

-- progress toward the goal (for the journal and turn-in)
local function quest_progress(slot, q)
	local d = QUESTS[q]
	local c = CHARS[slot]
	if q == Q_SIX_SCALES then return relics_held(slot) end
	if d.type == 1 then return pack_count(slot, d.target) end
	if d.type == 3 then
		local n = 0
		for i = 0, alen(c.visited) - 1 do n = n + c.visited[i] end
		return n
	end
	return c.quest_count[q]
end

local function quest_goal(q) if q == Q_SIX_SCALES then return 6 end return QUESTS[q].count end

local function quest_ready(slot, q) return quest_active(slot, q) and quest_progress(slot, q) >= quest_goal(q) end

local function quest_bump(slot, q, by)
	local c = CHARS[slot]
	if not quest_active(slot, q) then return end
	local before = c.quest_count[q]
	c.quest_count[q] = c.quest_count[q] + by
	c.version = c.version + 1
	local qd = QUESTS[q]
	if before < qd.count and c.quest_count[q] >= qd.count then
		say_to(slot, "Quest complete: " .. qd.name .. ". Return to " .. ROLES[qd.giver].name .. ".", C_YELLOW)
		sound_at(MOB_WORLD[c.mob], MOB_X[c.mob], MOB_Y[c.mob], "quest")
	elseif c.quest_count[q] < qd.count then
		say_to(slot, qd.name .. ": " .. c.quest_count[q] .. "/" .. qd.count, C_GRAY)
	end
end

function quest_on_kill(slot, kind)
	quest_ensure(slot)
	for q = 0, QUEST_N - 1 do
		local d = QUESTS[q]
		if (d.type == 0 or d.type == 2) and d.target == kind then quest_bump(slot, q, 1) end
	end
end

function quest_on_visit(slot)
	quest_ensure(slot)
	for q = 0, QUEST_N - 1 do
		if QUESTS[q].type == 3 and quest_ready(slot, q) then
			say_to(slot, "Quest complete: " .. QUESTS[q].name .. ". Return to " .. ROLES[QUESTS[q].giver].name .. ".", C_YELLOW)
		end
	end
end

function quest_on_craft(slot)
	quest_ensure(slot)
	for q = 0, QUEST_N - 1 do
		if QUESTS[q].type == 4 then quest_bump(slot, q, 1) end
	end
end

function quest_on_fish(slot)
	quest_ensure(slot)
	for q = 0, QUEST_N - 1 do
		if QUESTS[q].type == 5 then quest_bump(slot, q, 1) end
	end
end

-- quests an npc role can hand out right now (-1 = none)
local function quest_offer(slot, role)
	quest_ensure(slot)
	local c = CHARS[slot]
	for q = 0, QUEST_N - 1 do
		local d = QUESTS[q]
		if not (d.giver ~= role or c.quest_stage[q] ~= 0) and not (d.needs >= 0 and c.quest_stage[d.needs] ~= 99) then
			return q
		end
	end
	return -1
end

-- talking quest business with an npc: turn in anything finished, else take the next offer
function quest_talk(slot, role)
	quest_ensure(slot)
	local c = CHARS[slot]
	for q = 0, QUEST_N - 1 do
		local d = QUESTS[q]
		if d.giver == role and quest_ready(slot, q) then
			if d.type == 1 then
				local item = q == Q_SIX_SCALES and -1 or d.target
				if item >= 0 then pack_take(slot, item, d.count)
				else
					for i = 0, alen(RELICS) - 1 do pack_take(slot, RELICS[i], 1) end
				end
			end
			c.quest_stage[q] = 99
			c.gold = c.gold + d.gold
			if d.reward >= 0 then
				local it = make_item(d.reward, d.reward_qty)
				if not pack_add(slot, it) then drop_near(it, MOB_WORLD[c.mob], MOB_X[c.mob], MOB_Y[c.mob], slot, 3000) end
			end
			c.fame = c.fame + 50 + d.gold // 2
			c.version = c.version + 1
			say_to(slot, ROLES[role].name .. ": \"" .. d.done .. "\"", C_WHITE)
			local reward = d.reward >= 0 and (" and " .. item_name(make_item(d.reward, d.reward_qty))) or ""
			say_to(slot, "Quest turned in: " .. d.name .. ". You receive " .. d.gold .. " gold" .. reward .. ".", C_YELLOW)
			ev(EV_BANNER, -1, 0, 0, -4, 0, 0, slot, "QUEST COMPLETE")
			sound_at(MOB_WORLD[c.mob], MOB_X[c.mob], MOB_Y[c.mob], "quest")
			fx_at(MOB_WORLD[c.mob], MOB_X[c.mob], MOB_Y[c.mob], FX_GOLD, 16)
			if q == Q_SIX_SCALES then
				for s = 0, CHAR_N - 1 do
					if CHARS[s].active then say_to(s, c.name .. " has become the GATOR AVATAR! All hail!", C_YELLOW) end
				end
			end
			return
		end
	end
	local offer = quest_offer(slot, role)
	if offer >= 0 then
		c.quest_stage[offer] = 1
		c.quest_count[offer] = 0
		c.version = c.version + 1
		say_to(slot, ROLES[role].name .. ": \"" .. QUESTS[offer].offer .. "\"", C_WHITE)
		say_to(slot, "New quest: " .. QUESTS[offer].name .. " (see your journal, J).", C_YELLOW)
		sound_at(MOB_WORLD[c.mob], MOB_X[c.mob], MOB_Y[c.mob], "chime")
		return
	end
	for q = 0, QUEST_N - 1 do
		if QUESTS[q].giver == role and quest_active(slot, q) then
			say_to(slot, ROLES[role].name .. ": \"How goes " .. QUESTS[q].name .. "? " .. quest_progress(slot, q) .. "/" .. quest_goal(q) .. ".\"", C_WHITE)
			return
		end
	end
	local lines, nl = split(ROLES[role].lines, ";")
	say_to(slot, ROLES[role].name .. ": \"" .. lines[rnd(nl)] .. "\"", C_WHITE)
end

-- journal lines for the HUD: active quests first, then finished ones
function journal_lines(slot)
	quest_ensure(slot)
	local out = {}
	local n = 0
	local c = CHARS[slot]
	for q = 0, QUEST_N - 1 do
		if c.quest_stage[q] == 1 then
			local mark = quest_ready(slot, q) and "[DONE] " or ""
			out[n] = mark .. QUESTS[q].name .. " " .. quest_progress(slot, q) .. "/" .. quest_goal(q) .. " - " .. ROLES[QUESTS[q].giver].name
			n = n + 1
		end
	end
	for q = 0, QUEST_N - 1 do
		if c.quest_stage[q] == 99 then
			out[n] = "(done) " .. QUESTS[q].name
			n = n + 1
		end
	end
	return out, n
end

return { quest_ensure = quest_ensure, quest_active = quest_active, relics_held = relics_held,
	quest_progress = quest_progress, quest_goal = quest_goal, quest_ready = quest_ready, quest_bump = quest_bump,
	quest_offer = quest_offer }
end)()
	quest_ensure = exports.quest_ensure
	quest_active = exports.quest_active
	relics_held = exports.relics_held
	quest_progress = exports.quest_progress
	quest_goal = exports.quest_goal
	quest_ready = exports.quest_ready
	quest_bump = exports.quest_bump
	quest_offer = exports.quest_offer
end
