function dsl_get(parts, n, key, def)
	local k = key .. "="
	local kl = #k
	for i = 1, n - 1 do
		local p = parts[i]
		if string.sub(p, 1, kl) == k then return string.sub(p, kl + 1) end
	end
	return def
end

function dsl_int(parts, n, key, def)
	local v = dsl_get(parts, n, key, "")
	if v == "" then return def end
	return to_int(v, def)
end

