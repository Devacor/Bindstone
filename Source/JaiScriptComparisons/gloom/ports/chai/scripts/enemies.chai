// Enemies. The reference implements each brain as a coroutine METHOD whose
// handle lives in a field: one yield = one tick, timers are loop counters in
// the coroutine frame, and pain interrupts by discarding the handle. ChaiScript
// has no coroutines, so each brain is hand-lowered to an explicit state
// machine: bphase is the resume point, bt counts remaining wait ticks, the
// coroutine's locals (zig/orbit/burst/volley/enraged/summoned) become fields
// reset when the brain is (re)minted, and "brain == null" becomes bphase = -1.
//
// Lowering discipline (this is what keeps the RNG stream identical):
//   - "enter an N-yield wait" = set bt = N-1 and return (the entry tick is
//     the first yield); each wait tick decrements; the continuation runs on
//     the first tick bt hits 0.
//   - coroutine code that runs between yields (a `continue` back to the loop
//     head, chained same-tick transitions) = fall through phases inside one
//     tick via the while(true) dispatch loop.
//
// state ints: 0 dormant, 1 hunt, 2 attack, 3 dying, 4 dead (art states)

global ENEMY_STATE_DORMANT = 0
global ENEMY_STATE_HUNT = 1
global ENEMY_STATE_ATTACK = 2
global ENEMY_STATE_DYING = 3
global ENEMY_STATE_DEAD = 4

class Enemy {
	var kind
	var x
	var y
	var hp
	var alive
	var state
	var anim        // ticks in current state (drives art frames)
	var walk        // walk cycle counter (advances only when moving)
	var flash       // damage flash ticks (renderer whitens the LUT)
	var stun        // pain stun ticks (brain is dropped + re-minted)
	var radius
	var speed
	// the lowered "coroutine frame"
	var bphase      // -1 = no brain (re-mint next tick)
	var bt          // wait ticks remaining in the current phase
	var zig         // grunt: zigzag side
	var orbit       // spitter: strafe direction
	var burst       // turret: shots fired this burst
	var volley      // warden: volleys fired
	var volleys     // warden: volleys this attack
	var enraged     // warden coroutine local
	var summoned    // warden coroutine local

	def Enemy(kind_, x_, y_) {
		this.kind = kind_;
		this.x = x_;
		this.y = y_;
		this.hp = ENEMY_DEFS[kind_]["hp"];
		this.alive = true;
		this.state = ENEMY_STATE_DORMANT;
		this.anim = 0;
		this.walk = 0;
		this.flash = 0;
		this.stun = 0;
		this.radius = ENEMY_DEFS[kind_]["radius"];
		this.speed = ENEMY_DEFS[kind_]["speed"];
		this.bphase = -1;
		this.bt = 0;
		this.zig = 1;
		this.orbit = 1;
		this.burst = 0;
		this.volley = 0;
		this.volleys = 1;
		this.enraged = false;
		this.summoned = false;
	}

	// one sim tick: corpse cools, stun blocks, otherwise the brain runs
	def tick() {
		this.anim += 1;
		if (this.flash > 0) { this.flash -= 1; }
		if (!this.alive) { return; }
		if (this.stun > 0) {
			this.stun -= 1;
			return;
		}
		if (this.bphase < 0) {
			// mint: the coroutine locals initialize fresh
			this.bphase = 0;
			this.bt = 0;
			this.enraged = false;
			this.summoned = false;
		}
		if (this.kind == 0) { this.brain_grunt(); }
		else if (this.kind == 1) { this.brain_spitter(); }
		else if (this.kind == 2) { this.brain_turret(); }
		else { this.brain_warden(); }
	}

	def player_dist() { return sqrt(dist2(this.x, this.y, G.px, G.py)); }

	def sees_player() {
		if (this.player_dist() > 13.0) { return false; }
		return los_clear(this.x, this.y, G.px, G.py);
	}

	def hears_player() {
		return G.noise > 0 && this.player_dist() < 12.0;
	}

	// slide movement against the tile grid (axes resolved separately)
	def move_toward(tx, ty) {
		var dx = tx - this.x;
		var dy = ty - this.y;
		var len = sqrt(dx * dx + dy * dy);
		if (len < 0.0001) { return; }
		var step = this.speed * TICK;
		var nx = this.x + dx / len * step;
		var ny = this.y + dy / len * step;
		if (spot_free(nx, this.y, this.radius)) { this.x = nx; this.walk += 1; }
		if (spot_free(this.x, ny, this.radius)) { this.y = ny; this.walk += 1; }
	}

	def hurt(dmg) {
		if (!this.alive) { return; }
		this.hp -= dmg;
		this.flash = 4;
		fx_blood(this.x, this.y, 0.5, imin(6, 2 + dmg / 6));
		if (this.hp <= 0) {
			this.die();
			return;
		}
		// pain: drop the brain mid-phase; it re-mints next tick = re-telegraph
		if (RNG.chance(ENEMY_DEFS[this.kind]["pain"])) {
			this.stun = 5 + RNG.next(5);
			this.bphase = -1;
			this.state = ENEMY_STATE_HUNT;
			this.anim = 0;
		}
	}

	def die() {
		this.alive = false;
		this.state = ENEMY_STATE_DYING;
		this.anim = 0;
		this.bphase = -1;
		G.kills += 1;
		fx_gibs(this.x, this.y, this.kind == 3 ? 14 : 7);
		if (this.kind == 3) {
			fx_explosion(this.x, this.y);
			G.warden_down = true;
		}
		var nm = ENEMY_DEFS[this.kind]["name"];
		show_msg("${nm} destroyed", "92");
	}

	// --------------------------------------------------------- brains -------
	// GRUNT: doze -> roar -> relentless zigzag chase -> lunge bite
	// phases: 0 dormant, 1 roar wait, 2 chase, 3 lunge windup, 4 recover
	def brain_grunt() {
		while (true) {
			if (this.bphase == 0) {
				// re-minted after pain (state != dormant) skips the doze check,
				// exactly like the coroutine's while(state == DORMANT) head
				if (this.state != ENEMY_STATE_DORMANT || (this.sees_player() && this.player_dist() < 11.0) || this.hears_player()) {
					this.state = ENEMY_STATE_HUNT;
					this.anim = 0;
					this.bphase = 1;
					this.bt = 6;             // the roar: 7 yields including this one
				}
				return;
			}
			if (this.bphase == 1) {
				if (this.bt > 0) { this.bt -= 1; return; }
				this.zig = RNG.next(2) == 0 ? 1 : -1;
				this.bphase = 2;
				continue;                    // first chase step runs this tick
			}
			if (this.bphase == 2) {
				var d = this.player_dist();
				if (d < 1.3) {
					this.state = ENEMY_STATE_ATTACK;
					this.anim = 0;
					this.bphase = 3;
					this.bt = 5;             // lunge windup: 6 yields including this one
					return;
				}
				// zigzag pursuit: aim past the player's flank, swapping sides
				if (this.anim % 20 == 19) { this.zig = 0 - this.zig; }
				var fx = G.py - this.y;
				var fy = this.x - G.px;
				var fl = sqrt(fx * fx + fy * fy);
				if (fl < 0.001) { fl = 1.0; }
				var lean = d > 3.0 ? 0.9 : 0.2;
				this.move_toward(G.px + fx / fl * lean * this.zig, G.py + fy / fl * lean * this.zig);
				return;
			}
			if (this.bphase == 3) {
				if (this.bt > 0) { this.bt -= 1; return; }
				if (this.player_dist() < 1.6 && los_clear(this.x, this.y, G.px, G.py)) {
					damage_player(RNG.roll(ENEMY_DEFS[0]["melee_lo"], ENEMY_DEFS[0]["melee_hi"]), "a grunt's claws");
				}
				this.state = ENEMY_STATE_HUNT;
				this.anim = 0;
				this.bphase = 4;
				this.bt = 4;                 // recover: 5 yields including this one
				return;
			}
			// bphase == 4: recover
			if (this.bt > 0) { this.bt -= 1; return; }
			this.bphase = 2;                 // loop head re-runs this tick
		}
	}

	// SPITTER: keeps its range band, strafes, telegraphs, spits
	// phases: 0 dormant, 1 loop head, 2 telegraph, 3 orbit cooldown
	def brain_spitter() {
		while (true) {
			if (this.bphase == 0) {
				if (this.state != ENEMY_STATE_DORMANT || (this.sees_player() && this.player_dist() < 12.0) || this.hears_player()) {
					this.state = ENEMY_STATE_HUNT;
					this.anim = 0;
					this.orbit = RNG.next(2) == 0 ? 1 : -1;
					this.bphase = 1;
					continue;                // loop head runs this tick
				}
				return;
			}
			if (this.bphase == 1) {
				var d = this.player_dist();
				var los = los_clear(this.x, this.y, G.px, G.py);
				if (los && d < 9.5 && d > 2.0) {
					// telegraph glow, then the gob
					this.state = ENEMY_STATE_ATTACK;
					this.anim = 0;
					this.bphase = 2;
					this.bt = 8;             // telegraph: 9 yields including this one
					return;
				}
				if (d <= 2.0) {
					// too close: shove and retreat
					if (d < 1.2 && RNG.chance(30)) {
						damage_player(RNG.roll(ENEMY_DEFS[1]["melee_lo"], ENEMY_DEFS[1]["melee_hi"]), "a spitter's talons");
					}
					this.move_toward(this.x + (this.x - G.px), this.y + (this.y - G.py));
				} else {
					this.move_toward(G.px, G.py);
				}
				return;
			}
			if (this.bphase == 2) {
				if (this.bt > 0) { this.bt -= 1; return; }
				if (los_clear(this.x, this.y, G.px, G.py)) {
					spawn_shot(1, this.x, this.y, G.px, G.py, 6.5);
				}
				this.state = ENEMY_STATE_HUNT;
				this.anim = 0;
				this.bphase = 3;
				this.bt = 16;                // cooldown spent orbiting: 16 move ticks
				continue;                    // first orbit step runs this tick
			}
			// bphase == 3: orbit sideways, then maybe flip direction
			if (this.bt > 0) {
				var ox = G.py - this.y;
				var oy = this.x - G.px;
				var ol = sqrt(ox * ox + oy * oy);
				if (ol < 0.001) { ol = 1.0; }
				this.move_toward(this.x + ox / ol * this.orbit, this.y + oy / ol * this.orbit);
				this.bt -= 1;
				return;
			}
			if (RNG.chance(40)) { this.orbit = 0 - this.orbit; }
			this.bphase = 1;                 // loop head re-runs this tick
		}
	}

	// TURRET: dormant metal until it has line of sight; then 3-round bursts.
	// Breaking LOS resets it to a wary idle (the reference coroutine loops
	// forever; this machine does the same by cycling through phase 0).
	// phases: 0 dormant, 1 wake, 2 between-shots gap, 3 burst cooldown, 4 check
	def brain_turret() {
		while (true) {
			if (this.bphase == 0) {
				if (this.sees_player() && this.player_dist() < 11.0) {
					this.state = ENEMY_STATE_HUNT;     // waking whir
					this.anim = 0;
					this.bphase = 1;
					this.bt = 7;             // wake: 8 yields including this one
					return;
				}
				this.state = ENEMY_STATE_DORMANT;
				return;
			}
			if (this.bphase == 1) {
				if (this.bt > 0) { this.bt -= 1; return; }
				this.bphase = 4;
				continue;
			}
			if (this.bphase == 2) {
				if (this.bt > 0) { this.bt -= 1; return; }
				this.burst += 1;
				if (this.burst < 3) {
					turret_shot(this.x, this.y);
					this.bt = 1;             // two yields between shots
					return;
				}
				this.state = ENEMY_STATE_HUNT;
				this.anim = 0;
				this.bphase = 3;
				this.bt = 12;                // burst cooldown: 13 yields including this one
				return;
			}
			if (this.bphase == 3) {
				if (this.bt > 0) { this.bt -= 1; return; }
				this.bphase = 4;
				continue;
			}
			// bphase == 4: the attack-loop condition (sees && d < 12)
			if (this.sees_player() && this.player_dist() < 12.0) {
				this.state = ENEMY_STATE_ATTACK;
				this.anim = 0;
				this.burst = 0;
				turret_shot(this.x, this.y);
				this.bphase = 2;
				this.bt = 1;                 // two yields between shots
				return;
			}
			this.bphase = 0;                 // LOS broken: dormant check this tick
		}
	}

	// WARDEN: the landlord. Stalks and lobs hollow fire; under half health he
	// goes double-volley and calls the family, exactly once per brain — pain
	// re-mints the brain, which re-runs the enrage/summon checks, exactly like
	// the reference coroutine's locals.
	// phases: 0 dormant, 1 seen pause, 2 loop head, 3 volley telegraph,
	//         4 between-volleys gap, 5 walk-at-player, 6 melee windup, 7 melee recover
	def brain_warden() {
		while (true) {
			if (this.bphase == 0) {
				if (this.state != ENEMY_STATE_DORMANT || (this.sees_player() && this.player_dist() < 13.0) || this.hears_player()) {
					this.state = ENEMY_STATE_HUNT;
					this.anim = 0;
					show_msg("THE WARDEN HAS SEEN YOU", "91");
					this.bphase = 1;
					this.bt = 9;             // 10 yields including this one
				}
				return;
			}
			if (this.bphase == 1) {
				if (this.bt > 0) { this.bt -= 1; return; }
				this.bphase = 2;
				continue;
			}
			if (this.bphase == 2) {
				if (!this.enraged && this.hp * 2 < ENEMY_DEFS[3]["hp"]) {
					this.enraged = true;
					this.speed = this.speed * 1.5;
					show_msg("The Warden's wounds glow like coals", "91");
				}
				if (this.enraged && !this.summoned) {
					this.summoned = true;
					summon_adds(this.x, this.y);
					show_msg("The Warden howls for his pack", "91");
				}
				var d = this.player_dist();
				var los = los_clear(this.x, this.y, G.px, G.py);
				if (los && d > 2.4) {
					this.state = ENEMY_STATE_ATTACK;
					this.anim = 0;
					this.bphase = 3;
					this.bt = 7;             // telegraph: 8 yields including this one
					return;
				}
				if (d < 1.7) {
					this.state = ENEMY_STATE_ATTACK;
					this.anim = 0;
					this.bphase = 6;
					this.bt = 4;             // windup: 5 yields including this one
					return;
				}
				this.move_toward(G.px, G.py);
				return;
			}
			if (this.bphase == 3) {
				if (this.bt > 0) { this.bt -= 1; return; }
				this.volleys = this.enraged ? 2 : 1;
				this.volley = 0;
				if (los_clear(this.x, this.y, G.px, G.py)) {
					spawn_shot(2, this.x, this.y, G.px, G.py, 5.5);
				}
				this.bphase = 4;
				this.bt = 3;                 // 4 yields between volleys, this is the first
				return;
			}
			if (this.bphase == 4) {
				if (this.bt > 0) { this.bt -= 1; return; }
				this.volley += 1;
				if (this.volley < this.volleys) {
					if (los_clear(this.x, this.y, G.px, G.py)) {
						spawn_shot(2, this.x, this.y, G.px, G.py, 5.5);
					}
					this.bt = 3;
					return;
				}
				this.state = ENEMY_STATE_HUNT;
				this.anim = 0;
				this.bphase = 5;
				this.bt = this.enraged ? 6 : 12;   // walk ticks (first runs this tick)
				continue;
			}
			if (this.bphase == 5) {
				if (this.bt > 0) {
					this.move_toward(G.px, G.py);
					this.bt -= 1;
					return;
				}
				this.bphase = 2;             // loop head re-runs this tick
				continue;
			}
			if (this.bphase == 6) {
				if (this.bt > 0) { this.bt -= 1; return; }
				if (this.player_dist() < 2.0) {
					damage_player(RNG.roll(ENEMY_DEFS[3]["melee_lo"], ENEMY_DEFS[3]["melee_hi"]), "the Warden's fist");
				}
				this.state = ENEMY_STATE_HUNT;
				this.anim = 0;
				this.bphase = 7;
				this.bt = 3;                 // recover: 4 yields including this one
				return;
			}
			// bphase == 7: melee recover
			if (this.bt > 0) { this.bt -= 1; return; }
			this.bphase = 2;                 // loop head re-runs this tick
		}
	}
}

def spawn_enemy(kind, tx, ty) {
	G.enemies.push_back(Enemy(kind, tx + 0.5, ty + 0.5));
	G.kill_total += 1;
}

// warden's reinforcements: grunts at the nearest free tiles around him.
// They count toward the map total (an honest 100% asks for the whole family).
def summon_adds(wx, wy) {
	var offs = [[2, 0], [-2, 0], [0, 2], [0, -2]];
	var placed = 0;
	for (o : offs) {
		if (placed >= 2) { break; }
		var tx = ifloor(wx) + o[0];
		var ty = ifloor(wy) + o[1];
		if (!walkable(tx, ty)) { continue; }
		spawn_enemy(0, tx, ty);
		fx_explosion(tx + 0.5, ty + 0.5);
		placed += 1;
	}
}

// which art a body renders as, given its state machinery
def enemy_art(e) {
	var base = ["grunt", "spit", "tur", "war"];
	var name = base[e.kind];
	if (e.kind == 2) {
		// turret has its own frame set
		if (e.alive) {
			if (e.state == ENEMY_STATE_ATTACK) { return "tur_fire"; }
			return "tur_idle";
		}
		if (e.anim < 6) { return "tur_d0"; }
		if (e.anim < 12) { return "tur_d1"; }
		return "tur_dead";
	}
	if (e.alive) {
		if (e.state == ENEMY_STATE_ATTACK) { return name + "_at"; }
		return (e.walk / 6) % 2 == 0 ? name + "_w0" : name + "_w1";
	}
	if (e.anim < 6) { return name + "_d0"; }
	if (e.anim < 12) { return name + "_d1"; }
	return name + "_dead";
}
